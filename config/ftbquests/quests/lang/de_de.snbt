	quest.1978E82D0E882F14.quest_desc: [
		"Baue alle acht LUV-Funktionsfamilien und prüfe, dass jedes Rezept die passende IV-Komponente verbraucht; dies bereitet das Neutronen- und Starlight-Werk vor."
	]
	quest.1978E82D0E882F14.quest_subtitle: "Alle acht echten Ludicrous Voltage-Funktionsfamilien bilden einen genauen Standard."
	quest.1978E82D0E882F14.title: "LUV Component Standard"
	quest.43101E11DE8DF64D.quest_desc: [
		"Stelle den aufgeführten LUV-Vorrat für das Neutronen- und Starlight-Werk bereit; halte die Charge aus automatischem Verbrauch heraus, damit Ausbau den Reparaturbestand nicht leert."
	]
	quest.43101E11DE8DF64D.quest_subtitle: "Eine Reservecharge macht einen Standard zu zuverlässig Fabrik Kapazität."
	quest.43101E11DE8DF64D.title: "LUV-Produktionszelle"
	quest.21E91F3D5C319BCE.quest_desc: [
		"Bauen Sie einen Neutronenkollektor auf seiner vierzehnbetriebigen Extremindustrielinie aus Kern-, Luft- und Raumfahrt-, Sternenlicht-, Gitter-, Magnetstabilisierungs- und Live-LUV-Komponentensystemen."
		"Sein Feldgenerator qualifiziert einen Zeitalter 14 extrem-industrielle Maschine ohne UU Matter rückwärts von Quantum zu ziehen."
	]
	quest.21E91F3D5C319BCE.quest_subtitle: "Der LUV-Standard verdient seinen Platz in einem echten Neutronenproduktionssystem."
	quest.21E91F3D5C319BCE.title: "LUV Verbrauchernachweis"
	quest.6D848EF0D74DE7F6.quest_desc: [
		"Bewahre Ersatzmotoren, -pumpen, -robotarme, -sensoren, -emitter und -feldgeneratoren der Stufe LUV für das Neutronen- und Starlight-Werk auf und prüfe danach, dass die IV-Linie weiterläuft."
	]
	quest.6D848EF0D74DE7F6.quest_subtitle: "Die Linie kann verbrauchte Teile nach einem Ausfall ersetzen, ohne den einzigen Verbraucher zu demontieren."
	quest.6D848EF0D74DE7F6.title: "LAU Wiederherstellung Nachweis"
	quest.1DB922872A2A8777.quest_desc: [
		"Baue alle acht ZPM-Funktionsfamilien und prüfe, dass jedes Rezept die passende LUV-Komponente verbraucht; dies bereitet Supraleiter, Fusion und Quantenmaschinen vor."
	]
	quest.1DB922872A2A8777.quest_subtitle: "Alle acht echten Zero Point-Funktionsfamilien bilden einen exakten Standard."
