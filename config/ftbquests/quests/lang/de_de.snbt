	quest.118FB021E97CD161.quest_subtitle: "Eine Reservecharge macht einen Standard zu zuverlässig Fabrik Kapazität."
	quest.118FB021E97CD161.title: "LV-Produktionszelle"
	quest.0506EC6258285666.quest_desc: [
		"Erstellen Sie den verfassten Low Voltage-Konsumenten und dokumentieren Sie, welche Komponentenfamilien er verbraucht."
	]
	quest.0506EC6258285666.quest_subtitle: "Der LV-Standard verdient seinen Platz durch den Betrieb eines echten integrierten Systems."
	quest.0506EC6258285666.title: "LV Verbrauchernachweis"
