	quest.433256F1CB8907BC.quest_subtitle: "Die Linie kann verbrauchte Teile nach einem Ausfall ersetzen, ohne den einzigen Verbraucher zu demontieren."
	quest.433256F1CB8907BC.title: "MV Wiederherstellung Nachweis"
	quest.203AD838B55F2DBE.quest_desc: [
		"Baue alle acht HV-Funktionsfamilien und prüfe, dass jedes Rezept die passende MV-Komponente verbraucht; dies bereitet die Edelstahl- und Digitalfabrik vor."
	]
	quest.203AD838B55F2DBE.quest_subtitle: "Alle acht echten Hochspannungsfunktionsfamilien bilden einen exakten Standard."
	quest.203AD838B55F2DBE.title: "HV-Komponentenstandard"
	quest.3E3266AF76DD3ED6.quest_desc: [
		"Stelle den aufgeführten HV-Vorrat für die Edelstahl- und Digitalfabrik bereit; halte die Charge aus automatischem Verbrauch heraus, damit Ausbau den Reparaturbestand nicht leert."
	]
	quest.3E3266AF76DD3ED6.quest_subtitle: "Eine Reservecharge macht einen Standard zu zuverlässig Fabrik Kapazität."
	quest.3E3266AF76DD3ED6.title: "HV-Produktionszelle"
	quest.783D1AE7F056B8EE.quest_desc: [
		"Erstellen Sie den verfassten Hochspannungsverbraucher und dokumentieren Sie, welche Komponentenfamilien er verbraucht."
	]
	quest.783D1AE7F056B8EE.quest_subtitle: "Der HV-Standard verdient seinen Platz durch den Betrieb eines echten integrierten Systems."
	quest.783D1AE7F056B8EE.title: "HV Verbrauchernachweis"
	quest.28FE788DFAA32EF0.quest_desc: [
		"Bewahre Ersatzmotoren, -pumpen, -robotarme, -sensoren, -emitter und -feldgeneratoren der Stufe HV für die Edelstahl- und Digitalfabrik auf und prüfe danach, dass die MV-Linie weiterläuft."
	]
	quest.28FE788DFAA32EF0.quest_subtitle: "Die Linie kann verbrauchte Teile nach einem Ausfall ersetzen, ohne den einzigen Verbraucher zu demontieren."
	quest.28FE788DFAA32EF0.title: "HV Wiederherstellung Nachweis"
