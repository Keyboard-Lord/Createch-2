	quest.2C12DE4579FD8529.quest_subtitle: "MK1在量子0后进入竞选 EMC 证明。"
	quest.2C12DE4579FD8529.title: "唯一被动的收藏家"
	quest.1DB8AD4EA3D6812D.quest_desc: ["在普通生产流程上测试时光怀表或时间魔杖。两者均排除暗物质基座以及受保护的 Oritech 加速器、反应堆和深钻控制器。提高加速强度前，先测试其他反应堆、空间系统和含大量库存的机器。"]
	quest.1DB8AD4EA3D6812D.quest_subtitle: "可移植 ProjectE 时间控制跟随 OpV 和 Infinity 并共享时间黑名单。"
	quest.1DB8AD4EA3D6812D.title: "Infinity 时间观察"
	quest.21D3F7925C1B3312.quest_desc: [
		"重复存款、提取、制作、冶炼、压缩和回收检查,从清结余额中提取;保留审计库存。"
	]
	quest.21D3F7925C1B3312.quest_subtitle: "经济生存下来 重新启动 无正数 EMC 循环。"
	quest.21D3F7925C1B3312.title: "税和循环 恢复 审计"
	quest.2A0EA7058CB094C9.quest_desc: [
		"使用有线调制解调器或红石整流器运行creatch2/watchdog,触发一个警报,关闭,并手动恢复."
	]
	quest.2A0EA7058CB094C9.quest_subtitle: "一台计算机观测到真实信号并进行有界关闭。"
	quest.2A0EA7058CB094C9.title: "计算机和监视器厂"
	quest.7D6A954794030611.quest_desc: [
		"跑前飞行,布雷 定界任务, 返回物理,卸载,加油, 并从障碍物中恢复。"
	]
	quest.7D6A954794030611.quest_subtitle: "可编程田矿工的产量仍然比大宗采石场小。"
	quest.7D6A954794030611.title: "开采龟场方案"
	quest.71DDBBF3B76EF96E.quest_desc: [
