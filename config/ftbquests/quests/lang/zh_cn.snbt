	quest.6182F31656AEB322.quest_desc: [
		"完成 TFC 与热金属和电流在铁道上接合。"
		"先开始通量,然后两个工作台都到达焊接处,然后两个都降到工作温度以下。"
	]
	quest.6182F31656AEB322.quest_subtitle: "隔音焊接就是 分开的铸造变成 工业联合体跳跃尺度材料."
	quest.6182F31656AEB322.title: "证明铜焊"
	quest.61B7F588D897BF10.quest_desc: [
		"储存两个高级项目输入舱,两个高级项目输出舱,以及大型电磁器运行后的四个服务器。"
		"保留在活动细胞外,以便一个失败的舱门能够 隔离 d 并替换,而不食用唯一缩放的线条。"
	]
	quest.61B7F588D897BF10.quest_subtitle: "四个阶段的舱门 允许一个大处理室 修复编辑或扩充,而不食用唯一的工作路线。"
	quest.61B7F588D897BF10.title: "阶段矩阵输入和输出"
	quest.61E5A29E21AE2F0A.quest_desc: [
		"生产 16 AE2 逻辑处理器."
		"运行硅,逻辑打印,以及从补充输入中运行红石组装."
	]
	quest.61E5A29E21AE2F0A.quest_subtitle: "十六个逻辑处理器足以实现真正的网络建设,并暴露了书记者是否能够维持组件需求."
	quest.61E5A29E21AE2F0A.title: "逻辑处理器批次"
	quest.61E5F9125B8ACB81.quest_desc: [
		"16枚铜环和16枚铜螺栓一起"
		"将垃圾箱放在水泵和管道交叉口旁,"
	]
	quest.61E5F9125B8ACB81.quest_subtitle: "十六个戒指和螺栓都放上了蒸汽 修复在一个清单范围内。"
	quest.61E5F9125B8ACB81.title: "封条和快板宾"
	quest.62180C64B706A3B7.quest_desc: [
		"建设第二盆和机械压机,进行平行工作."
		"只有在确认综合应力需求低于容量后,才能从同一个电网中喂食."
	]
	quest.62180C64B706A3B7.quest_subtitle: "一家重复的记者站将普通的形成与铸币局的瓶颈区分开来."
	quest.62180C64B706A3B7.title: "复制按键线"
	quest.62195E9FD974083C.quest_desc: [
		"股票八 MI 铝板和8个 电力电网 线接线器."
		"将匹配的批次保留在计划分支旁边,同时为现有的LV和MV保留单独的库存 修复 s."
	]
	quest.62195E9FD974083C.quest_subtitle: "8个铝板和8个连接器组成了1个可使用的MV分支的紧凑储备."
	quest.62195E9FD974083C.title: "铝板储备"
	quest.62213B4CE40ABCD5.quest_desc: [
		"汇合土生土长的塔罗牌, ProjectE Psi和奥古斯丁主义在高成本的Malum实验中取得了进步."
		"帕拉卡乌斯火焰既代表分支掌握力,也代表量子时代的研究."
	]
	quest.62213B4CE40ABCD5.quest_subtitle: "只有在独立学科与高级精神研究相遇时,才有心智和物质的产物."
	quest.62213B4CE40ABCD5.title: "时代 15——完美思维与物质."
	quest.626EE136BB994131.quest_desc: [
		"构建 Parcool 的拉链绳."
		"选择固态锚,清空两条路口,如果线路无法使用,则保留一条步行路线."
	]
	quest.626EE136BB994131.quest_subtitle: "一条拉链路线交易陡峭的攀登 以换取一条必须信任 锚和着陆的线路"
	quest.626EE136BB994131.title: "绳索路过刀疤"
	quest.629913687BB9B536.quest_desc: [
		"通过安装的食谱准备32个TFMG火花球."
		"干燥后再储存起来 然后再组装消耗它们的结构"
	]
	quest.629913687BB9B536.quest_subtitle: "32个干火炉是下一份耐力工作精心设计的一批工作。"
	quest.629913687BB9B536.title: "擦干一个消防车工作批次"
	quest.629FCA4E4944846C.quest_desc: [
		"利用该物质已经确定的物质,将8个低腐蚀尘土作为有限度的再生实验。 工厂."
		"记录牺牲输入和回收值。 此预览教义 修复 和物质不匹配; 它不授权被动 EMC 生成或机器转换。"
	]
	quest.629FCA4E4944846C.quest_subtitle: "共性开始于负责的开垦,而不是自由物."
	quest.629FCA4E4944846C.title: "共性再生实验"
	quest.62D0478F27C15E4D.quest_desc: [
		"收获并持有8个农民的\"美味小白菜\"."
		"留下种子和 工厂设施在烹饪批次之前,下季的容量为:"
	]
	quest.62D0478F27C15E4D.quest_subtitle: "八菜菜证明花园可以提供一条餐线,而不是一个示范作物."
	quest.62D0478F27C15E4D.title: "收获一盒卷菜"
	quest.62EF95F0665FE5FC.quest_desc: [
		"建设8条货物船浮标."
		"导航需要和确认的空间在恶劣条件下仍然可见链条。"
	]
	quest.62EF95F0665FE5FC.quest_subtitle: "8个浮标可以标出一条从开阔的水经危险到卸货面的航道."
	quest.62EF95F0665FE5FC.title: "Buoy 链储备"
	quest.62F8AD59DE2C5D34.quest_desc: [
		"构建一个 MI 柴油发电机和库存 电力电网 电线"
		"连接受保护的工作负荷,并在启动、稳定运行和关闭期间观察系统。"
	]
	quest.62F8AD59DE2C5D34.quest_subtitle: "一台LV型柴油发电机和16条电线显示燃料,生成,分配,并装入一个电路."
	quest.62F8AD59DE2C5D34.title: "跑起柴油通过场"
	quest.63625CA3D276D45B.quest_desc: [
		"5 000万示威活动 FE 连接的存储。"
		"将隔离和关闭控制放置在失败之处 反应堆 电路不能同时移除能保证其安全的后备设备."
	]
	quest.63625CA3D276D45B.quest_subtitle: "聚变安全计划开始于足够的储存能量,在无法生成时控制."
	quest.63625CA3D276D45B.title: "储备封存功率"
	quest.6372E877D111F349.quest_desc: [
		"建设丰盛气候站,储有32块木炭."
		"利用读数安排田间,保存食物,并维持一个温暖的恢复住所."
	]
	quest.6372E877D111F349.quest_subtitle: "气候记录和可替换燃料使得和解的天气以准备而不是运气来回答。"
	quest.6372E877D111F349.title: "季节性家园委员会"
	quest.63847E2A36130A85.quest_desc: [
		"检查核裂变控制器,并建造4个水热汇."
		"使用经验证的几何、表热和 辐射,保留关闭的通道,并在任何限制接近之前停止。"
	]
	quest.63847E2A36130A85.quest_subtitle: "An inspected controller and a four-sink cooling batch turn continuous operation into something that can be checked and repeated."
	quest.63847E2A36130A85.title: "观察持续任务运行"
	quest.63D75FA324FEE136.quest_desc: [
		"运行播种纳夸达阿森布勒批次,然后规模化水晶基地和控制水晶."
		"成熟的纳夸达线保持了超导,Thioquartz,Soul Dew,氦等离子体,酸,以及保留精制种子;它的优点是产量和自动化,而不是试剂回收."
	]
	quest.63D75FA324FEE136.quest_subtitle: "水晶基地 和控制晶体 证明是可重复的大门组件店"
	quest.63D75FA324FEE136.title: "纳夸达和门水晶"
	quest.63F0807B067C45F3.quest_desc: [
		"生产和转移8 000毫巴 MI 盐酸."
		"保持其罐体和管道与其他酸分离,并在开始生产前提供受控目的地."
	]
	quest.63F0807B067C45F3.quest_subtitle: "一种缓冲盐酸浴准备清洁和合成,而不借用硫化物线."
	quest.63F0807B067C45F3.title: "氯酸盐浴"
	quest.640AAE45E0A63A60.quest_desc: [
		"通过安装的食谱准备32个CBC铸造砂."
		"把它放在铸造区旁边 远离普通的造沙 如此的模具 修复 保持可预见。"
	]
	quest.640AAE45E0A63A60.quest_subtitle: "铸砂只有在模具地板从未用完中pour时才便宜."
	quest.640AAE45E0A63A60.title: "装满铸造纸盒"
	quest.642DCD7C4C3B1A3D.quest_desc: [
		"打败一个永恒的星光探险家"
		"保护附近地区,保留撤退路线,将杀戮视为危险知识,而不是例行狩猎。"
	]
	quest.642DCD7C4C3B1A3D.quest_subtitle: "一个探险家惩罚那些在地平线上被固定的注意力;外星野外工作需要安全,每一个方向都需要安全."
	quest.642DCD7C4C3B1A3D.title: "拯救寻找者安布"
	quest.647DF447D714E4E6.quest_desc: [
		"从现场先进电器部件中建造两座梅卡尼主义基础化学罐."
		"标记预定气体,并至少保持一个罐子的空置,足以接收来自一个气体的原料。 隔离 d 机器。 设备"
	]
	quest.647DF447D714E4E6.quest_subtitle: "两个空化学罐在关闭或换菜时给气体提供了安全转移路径."
	quest.647DF447D714E4E6.title: "库存化学罐"
	quest.6496D9C84603B12F.quest_desc: [
		"建铜 chi子."
		"铸铜凿头,放凉,在试石制成的工程前上架."
	]
	quest.6496D9C84603B12F.quest_subtitle: "铜制的凿子让完成的石头按照规划的基础设施与木材和矿石结合。"
	quest.6496D9C84603B12F.title: "做铜丝"
	quest.64EE64F3756F90D5.quest_desc: [
		"保持一个 MI 真空冷藏器和8个钛气缸作为重建库存."
		"暖和,热 隔离,以及 检查 交换设备前的失败行, 那么 重新启动 带有空输出。"
	]
	quest.64EE64F3756F90D5.quest_subtitle: "备用冷藏机和八根内燃机在动力或密封故障后使冷处理可以恢复."
	quest.64EE64F3756F90D5.title: "真空线重建阶段"
	quest.65009054BCFD0049.quest_desc: [
		"之后 阶段 14号打开,生产出一条经过活生生的种子路线的异种。"
		"保存源样品,从规模化加工中分离探险摄入量."
	]
	quest.65009054BCFD0049.quest_subtitle: "当每批工业产品仍然能追溯到 合法的星光发现时, 乙醚提取就变得复杂了。"
	quest.65009054BCFD0049.title: "维度采掘综合体"
	quest.6500CB38EE19DEA1.quest_desc: [
		"储存两个斯特拉里氧气罐和16个原始的底渣"
		"将生命支持用品与货物加工分开,不将每一份退回的集中剂投入第一台先进电器食谱。"
	]
	quest.6500CB38EE19DEA1.quest_subtitle: "两箱氧气和一批生油 防止下一批货物消耗最后一批货"
	quest.6500CB38EE19DEA1.title: "缓冲氧和月球货"
	quest.650A9FC066A0DFF2.quest_desc: [
		"地点和地点 检查 扩展模块累积器。"
		"测试电荷共享,依次切断每个单元的连接,确认受保护负载仍然可以回收."
	]
	quest.650A9FC066A0DFF2.quest_subtitle: "只有在两个单元中任何一个单元都能产生弹性时,第二个累积器才会增加弹性 隔离 d 而不使控制器变暗。"
	quest.650A9FC066A0DFF2.title: "扩大储存巴士的委员会"
	quest.65160A8144996DE7.quest_desc: [
		"建造一个量子机壳,并展示1亿 FE 连接能力。"
		"先装上非必需的载荷 验证 船体的控制仍保留在受保护的大巴上。"
	]
	quest.65160A8144996DE7.quest_subtitle: "量子层应该能幸存下来 而不失去协调其恢复的机器"
	quest.65160A8144996DE7.title: "现实 布朗诺德钻井"
	quest.6545D3E91186EABA.quest_desc: [
		"完成 TFC 建造并发射一个盖好盖好的窑炉,"
		"不要提前打开场地;在陶器完成时准备另一项任务."
	]
	quest.6545D3E91186EABA.quest_subtitle: "覆盖窑炉 将整个粘土批量 热和耐心。"
	quest.6545D3E91186EABA.title: "坑基尔姆 Rite"
	quest.654E8F3824653BFD.quest_desc: [
		"16号股票量子电路 和4个晶体母体的插座"
		"给星光和电路链充电 然后再释放这些审计过的数量"
	]
	quest.654E8F3824653BFD.quest_subtitle: "16个量子电路和4个矩阵内输入器使最终的表保持了精确和结构的等量供给."
	quest.654E8F3824653BFD.title: "量子电路折射"
	quest.656DE99456CFF645.quest_desc: [
		"生产4个超导体内基加8桶,每桶为uter和t."
		"保持同位素罐的区别和 验证 星光背合金线可以取代维修消耗的内燃机."
	]
	quest.656DE99456CFF645.quest_subtitle: "只有当同位素,超导体,及其取代途径被缓冲在一起时,方能制备聚变原料."
	quest.656DE99456CFF645.title: "原始输入的阶段融合种子"
	quest.657F39DC958873DC.quest_desc: [
		"建造一个斯特拉里斯燃料舱,并生产16000mB的斯特拉里斯燃料."
		"从TFMG炼油厂产出中开始,在之后再补充源流储备."
		"求求报文消耗燃料; 后补充工作缓冲。 它的奖励是一个可重复使用的回收工具,而不是替换组件 。"
	]
	quest.657F39DC958873DC.quest_subtitle: "16 000毫巴的转换推进剂外的一个新燃料舱证明,路线始于既定的石油,而不是奖励桶。"
	quest.657F39DC958873DC.title: "重建燃料储存的燃料系统"
	quest.6596BA0439C1B1C1.quest_desc: [
		"钢后工业联合体 打开, 建造高级项目加载器。"
		"与真正的车站对齐,过滤预定的货物,并提供溢出储存."
	]
	quest.6596BA0439C1B1C1.quest_subtitle: "铁路货运装载机让车站负责调车,而不是司机."
	quest.6596BA0439C1B1C1.title: "货运装载机"
	quest.65B755165CC6BAE9.quest_desc: [
		"16号股票 CC:Tweaked 电缆和三十二台 MI 铜板是第二间受监管的工作室的"
		"复制已验证的提醒和间锁模式,指定一个不同的网络身份,并在扩展消耗储备之前补充两个物质线."
	]
	quest.65B755165CC6BAE9.quest_subtitle: "第二细胞证明监管可以重复,而不会与运输混淆控制."
	quest.65B755165CC6BAE9.title: "第二监督工作室"
	quest.65BEF939B50516BD.quest_desc: [
		"地点和地点 检查 三个准备处完成后 斯特拉里斯火箭发射场"
		"追踪燃料,氧气,货物,垫子的进出, 紧急关闭 从院子的一端到另一端。"
	]
	quest.65BEF939B50516BD.quest_subtitle: "火箭发射场的扩建工作现在依靠的是经过验证的 重新启动,停电, 和储备程序。"
	quest.65BEF939B50516BD.title: "扩大船厂委员会"
	quest.65C742774D5BE2B7.quest_desc: ["储备三十二个统一的 TFC 钢锭和三十二块 MI 钢板。","保持可乐,铁,热空气,铸造,并形成能够取代这种储备的投入."]
	quest.65C742774D5BE2B7.quest_subtitle: "三十二块硬币和板子给钢工业联合体 房间到 修复,扩展,并开始LV准备."
	quest.65C742774D5BE2B7.title: "阶段一全钢储备"
	quest.65C9BF96426F1AE1.quest_desc: [
		"使用星门并触发 SGJourney 的过关推进 。"
		"拨打一个经核实的目的地,携带独立的返回补给,确认远侧大门可以供电."
	]
	quest.65C9BF96426F1AE1.quest_subtitle: "跨越一个制造出来的星门使得返回地址比去除的距离更重要."
	quest.65C9BF96426F1AE1.title: "星门过关"
	quest.65E891D36C209DB6.quest_desc: ["Build and place an Electric Simulation Chamber after the base Hostile Neural Networks route is established.","Provide stable power, prediction-matrix input, and output space before treating the chamber as a production service.","Optional advanced simulation under RSR-01 Resource Simulation. HNI scales the earlier Digital model loop and shares the discipline of contained quarry-bee renewal; first discovery remains physical."]
	quest.65E891D36C209DB6.quest_subtitle: "动力模拟将手动试验的预测工作移到自动化层."
	quest.65E891D36C209DB6.title: "电动敌对模拟"
	quest.65EA4531B2CA6376.quest_desc: [
		"检查裂变 反应堆 弹壳,在 反应堆 运行时的运行速度是故意的低实用率。"
		"站在安全控制点 停止运行 如果有任何缓冲趋势 走向疲惫。"
	]
	quest.65EA4531B2CA6376.quest_subtitle: "负荷检查是指同时观察燃烧率、温度、冷却剂、蒸汽、废物和涡轮机边。"
	quest.65EA4531B2CA6376.title: "检查装入的反应堆"
	quest.66197D8CF37A3640.quest_desc: [
		"构建一个 AE2 建立了空间IO港和一个在计算机化导航和返回深空样本后使用的1283个空间单元组件。"
		"地图封存边界、 断电、 恢复和目的地权威。 这是空间理论, 而不是允许跳过第一次物理到达 。"
	]
	quest.66197D8CF37A3640.quest_subtitle: "空间存储只有在封闭和返回仍然是实际责任时才成为导航理论。"
	quest.66197D8CF37A3640.title: "时代 11——空间导航理论."
	quest.66210706B4540F10.quest_desc: [
		"完成斯特拉里斯火星登陆的推进 通过实际任务"
		"保障着陆区,在追求庙宇或资源目标之前,保留返回物资。"
	]
	quest.66210706B4540F10.quest_subtitle: "火星着陆推进记录了一条航线,这条航线仍然必须加油,补给,并逆向前进."
	quest.66210706B4540F10.title: "火星红路"
	quest.66394C6E15E905BA.quest_desc: [
		"搭建帕库尔铁拉链钩."
		"先在没有货物的情况下测试线路,然后将脆弱的货物置于任何航线上,并进行危险的着陆."
	]
	quest.66394C6E15E905BA.quest_subtitle: "铁钩只有在两端安全上载和离开后,绳子才能跨度变为中转."
	quest.66394C6E15E905BA.title: "铁钩过境"
	quest.666D3FFD0EBE98F6.quest_desc: [
		"机器链路及其继电器被证明后,位置和位置 检查 整个块 AE2 模式提供者。"
		"它的食谱消耗了处理控制和校准继电器, 把它附在一个已知的工作细胞上, 验证 引导和阻断行为,并保持物理路径的可见性。"
	]
	quest.666D3FFD0EBE98F6.quest_subtitle: "模式提供者是承诺提供成分和获得结果,而不是允许忽略机器访问。"
	quest.666D3FFD0EBE98F6.title: "模式 提供方纪律"
	quest.66F218F5467FCB96.quest_desc: [
		"完成Mekanism的超前控制电路推进,"
		"在每条线路都开通之前 准备一批替换设备"
	]
	quest.66F218F5467FCB96.quest_subtitle: "先进电路推进能证明 未来更严格的化学机器的控制部件"
	quest.66F218F5467FCB96.title: "高级电路封条"
	quest.670272AA70F4B077.quest_desc: [
		"完成 MI 真空解冻器在靴子的配方上进步。"
		"运行实际热-ingot冷却循环,并保留冷冻器的替换途径."
	]
	quest.670272AA70F4B077.quest_subtitle: "真空解冻器的推进记录了使热钛无捷径可用而使用的机器."
	quest.670272AA70F4B077.title: "真空冷冻器 Rite"
	quest.6704D1FB271B4BC4.quest_desc: ["Use a Spirit Infusion experiment to discover the native Tarot deck.","Once found, Tarot proceeds through its own readings and mechanics.","This is an optional discipline at this age; the canonical factory proofs govern normal progression."]
	quest.6704D1FB271B4BC4.quest_subtitle: "早期的发现证明精神模式可以揭示出另一个学科."
	quest.6704D1FB271B4BC4.title: "Discover Tarot"
	quest.670878FB96191C10.quest_desc: [
		"之后 阶段 11 打开、建造和 检查 a 数据为: MI 大型柴油发电机多块块."
		"以量的散装燃料供给它, 隔离 d 输出、排气许可、计量和能够黑动控制器的单独来源。"
	]
	quest.670878FB96191C10.quest_subtitle: "加工装置、高级船体和钛制造16 384 EU/t 工厂设施 合法。"
	quest.670878FB96191C10.title: "建造大型柴油厂"
	quest.67111C0686283295.quest_desc: [
		"股票64 创建音轨。"
		"将储备放在院子里,并在使用后补充铁床单和矿床合金。"
	]
	quest.67111C0686283295.quest_subtitle: "堆成的轨道可以架设一个冲出的部分或延长一个旁立部分,而无需任意攀登操作."
	quest.67111C0686283295.title: "阶段 a 轨迹储备"
	quest.6744FD0F568AB412.quest_desc: [
		"地点和地点 检查 铜箱,同时在大厅里保留一个铜锅炉。"
		"分开储存水、热蒸汽、燃料、物品输入和产品输出,因此维护工作从不需要通过管道猜测。"
	]
	quest.6744FD0F568AB412.quest_subtitle: "装有罐子和锅炉,蒸汽厅的输入和危险就显而易见。"
	quest.6744FD0F568AB412.title: "水、蒸汽和奥雷"
	quest.6745F495E7DE3ACC.quest_desc: [
		"在所装实验室区保留一个基本的化学罐和化学吸尘器。"
		"标注其当前内容,提供关闭接入,永远不能将未知的罐体连接到主管网络."
	]
	quest.6745F495E7DE3ACC.quest_subtitle: "隔离箱有用,因为它可能 隔离 d 在任何人需要识别泄漏之前。"
	quest.6745F495E7DE3ACC.title: "化学罐检疫"
	quest.677DBBBFEA49913C.quest_desc: ["Produce four titanium-alloy units to prove rutile chemistry, vacuum cooling, pressure-hull work, bulk power, and aerospace recovery operate as one works.","MAT-05 supplies titanium mechanics. Large electric processing and the Processing Array reward established grid/control service; retain specialist foundry, refinery and separation lines."]
	quest.677DBBBFEA49913C.quest_subtitle: "CANONICAL AGE 11 PROOF — High Pressure Aerospace"
	quest.677DBBBFEA49913C.title: "真空航空航天工程"
	quest.678E9F3F707CE00E.quest_desc: [
		"证明1 000万 FE 中连接的存储。"
		"测试转录到核聚变控制中,并保持一个单独的边距,用于泵,冷却,安全关闭."
	]
	quest.678E9F3F707CE00E.quest_subtitle: "储存了1 000万 FE 是一个可靠的点火库, 还没有保证持续运行。"
	quest.678E9F3F707CE00E.title: "联合点火银行"
	quest.678FCAF3D3C05B41.quest_desc: [
		"创造轨迹信号 十六枚铁制硬币"
		"保留这些物品,用于保护交叉口和紧急轨道 修复 s."
	]
	quest.678FCAF3D3C05B41.quest_subtitle: "有两个信号和16个铁柱 支持线路扩展而不拆除工作线"
	quest.678FCAF3D3C05B41.title: "库存信号和铁道"
	quest.67C59FD4AC12D59A.quest_desc: [
		"检查了一台Mekanism化学洗涤器 并储存了16个钢材大板"
		"核查其气体、浆液、清洁水、产出和维护接口与燃料库的对照 工业区 计划。"
	]
	quest.67C59FD4AC12D59A.quest_subtitle: "16块大板旁边观察到的化学洗涤器将工艺锚与支撑它的结构联系起来。"
	quest.67C59FD4AC12D59A.title: "主计长"
	quest.682B5B91DA4B2490.quest_desc: [
		"地点和地点 检查 a 数据为: MI 电压缩机。"
		"提供正确的电压,输入缓冲,输出清关,以及不混合产品的路由."
	]
	quest.682B5B91DA4B2490.quest_subtitle: "压缩机将粉末和板块需求转化为预定的工作细胞,而不是进行一系列人工访问."
	quest.682B5B91DA4B2490.title: "电压压缩机"
	quest.6855DB5A9ACE4A1B.quest_desc: [
		"地点和地点 检查 墨卡尼主义 反应堆 玻璃作为计划中的壳体的一部分。"
		"只有在结构规则允许且保留在外的替换块时才使用 反应堆 房间"
	]
	quest.6855DB5A9ACE4A1B.quest_subtitle: "反应堆玻璃使压力边界可见,而不产生 辐射 或热无害。"
	quest.6855DB5A9ACE4A1B.title: "检查反应堆边界"
	quest.6861BC3B123CFE8C.quest_desc: [
		"地点和地点 检查 a 数据为: MI 蒸汽区有铜器壳"
		"计划围绕几台青铜机器共享服务,而不是将每台机器包装在 隔离 d 储存。"
	]
	quest.6861BC3B123CFE8C.quest_subtitle: "青铜蒸汽室变成一个 工业区 锅炉水、燃料、蒸汽、凝固液和 修复 进入每个地方都有自己的路线。"
	quest.6861BC3B123CFE8C.title: "铜蒸汽室"
	quest.686364804E127E6C.quest_desc: [
		"寻找水、粘土、木材、食物或矿石指标时,会走500个街区。"
		"带水和足够的食物去路 而不是绕过探索屏幕 来填满统计数据"
	]
	quest.686364804E127E6C.quest_subtitle: "步行进行有用的五百个街区调查,并配有食物,水,以及一条标志性的回程路线."
	quest.686364804E127E6C.title: "第一战地观察"
	quest.68682E651913F10C.quest_desc: [
		"建造8个梅卡尼主义控制-罗德式集会."
		"将它们与计划中的燃料组装布局匹配,并保持逻辑适配器和手动访问."
	]
	quest.68682E651913F10C.quest_subtitle: "八个控制杆的集会,让 反应堆 几何学增长而不减少关闭它的权威."
	quest.68682E651913F10C.title: "扩大反应堆控制局"
	quest.686C0F12B0859788.quest_desc: [
		"检查一个基本化学罐,并保持电解分离器在实验室的准备状态."
		"保留标注的管廊,取水通道,气缓冲,通风选择,以及清空的维护空间."
	]
	quest.686C0F12B0859788.quest_subtitle: "隔离箱和隔离器界定气体的制造、储存、排泄和服务地点。"
	quest.686C0F12B0859788.title: "隔离和隔离"
	quest.687964B67ED5D432.quest_desc: [
		"建立一个“创建盆地”,并放置热量空间、搅拌机或压压机以及路由输出。"
		"在确认每边线路需要进入之前,不要把它埋在装饰区块内。"
	]
	quest.687964B67ED5D432.quest_subtitle: "流域是不同的输入开始像一个控制的过程一样运行的地方。"
	quest.687964B67ED5D432.title: "建设混合盆地"
	quest.68A6CDB0993D2252.quest_desc: [
		"5 000万示威活动 FE 中连接的存储。"
		"执行项目负载 验证 保留地 隔离 d 临时建筑设备。"
	]
	quest.68A6CDB0993D2252.quest_subtitle: "储存5 000万 FE 保持设计控制、后勤,以及 检查重力施工时可得到离子."
	quest.68A6CDB0993D2252.title: "启动第二个工程的移动"
	quest.68A7B225E6CD77CD.quest_desc: [
		"股票四 电力电网 电池和16根隔热铜丝"
		"计划间隔、保护和服务隔离,然后才能连接。"
	]
	quest.68A7B225E6CD77CD.quest_subtitle: "4个电池和16个隔热电线组成一个库,可以不借用活动电网进行组装."
	quest.68A7B225E6CD77CD.title: "电池银行储备"
	quest.68E88A51AECA2FD8.quest_desc: [
		"生成或存储 100 000 FE 正在运行的MV动力系统中。"
		"连接生成, 受保护存储, 设备连接器, 和一个真正的负载, 因此容量代表可用的基础设施。"
	]
	quest.68E88A51AECA2FD8.quest_subtitle: "头十万人 FE 储备让MV地板有足够的存储时间在化学依赖之前测试分布."
	quest.68E88A51AECA2FD8.title: "MV 电池"
	quest.68ED82590BD84DF2.quest_desc: [
		"前往 Stellaris 的两个维度：金星提供 Corronium，水星提供 Solerium。分别带回原料，并确保两条返航路线安全。"
		"高压时代的混合精矿配方同时消耗这两种金属，以启动铂和铱产线。这是必需的供应链，不是信息类支线。"
	]
	quest.68ED82590BD84DF2.quest_subtitle: "来自金星的 Corronium 与来自水星的 Solerium 都是高压冶金的必需原料。"
	quest.68ED82590BD84DF2.title: "建立金星与水星供应线"
	quest.691CC9FE7464B575.quest_desc: [
		"制造 AppMek 化学存储元件，证明 AE2 能协调化学库存与电力、频道、处理器、样板、制造及远程连接。"
	]
	quest.691CC9FE7464B575.quest_subtitle: "Discipline mastery — supporting branch; follow the chapter age proof for the main transition."
	quest.691CC9FE7464B575.title: "数字物流"
	quest.694BFD179A123373.quest_desc: [
		"16个涡轮机叶片和16个 电力电网 重线连接器。"
		"都留着 断电 d 和涡轮机大厅外,直至确认完全维修隔离。"
	]
	quest.694BFD179A123373.quest_subtitle: "16个涡轮机叶片和重型连接器将机械和电气回收放在一个有记录的储备上。"
	quest.694BFD179A123373.title: "涡轮刀锋储备"
	quest.696D34A8AB6D9BAA.quest_desc: ["Commission the bronze macerator as proof that water, fuel, steam, pipes, machines, and repair stock operate as one maintained hall.","MEC-02/MEC-03 machinery extends the earlier kinetic district. The foundry supplies plates and mechanisms to the steam hall; steam processing gives that foundry repeatable prepared feedstock."]
	quest.696D34A8AB6D9BAA.quest_subtitle: "CANONICAL AGE 3 PROOF — Bronze Steam"
	quest.696D34A8AB6D9BAA.title: "铜蒸汽炉"
	quest.6971D4009FA025B2.quest_desc: [
		"制作 4 份 MI 钢大板通过目前的形成路线。"
		"放在锅炉和外壳的零件旁边, 放在一般建筑库存之外。"
	]
	quest.6971D4009FA025B2.quest_subtitle: "四大板盖故障,不能与普通板板股票补齐."
	quest.6971D4009FA025B2.title: "窗体大修版图"
	quest.697284576D20534E.quest_desc: [
		"储存16台Flix玻璃电缆和4台 MI 网络外的数字电路板."
		"标注工具箱 保存工具 电源 以及旁边的控制器路线"
	]
	quest.697284576D20534E.quest_subtitle: "储存的电缆和数字板实际保存第一台 修复 独立 AE2 进入。"
	quest.697284576D20534E.title: "准备网络断电套件"
	quest.69812E5A1A677E70.quest_desc: [
		"地点和地点 检查 a 数据为: MI 聚变室"
		"其活食谱加入超导体圈,核合金板,等离子体外壳,以及大型热交换器."
	]
	quest.69812E5A1A677E70.quest_subtitle: "聚变舱是田间,燃料,以及它外的一切都之间的持久边界."
	quest.69812E5A1A677E70.title: "运行一个融合室"
	quest.69A7245BF499285A.quest_desc: [
		"后工业门打开后,位置和 检查 墨卡尼主义的融合 反应堆 控制器 控制器"
		"将此视为准备: 验证 在规划持续等离子体系统之前,先安装了脱氧核糖核酸和ium。"
	]
	quest.69A7245BF499285A.quest_subtitle: "融合改变 燃料循环,但它并没有消除对封存、仪器或有序关闭的需要。"
	quest.69A7245BF499285A.title: "融合准备"
	quest.69D7976C0B6B5B0D.quest_desc: [
		"第 15 阶段开放后,放置并检查一个 MI 量子机器外壳。"
		"规划物质供给、高阶电力、洁净组件,并与普通工厂物流隔离。"
	]
	quest.69D7976C0B6B5B0D.quest_subtitle: "当量子机、奇数、门和样本封存共享问责界面时,现实工程就成为一个复杂问题。"
	quest.69D7976C0B6B5B0D.title: "现实工程综合体"
	quest.6A0D13F0A6E8B4C2.quest_desc: [
		"荒地是核的奥戴尔:后果、抢救和再生,而不是富饶的替代 Overworld。"
		"它的通用矿石表已消失。 输入时 辐射 保护并只归还稀疏的贫瘠的铀酸盐或 k酸盐回收样品。"
	]
	quest.6A0D13F0A6E8B4C2.quest_subtitle: "受污染的世界是一个恢复问题,而不是一个替代采矿问题。"
	quest.6A0D13F0A6E8B4C2.title: "理想:夺回荒地"
	quest.6A3F28AD80E34E46.quest_desc: [
		"工艺品每批1个完整的活塞 MI 管道和流体管道。"
		"使用物品管道作为固体和流水管道作为水或蒸汽;在大厅前贴上标记变得难以追踪."
	]
	quest.6A3F28AD80E34E46.quest_subtitle: "12条管道和12条流体管道提供蒸汽、水和物质专用路线。"
	quest.6A3F28AD80E34E46.title: "管道蒸汽厅"
	quest.6AAB05DE2ECA0C5B.quest_desc: [
		"之后 阶段 6 开处、位置和位置 检查 a 数据为: MI 电动按摩师。"
		"饲料一个有用的矿石批量,确认输出存储可以接受每个产品."
	]
	quest.6AAB05DE2ECA0C5B.quest_subtitle: "在低电压时,电磁仪用蒸汽管道来换一个分层电路和更稳健的控制."
	quest.6AAB05DE2ECA0C5B.title: "电磁线"
	quest.6AD7B6898F2C1EBB.quest_desc: [
		"让损害统计通过正常的游戏而不是故意伤害来积累。"
		"审查造成危险的因素,改善住所、路线、衣服或撤退时间。"
	]
	quest.6AD7B6898F2C1EBB.quest_subtitle: "损害会悄悄地累积;有益的教训是,当损害发生时,就认识到了这一点。 跳闸 早该结束的"
	quest.6AD7B6898F2C1EBB.title: "刀疤长者"
	quest.6ADE5EF256DECCE9.quest_desc: [
		"示范50万 FE 已连接储备和 检查 墨卡尼主义冶金业的入侵者"
		"在控制条件下打开正常的饲料,恢复电网, 验证 连接器,然后运行一个有界的输液顺序。"
	]
	quest.6ADE5EF256DECCE9.quest_subtitle: "50万块 FE 和一个 检查 ed infuser测试扩建的地板在正常供应消失后是否能够恢复."
	quest.6ADE5EF256DECCE9.title: "超载断电滴"
	quest.6AF258C35F948253.quest_desc: [
		"触发 MI 核聚变反应堆 操作完成的系统,推进。"
		"使用运行时触发器的推进细节,然后离开 反应堆 在一个控制状态。"
	]
	quest.6AF258C35F948253.quest_subtitle: "离子点火记录在 反应堆 不只是在平面图上"
	quest.6AF258C35F948253.title: "融合太阳证明"
	quest.6B01C56711AE6B5D.quest_desc: [
		"地点和地点 检查 农民的美味烹饪壶作为恢复厨房。"
		"重建热,水,储粮,以及从普通物资供应中供应的容器."
	]
	quest.6B01C56711AE6B5D.quest_subtitle: "失物招领后,工作厨锅在更换便利设备前恢复有用餐具."
	quest.6B01C56711AE6B5D.title: "恢复住宅厨房"
	quest.6B7FC76B4CCC51B9.quest_desc: [
		"到达永恒的星光星光森林生物群落"
		"在收集不熟悉的材料之前,先标出通往前哨的路线,并保存返回的物资。"
	]
	quest.6B7FC76B4CCC51B9.quest_subtitle: "星光森林是第一个让新维度感觉有人居住而非仅仅是遥远的景观."
	quest.6B7FC76B4CCC51B9.title: "星光森林条目"
	quest.6B8B8DEA90332214.quest_desc: [
		"准备货船能力升级和橡木手推车。"
		"练习将重点货物卸入车厢而不堵塞码头."
	]
	quest.6B8B8DEA90332214.quest_subtitle: "能力升级和手推车是水和陆运之间最小的有用绕道。"
	quest.6B8B8DEA90332214.title: "货运副包"
	quest.6B9628300B7A3B88.quest_desc: [
		"地点和地点 检查 工作区内的核电压燃料再处理器。"
		"核查限制输入、浪费能力、失电行为、 屏蔽监控 离开前手动隔离"
	]
	quest.6B9628300B7A3B88.quest_subtitle: "只有在每个输入,输出,和故障状态都仍然被控制时,再处理器才可以运行,而无需操作员."
	quest.6B9628300B7A3B88.title: "审计未到"
	quest.6B973FB7A893F65F.quest_desc: [
		"储存了8枚核辐射碘药丸。"
		"保持它们具有独立的仪表和紧急指令;将距离、时间、限制和关闭作为主要保护。"
	]
	quest.6B973FB7A893F65F.quest_subtitle: "八颗碘药是装在标签柜里的 而不是用药代替的虚构 屏蔽 或撤离,或撤离,或撤离,或撤离,或撤离,或撤离,或撤离,或撤离,或撤离。"
	quest.6B973FB7A893F65F.title: "碘药储备"
	quest.6B9BEF3691B13A14.quest_desc: [
		"地点和地点 检查 a 地中海分裂 反应堆 外壳作为过渡性支助架构。"
		"利用它来证明化学燃料处理、逻辑和废物接口,然后将这些经验教训带入主要的核电阻燃料循环和 反应堆 工业区."
	]
	quest.6B9BEF3691B13A14.quest_subtitle: "限定支持 反应堆 是一个工程实验,不是包的最后核目的地。"
	quest.6B9BEF3691B13A14.title: "支持麦加主义实验"
	quest.6BC6A5F6DDF1390C.quest_desc: [
		"生产 16 MI 铝板。"
		"首先通过活铝、焦炭、干燥剂和色氨酸途径减少铝,然后使这批铝清除不受限制的自动加工。"
	]
	quest.6BC6A5F6DDF1390C.quest_subtitle: "16块铝板让MV地板具有结构储备,一次不消耗第一批还原批量."
	quest.6BC6A5F6DDF1390C.title: "储存第一铝板湾"
	quest.6BDB298464AD49A7.quest_desc: [
		"运行 MI 大型柴油发电机,直到其本土发展完成."
		"从一个测量燃料缓冲器开始,观察一个真正的受保护负载,并停止为另一个受控燃料提供足够的供应 黑启动."
	]
	quest.6BDB298464AD49A7.quest_subtitle: "进步证明柴油储备晚期能应付真正的负荷."
	quest.6BDB298464AD49A7.title: "证明大型柴油发电公司"
	quest.6BE1617D8EC9805C.quest_desc: [
		"地点和地点 检查 a 数据为: MI 钢箱,同时保持一个钢机壳的准备。"
		"在增加更多机器之前,留下一个清澈的水头,蒸汽干线,维护过道,以及输出缓冲器的空间."
	]
	quest.6BE1617D8EC9805C.quest_subtitle: "放置的罐体和钢壳可以定义水、蒸汽和机器服务将在何处生活。"
	quest.6BE1617D8EC9805C.title: "铺设钢铁蒸汽厅"
	quest.6BF0E7D18F1E27C4.quest_desc: [
		"生产64台TFMG煤焦炭."
		"把储备放在不燃地面，与木材、燃料管线和 Create 机器隔开；保持通往灭火器的通道畅通。"
		"把烟雾探测器安装在热作业边界上方，每次炼焦前检查灭火器，并在灭火前先切断燃料。"
	]
	quest.6BF0E7D18F1E27C4.quest_subtitle: "畅通的防火隔离、早期烟雾探测、燃料隔离和易取的灭火器能在故障蔓延到工厂前将其控制。"
	quest.6BF0E7D18F1E27C4.title: "可乐破火"
	quest.6C2CF9385D6A496E.quest_desc: [
		"地点和地点 检查 扩大 AE2 模式提供者。"
		"给它一套有界限的图案 测试同时的工艺品 而不是共同产出的僵局"
	]
	quest.6C2CF9385D6A496E.quest_subtitle: "第二种模式提供者只有在其渠道和机器面孔明确后才能增加吞吐量。"
	quest.6C2CF9385D6A496E.title: "委托第二供应商"
	quest.6C5C4C513A1DAC2C.quest_desc: [
		"烤盘四 TFC 由你加工的谷物生产的大麦面包."
		"把它们装进水里, 保存最新鲜的食物最长 跳闸."
	]
	quest.6C5C4C513A1DAC2C.quest_subtitle: "四根薄饼将一顿幸运的饭变成食物,可以支撑离开营地的真正路线."
	quest.6C5C4C513A1DAC2C.title: "外地口粮"
	quest.6CB7853B2709EBB9.quest_desc: [
		"工艺一 Infinity 升级和保留一个 Infinity 内脏"
		"升级是最终用途的组成部分;只有在催化剂和内嵌线可以补充后才能建造."
	]
	quest.6CB7853B2709EBB9.quest_subtitle: "An Infinity Upgrade beside an ingot marks a factory whose last transformation can be repeated by choice."
	quest.6CB7853B2709EBB9.title: "委员会最后的阿森松"
	quest.6D0D82E0E44EB0CD.quest_desc: [
		"股八中子堆和八颗蓝星光晶体硬盘."
		"记录哪些供应可在国内延期,哪些供应仍取决于前哨站。"
	]
	quest.6D0D82E0E44EB0CD.quest_subtitle: "八种中子堆和蓝硬币将工业和探险的证据放在同一负责的分类账上."
	quest.6D0D82E0E44EB0CD.title: "中子键编程器"
	quest.6D35BF597D49EA38.quest_desc: [
		"完成永恒的星光晶体催化推进."
		"在扩大消费之前,为矩阵和神秘研究保留参考催化剂。"
	]
	quest.6D35BF597D49EA38.quest_subtitle: "晶体诞生-催化性进展证明,可以识别一个异物样本,而不会将其降低为一般掠夺."
	quest.6D35BF597D49EA38.title: "水晶生的遗迹"
	quest.6D68FBB746A0DCCD.quest_desc: [
		"生产和转移4 000毫巴 MI 硫酸.."
		"将兼容的鼓标注,保持中性转移能力在附近,不通过普通流体存储来引导."
	]
	quest.6D68FBB746A0DCCD.quest_subtitle: "四桶固定储存,在不将松散的Chemlib桶提升到权威的情况下,界定酸性标准。"
	quest.6D68FBB746A0DCCD.title: "填充硫酸桶"
	quest.6D78A5B4DD4E9EAE.quest_desc: [
		"建铜盾."
		"在铁道机上工作所需的铜零件,然后组装盾牌,并用矿箱保存."
	]
	quest.6D78A5B4DD4E9EAE.quest_subtitle: "工作过的铜盾是同一个矿山开口的商店获得的保护。"
	quest.6D78A5B4DD4E9EAE.title: "铸造铜盾"
	quest.6D8EE28E14590C42.quest_desc: ["备好三十二份普通 MI 铁粉和三十二份 TFMG 煤焦炭。","完成工业热力研究后，用 MI 粉碎机加工已经获得的 TFC 锻铁锭。每个锭产出一份铁粉，保留原有加工消耗。","使用现有工业高炉的铁粉路线，并供应助焊剂和所需热风。启动前，为熔渣和炉气预留存储空间。"]
	quest.6D8EE28E14590C42.quest_subtitle: "准备标准铁粉、焦炭燃料和高炉供应线。"
	quest.6D8EE28E14590C42.title: "钢铁的舞台铁和可乐"
	quest.6DF54BD53EAC4EFE.quest_desc: [
		"数字电路之后, 组装 MI 蒸馏塔和 检查 确切的形状是扳手"
		"运行一个真正的批量. 一个大小的二号塔暴露了第一个输出,每个加成的层暴露了另一个,每个产品都需要独立的存储."
	]
	quest.6DF54BD53EAC4EFE.quest_subtitle: "数字电路解锁了每个建成层一个输出分离的多块."
	quest.6DF54BD53EAC4EFE.title: "沉积塔委员会"
	quest.6E294440E1BE97FD.quest_desc: [
		"将钛和ium盾体 置于工作室周围 GT LV场发电机和受保护的能源库。"
		"将共享合并 GT LV场发电机,钛壳,先进机体,以及保护的能量储存,然后在负载下测试本土盾构发电机."
	]
	quest.6E294440E1BE97FD.quest_subtitle: "盾牌生成器给予受保护的保留地一个定义的边界,该边界可以是 检查编队, 下水,安全接近。"
	quest.6E294440E1BE97FD.title: "集合盾牌生成器"
	quest.6E338F41663D7933.quest_desc: [
		"赚八块 电力电网 绝缘铜丝."
		"现场食谱结合了对 MI 铜丝带橡胶板;这是 电力电网 销售量,不是 MI 缆车替代。"
	]
	quest.6E338F41663D7933.quest_subtitle: "Electro Energetics 与 EE 绝缘把裸铜变成额定基础设施，但过载仍会造成真实故障。"
	quest.6E338F41663D7933.title: "隔热第一次电线运行"
	quest.6E47499369D61F86.quest_desc: [
		"将先进机体放置在MV操作区,让探索者 检查 就是这样"
		"将其作为真正建设计划的一部分,具有稳定的动力、无障碍电缆和缓冲输入,而不是 隔离 d 显示块。"
	]
	quest.6E47499369D61F86.quest_subtitle: "新船体在连接线无需人工救援即可完成工程时就获得其位置."
	quest.6E47499369D61F86.title: "将高级壳装入"
	quest.6E4E3EDB1D124E1D.quest_desc: [
		"建沉积石贾维林."
		"将匹配的石头工具头按住, 然后用棍子组合起来。 在旅行前携带备用头。 Name"
	]
	quest.6E4E3EDB1D124E1D.quest_subtitle: "当夜里拒绝住在避难所外面时,Javelin会提供距离。"
	quest.6E4E3EDB1D124E1D.title: "捕食者石·贾维林"
	quest.6E81145C1B79511D.quest_desc: [
		"完成 MI 钛-ingot通过安装的路线推进."
		"保持鲁特利,化学,热加工, 真空冷却准备 另一英寸。"
	]
	quest.6E81145C1B79511D.quest_subtitle: "钛的推进证实了化学,高热,真空都取得了顺序的成功."
	quest.6E81145C1B79511D.title: "钛索赔"
	quest.6E96CB6D2CAE323D.quest_desc: [
		"建造两台火箭纳米发动机喷嘴,并保留8个钛气缸."
		"试验远离储存和占用工作,然后隔离任何显示异常磨损的喷嘴。"
	]
	quest.6E96CB6D2CAE323D.quest_subtitle: "由钛库存支撑的两个发动机喷嘴使燃烧试验可以重复而不是破坏性."
	quest.6E96CB6D2CAE323D.title: "喷嘴燃烧测试"
	quest.6EA1990C3A362FF6.quest_desc: [
		"库存8个HDPE床单和8个基本压管."
		"保持聚合物饲料,铝,罐体,以及重型连接器的可用性,以补充两部分."
	]
	quest.6EA1990C3A362FF6.quest_subtitle: "8个HDPE床单和压力管使回收架无法耗尽。"
	quest.6EA1990C3A362FF6.title: "缓冲聚变器和调制器"
	quest.6EB03CF566178A0E.quest_desc: [
		"16号球,TFMG火腿球"
		"将可行的种子存放在可折叠区域之外,而不是在成品砖输出中。"
	]
	quest.6EB03CF566178A0E.quest_subtitle: "16个火球使炼油厂的建筑无法恢复。"
	quest.6EB03CF566178A0E.title: "阶段火炬种子"
	quest.6EB24DB178B647C9.quest_desc: [
		"构造一个 AE2 量子链接在空间理论,计算机化导航,深空工程证明等之后会汇合."
		"证明两个端点都有独立的电源和有文件证明的恢复路径。这证明了世界间连接理论;第一个固定的星门仍然属于 时代 15工程学科."
	]
	quest.6EB24DB178B647C9.quest_subtitle: "一个有动力的量子端点可以证明连结理论,而不会取代先到的或后来的星门网络."
	quest.6EB24DB178B647C9.title: "时代 12——世界间联系理论证明."
	quest.6EDA5D14095E5827.quest_desc: ["Complete a precision mechanism to prove water power, alloy reserves, repair stock, and sequenced assembly now form a dependable foundry.","Produce track and reserve wrought iron for the route. The Foundry proof needs water-powered forming, mixing and precision assembly. Schedules and an assembled train remain required by the later serviced freight terminal after Bronze Steam suppliers become available."]
	quest.6EDA5D14095E5827.quest_subtitle: "CANONICAL AGE 2 PROOF — Alloy Foundry"
	quest.6EDA5D14095E5827.title: "科学创始人"
	quest.6F35541A6AE49D6F.quest_desc: [
		"建造两台助推器,并储存四台rid板."
		"储备匹配的控制硬件和 检查 下个深空出发前 两台推进器都用过"
	]
	quest.6F35541A6AE49D6F.quest_subtitle: "助推器对和rid板将推力和硬化导线放在同一个任务架上."
	quest.6F35541A6AE49D6F.title: "助推推器拉克( Rack)"
	quest.6F607C6089E0E378.quest_desc: [
		"地点和地点 检查 墨卡尼主义的裂变 反应堆 逻辑适配器."
		"电线并测试选择的关闭条件 反应堆 未加油或以其他方式安全;在信号丢失后确认控制器状态."
	]
	quest.6F607C6089E0E378.quest_subtitle: "逻辑适配器只有在它的故障信号产生已知的安全状态而不取决于玩家的反射时才重要."
	quest.6F607C6089E0E378.title: "验证自动关闭逻辑"
	quest.6F6243D7B266520A.quest_desc: [
		"库存4个1千米物品存储电池和16个打印硅."
		"保持一个牢房空置以恢复,并保护股票不被自动伪造."
	]
	quest.6F6243D7B266520A.quest_subtitle: "4个1k电池和16个打印的硅封面存储和处理器回收,而不囤积更大的电池."
	quest.6F6243D7B266520A.title: "三相分离单元修复"
	quest.6F707C5B16133FFD.quest_desc: [
		"地点和地点 检查 被开除 TFC 大型船只在住宅区储存区。"
		"保持清洁食品,应急物资,收集物资按用途分开."
	]
	quest.6F707C5B16133FFD.quest_subtitle: "放置一个大型船印,供货归来,分类,成为下一个 跳闸照片来自Flickr用户,"
	quest.6F707C5B16133FFD.title: "铺设家居仓库"
	quest.6F8B6903E83C0883.quest_desc: [
		"将工作系统增加到5 000 000 FE 还有一个涡轮机壳"
		"在真实转换负载下测试并保存 反应堆 燃烧率低于冷却剂、涡轮机和废物容量。"
	]
	quest.6F8B6903E83C0883.quest_subtitle: "五百万 钱 FE 涡轮机载荷下显示蒸汽转换和电力出口是否在规模上达成一致."
	quest.6F8B6903E83C0883.title: "涡轮同步"
	quest.7010E0E2E7924D9C.quest_desc: [
		"输入永恒星光维度,建立安全前哨路线."
		"携带返回方法、坐标、备用设备、食品、药品、防线、储存和 修复 材料。"
	]
	quest.7010E0E2E7924D9C.quest_subtitle: "星光是一个前哨问题:不熟悉的地形,敌对的恢复距离,只有返回时才有重要的样品."
	quest.7010E0E2E7924D9C.title: "星光外站路线"
	quest.7059B85C9A1082CF.quest_desc: [
		"之后 阶段 15个打开、位置和位置 检查 a 经典星门。"
		"将闸门作为运输基础设施: 验证 地址、权力、安全以及独立返回方法。"
	]
	quest.7059B85C9A1082CF.quest_subtitle: "在量子座,一个星门在远方能够安全接收和返回货物后,才延长货运图."
	quest.7059B85C9A1082CF.title: "行星际物流预览"
	quest.707309F2FD43021B.quest_desc: ["建立Mekanism冶金厂 检查 编号 电力电网 设备连接器。","使用铝板和MI部件的灌注机配方，分别供应能源与灌注原料，并完成一批有用的电路。每次无升级灌注加工消耗10000J；能源槽中的一份红石粉可提供这部分能量。"]
	quest.707309F2FD43021B.quest_subtitle: "安装的装置连接器旁的完成的喷雾器,标志着MV基础设施向化学的可控交接。"
	quest.707309F2FD43021B.title: "高级电厂委托 终极挑战"
	quest.70B9B71E2690EED0.quest_desc: [
		"地点和地点 检查 钢水泵在活锅炉的喂养系统。"
		"验证其来源和缓冲器在走之前可以提供最差的混合锅炉负荷."
	]
	quest.70B9B71E2690EED0.quest_subtitle: "钢水泵使更高的蒸汽需求可持续,而不是仅仅令人印象深刻。"
	quest.70B9B71E2690EED0.title: "添加钢水泵"
	quest.70C8512A7E97AEF6.quest_desc: [
		"构建一个 AE2 驱动并连接到控制器网络。"
		"从小细胞开始,通过存储巴士来附加大量库存,而不是隐藏数字存储中的每一个街区."
	]
	quest.70C8512A7E97AEF6.quest_subtitle: "驱动舱为储存室提供动力,同时散装材料仍留在实际仓库。"
	quest.70C8512A7E97AEF6.title: "驱动湾框架"
	quest.70ECC0747160D60E.quest_desc: [
		"高压开启后生产8种现代工业化钛内基."
		"原生钛冶炼被移除;随安装的 MI 权限路线。"
	]
	quest.70ECC0747160D60E.quest_subtitle: "八号 MI 钛化石建立了晚期飞行硬件实际消耗的结构金属."
	quest.70ECC0747160D60E.title: "采用钛标准"
	quest.7103C2FC832DF6EB.quest_desc: [
		"库存4个铜喷嘴和2个rid内基."
		"保持两个材料流的分隔,直到有文件记录 航天器 集会呼吁两者。"
	]
	quest.7103C2FC832DF6EB.quest_subtitle: "4个铜喷嘴和2个rid内槽既准备低成本的流线硬件,又准备硬化的接触器."
	quest.7103C2FC832DF6EB.title: "铜喷嘴宾"
	quest.712795EF63FB096F.quest_desc: [
		"给背包包做个背包"
		"运水,食用,备用陶器,以及路线标志;运空的收集货物,然后运回包被搬走."
	]
	quest.712795EF63FB096F.quest_subtitle: "背包延伸a 跳闸 只有在它的额外空间 并没有充满 属于在家里的东西。"
	quest.712795EF63FB096F.title: "后包装路由"
	quest.717E8527B8A693E9.quest_desc: [
		"之后 阶段 13 打开、位置和位置 检查 a 墨卡尼主义化学洗涤器。"
		"把它当作一个有标签的输入、清洁水供应和有限度产出的、包含在一条有标签的链条中的锚。"
	]
	quest.717E8527B8A693E9.quest_subtitle: "国家化学综合体用分离的气体、浆液、洗涤、储存和废物走廊取代散落的反应。"
	quest.717E8527B8A693E9.title: "国家化学综合体"
	quest.7185EAC32461C0B1.quest_desc: [
		"地点和地点 检查 a 地中海分裂 反应堆 逻辑适配器."
		"配置安全状态和关闭行为, 然后 验证 控制从外部 反应堆 装上燃料前的房间"
	]
	quest.7185EAC32461C0B1.quest_subtitle: "逻辑适配器将临界控制转换成一个信号,设施可以监测,而不会去除手动权限."
	quest.7185EAC32461C0B1.title: "临界控制认证"
	quest.7189E799D55C5132.quest_desc: [
		"触发 AE2 模式编码终端的推进 。"
		"编码一个稳定的手艺, 验证 其成分和输出在扩展库前。"
	]
	quest.7189E799D55C5132.quest_subtitle: "模式-地铁进步证实,在已知其物理依赖性的地方,可以编码配方。"
	quest.7189E799D55C5132.title: "图案图案"
	quest.719B384A75DF7245.quest_desc: [
		"一次使用活体机械制造模式,生产其对火箭发射器."
		"配方产生一对并需要钛结构,数字电路,高级泵,rid,以及精英控制电路."
	]
	quest.719B384A75DF7245.quest_subtitle: "两种匹配的火箭推进器足以证明数字,钛,rid,和梅卡尼主义的供应线趋同."
	quest.719B384A75DF7245.title: "构建轨道推力"
	quest.71A6D59766E18690.quest_desc: [
		"完成Mekanism的环境 - - -辐射 只能通过控制下的核运行推进"
		"停止源头,检查仪表,限制进入,继续前遵循设施恢复计划."
	]
	quest.71A6D59766E18690.quest_subtitle: "电话 辐射 进步是调查和遏制的警示,绝不是农业生产的目标。"
	quest.71A6D59766E18690.title: "辐射钟"
	quest.71ABB3C300134014.quest_desc: [
		"通过LV配方的活泼制作4个斯特拉里斯火箭鳍."
		"将鱼鳍固定在一起,在着陆损坏后为替换保留同样的材料供应。"
	]
	quest.71ABB3C300134014.quest_subtitle: "四条鳍将钢,重板,橡胶线变为一个飞行准备组装."
	quest.71ABB3C300134014.title: "装配一个完整的 Fin 集"
	quest.71B7BE8590A5D63F.quest_desc: [
		"展示一亿 FE 独立储备基金。"
		"恢复存储、路由、冷却和制造,只有在每个输出路径都清楚之后才能允许稀有输入。"
	]
	quest.71B7BE8590A5D63F.quest_subtitle: "储存了1亿 FE 允许在要求任何单一进程给自己喂饱之前控制返回。"
	quest.71B7BE8590A5D63F.title: "冷启动聚合工程"
	quest.71D7705EE25FFE16.quest_desc: [
		"4个中子内基和2个晶体母体块"
		"盖石颂扬可重复性;量子仍需要超导体,聚变准备,奇异性,以及天体输入."
	]
	quest.71D7705EE25FFE16.quest_subtitle: "中子内基体和晶体基质现在留下两个缓慢,可再生的系统,而不是一个奖励表."
	quest.71D7705EE25FFE16.title: "委员会 极端工业"
	quest.721D9CC6A2ED56E0.quest_desc: [
		"在故意断开或停止输出后检查放置的水轮."
		"追踪轴线和压力负载 重新启动 ing; 添加速度不会造成容量缺失."
	]
	quest.721D9CC6A2ED56E0.quest_subtitle: "车轮停靠是水的获取、轴向调整和超载压力方面的教训。"
	quest.721D9CC6A2ED56E0.title: "检查一个已安装的水轮"
	quest.722119609CAAC37F.quest_desc: [
		"股票八 AE2 工程处理器和16个certus石英晶体."
		"保存可以重新填充托盘的报盘序列,红石,硅,晶体供应."
	]
	quest.722119609CAAC37F.quest_subtitle: "8个工程处理器和16个certus晶体使下一个存储或工艺构建了计划的工作."
	quest.722119609CAAC37F.title: "工程处理器托盘"
	quest.7235A3B8D080D73D.quest_desc: [
		"生产并储存16枚青铜戒指."
		"使用当前铸造的锤子,压缩机,或者设计适合大厅的路线,留下足够的青铜板."
	]
	quest.7235A3B8D080D73D.quest_subtitle: "16个铜环封印、转子、罐体和 修复彼此之间"
	quest.7235A3B8D080D73D.title: "股票铜印环"
	quest.725FBC5CE04051F8.quest_desc: [
		"之后 阶段 10 打开,安装一个 CC:Tweaked 电脑,8个网络电缆,以及一个有文件记录的机器电池的全块有线调制解调器。"
		"读取一个真实的操作状态并驱动一个有边框的控制输出。 程序监督可见的机械; 它不会取代物理路径、 网格保护或安全手动停止 。"
	]
	quest.725FBC5CE04051F8.quest_subtitle: "电线电脑变成 工厂 控制,只有在传感器、输出和倒置都明确的情况下。"
	quest.725FBC5CE04051F8.title: "工厂控制计算机"
	quest.726E70BD8B31C231.quest_desc: [
		"构建 4 电力电网 电池通过它们活的 顺序组装路线。"
		"每个电池都依赖于导电壳、电池合金部件和酸;保持其作为故意储存的线条,而不是松散的奖杯。"
	]
	quest.726E70BD8B31C231.quest_subtitle: "4个电池给电网时间,将短中断与完全停产分开."
	quest.726E70BD8B31C231.title: "阶段电池储备"
	quest.728B2E2AB28A5C4E.quest_desc: [
		"完成斯特拉里斯水星登陆计划"
		"保持热防护,氧气,回升燃料,导航独立于远征货物."
	]
	quest.728B2E2AB28A5C4E.quest_subtitle: "水星登陆的推进是发射基地所能重复的最短路线。"
	quest.728B2E2AB28A5C4E.title: "水星怒火行动"
	quest.72DCA202D92A74E0.quest_desc: [
		"处理阵列后构建机器链条, CC:Tweaked 控制电脑、路由走 和蓄意干扰恢复都已完成"
		"其账单现在包括处理控制,变压器芯,接触器,HV断路器, CC:Tweaked 电缆和多机结构; CC:Tweaked 监督、现代动态线路和 AE2 拥有存储和要求的生产。"
	]
	quest.72DCA202D92A74E0.quest_subtitle: "链路器协调已建立机器; CC:Tweaked 拥有可编程监督,现代动态线路,以及 AE2 拥有网络化存储和自动制作."
	quest.72DCA202D92A74E0.title: "协调工厂地板"
	quest.72E7F709D1ADB228.quest_desc: [
		"生产和转移四千毫巴克 MI 低调的路德。"
		"放在真空解冻器的环边 而不让核聚变维护消耗最后一批"
	]
	quest.72E7F709D1ADB228.quest_subtitle: "冰冻路德是冷的基础设施:每一个超导线都依赖于其清洁生产和绝缘储备."
	quest.72E7F709D1ADB228.title: "哭喊的德瓦尔"
	quest.72F93E292C594FB1.quest_desc: [
		"装了两个铜轮和四个铜轮作为驱动器备用"
		"把它们存放在它们适合的机器附近,而不是在混合矿石输出中,因为一个路由过滤器可能导出它们。"
	]
	quest.72F93E292C594FB1.quest_subtitle: "两台转盘和四台齿轮 使每台下游机器都无法开动一台受损的驱动器"
	quest.72F93E292C594FB1.title: "旋转修理电源"
	quest.72FE5FB900814DC9.quest_desc: ["Stock eight Create electron tubes and sixteen copper wire for repeatable analog-control production.","Keep this reserve outside unrestricted automation so the control line can restart when powered assembly stops."]
	quest.72FE5FB900814DC9.quest_subtitle: "A transistor and conductor reserve keeps the LV control line recoverable."
	quest.72FE5FB900814DC9.title: "Fill the Control Drawer"
	quest.73247B95B5E00487.quest_desc: [
		"生产并转移重油16000mB."
		"使用真实的源、管道和缓冲器;您库存中持有的容器不是预期的证据。"
	]
	quest.73247B95B5E00487.quest_subtitle: "16桶重油为有计划出口和溢出余地的抽水提供理由。"
	quest.73247B95B5E00487.title: "重油泵"
	quest.73672BD67231F47C.quest_desc: [
		"库存 64 CC:Tweaked 电缆,八 电力电网 设备连接器, 和32铜板 旁边有文件记录的工作细胞。"
		"记录每次退出,并在下次运行班次前补充货架."
	]
	quest.73672BD67231F47C.quest_subtitle: "多班控制只在网络和网格时才值得信赖 修复不许食用另一个活细胞"
	quest.73672BD67231F47C.title: "多屏蔽控制系统修理库存"
	quest.737FFDF52AD1457B.quest_desc: [
		"建设4座核克拉夫特硼热汇."
		"活食谱将硼粉和空热汇结合起来; 验证 确切地说,他们的位置规则 反应堆 设计。"
	]
	quest.737FFDF52AD1457B.quest_subtitle: "在被移除的Mekanism/CROWNS化学机器路线使得硼酸无法实现后,四个硼热汇保留了中子控制对象."
	quest.737FFDF52AD1457B.title: "阶段 博伦热沉储备"
	quest.738C2C3AB4A0B067.quest_desc: [
		"触发 MI 血浆涡轮推进通过实际操作."
		"验证等离子体输入,电输出,以及任何一方暂停时的安全行为."
	]
	quest.738C2C3AB4A0B067.quest_subtitle: "等离子涡轮校验关闭了封闭聚变与可用电网电源之间的循环."
	quest.738C2C3AB4A0B067.title: "等离子涡轮装入"
	quest.73B7963EFEF231FD.quest_desc: [
		"股票三十二 电力电网 电线"
		"在安装替换前找到超载,擦伤,终止不良,或错误的保护."
	]
	quest.73B7963EFEF231FD.quest_subtitle: "32条电线代替受损的跑道,而不绕过导致它的断层."
	quest.73B7963EFEF231FD.title: "储存全线修复"
	quest.73CEF161E64AB23E.quest_desc: [
		"在扫描纳诺处理器的先决条件后,在维护的清洁室中生产一个量子处理器."
		"也来了 MI 量子电路,先进的Greg组件,以及研究最终生产机构的控制核心."
	]
	quest.73CEF161E64AB23E.quest_subtitle: "量子处理器是研究后进入组装线建设的控制桥."
	quest.73CEF161E64AB23E.title: "量子处理器"
	quest.73D78C6CF64BCF93.quest_desc: ["Commission a Spirit Crucible and Spirit Catalyzer.","Age 5 experiments now combine measured energy, steel-era components, and larger spirit requirements.","Optional during normal age progression. Esoteric evidence becomes required only at final Reality Engineering through ESO-04 to FRN-06."]
	quest.73D78C6CF64BCF93.quest_subtitle: "精神能量成为工业实验室的实践."
	quest.73D78C6CF64BCF93.title: "Spirit Energetics"
	quest.742FAE8C207E014F.quest_desc: [
		"股票八 AE2 逻辑处理器和16个不锈钢硬币"
		"保留印刷硅、印刷逻辑、红石和不锈原料,以复制批次。"
	]
	quest.742FAE8C207E014F.quest_subtitle: "八个逻辑处理器和十六个不锈的硬币 提供例行的工艺室 而不会消耗消耗消耗量"
	quest.742FAE8C207E014F.title: "三相分离的数字股票"
	quest.743B77F90D03EDF7.quest_desc: [
		"积四 re:Avaritia 中子堆积."
		"保持收集器不断供应,并记录更换批次所需的时间."
	]
	quest.743B77F90D03EDF7.quest_subtitle: "四中子堆使采集者计时可见,而不会假装第一个输出是生产线."
	quest.743B77F90D03EDF7.title: "收集第一个中子键"
	quest.7489D8F7F34227D4.quest_desc: [
		"生产并转移8000毫巴克的TFMG neghtha."
		"将每一份蒸馏产品置于标签储存中, 验证 没有完全的通道 封锁整个塔。"
	]
	quest.7489D8F7F34227D4.quest_subtitle: "八桶凝固汽油证明了TFMG炼油厂正在分离原油,而不仅仅是储存一个塔台控制器。"
	quest.7489D8F7F34227D4.title: "分离第一批纳芙莎批"
	quest.74A38055C1A9013C.quest_desc: [
		"生产并转移16 000毫巴的斯特拉里斯燃料。"
		"通过创建混合并保持弓箭手存储器转换活的 TFMG 燃料 隔离 d 普通流体消费者。"
	]
	quest.74A38055C1A9013C.quest_subtitle: "弓箭手持有足够的改装燃料,可以装载火箭而无需耗尽其返回储备."
	quest.74A38055C1A9013C.title: "发射燃料鲍瑟"
	quest.74A82D693AB26B9D.quest_desc: [
		"16号车 在加工层旁边 制造槽和32块铜板"
		"继续用工具包清除工具和路由注释。隔离一个被封锁的槽分支,纠正存储原因,并仅此一次 重新启动."
	]
	quest.74A82D693AB26B9D.quest_subtitle: "创建保存第一个 工厂 修复能够用可见的,局部的重力路由。"
	quest.74A82D693AB26B9D.title: "创建物流修复工具箱"
	quest.74C303EF74DB3A84.quest_desc: [
		"建造一个斯特拉里斯大氧气罐,并持有16000mB的斯特拉里斯燃料."
		"完成这个分支,先在主燃料储备和标签之后,再完成第二班的燃料量。"
	]
	quest.74C303EF74DB3A84.quest_subtitle: "一个大型的氧气罐和16桶燃料让第二个机组人员继承能力而不是空表."
	quest.74C303EF74DB3A84.title: "打开第二版启动移动"
	quest.74CEEA5EED3C8A97.quest_desc: [
		"库存四裂变燃料组件和 检查 化学洗涤器。"
		"将燃料、浆液、酸液和清洁输出置于单独标签的容器中。"
	]
	quest.74CEEA5EED3C8A97.quest_subtitle: "四个卸下组件和一个操作洗涤器,在燃料堆放时不储存危险 反应堆."
	quest.74CEEA5EED3C8A97.title: "三阶段燃料处理"
	quest.74D72636703F7DCB.quest_desc: [
		"带着16颗蓝星光晶体碎片回来"
		"标签是生物母体和源,然后将样品从通用宝石自动化中分离出来。"
	]
	quest.74D72636703F7DCB.quest_subtitle: "16块蓝色晶体沙砾使得星光样品架有用,同时又没有消除进一步探险的需要."
	quest.74D72636703F7DCB.title: "Exotic 样本供应运行"
	quest.74F7C07ACEF2F804.quest_desc: [
		"检查钢蒸馏控制器,并生产8个治愈的天然橡胶板."
		"运行足够粗糙的 充斥产品罐, 然后清理每一个出口 和补充封条。"
	]
	quest.74F7C07ACEF2F804.quest_subtitle: "一个运行中的TFMG控制器和八张橡胶板证明分离和维护用品可以共存."
	quest.74F7C07ACEF2F804.title: "运行抖动"
	quest.751A5CBE912F3939.quest_desc: [
		"通过其安装的食谱,建造一个应用的流星能源处理器."
		"保持处理器制造供应,并将后期设备连接到一个测量的外部网格."
	]
	quest.751A5CBE912F3939.quest_subtitle: "应用的奢侈能源处理器带来 FE 计及 AE2 而不是假装存储是代。"
	quest.751A5CBE912F3939.title: "能源处理器线"
	quest.755B62D9C5A5894E.quest_desc: [
		"构建一个 MI 量子升级和1个复制机."
		"两者都消耗受控单数产品;从活的单数过程而不是从追求的奖励中提供UU Matter."
	]
	quest.755B62D9C5A5894E.quest_subtitle: "第一次量子升级和复制 使事情本身就成为了责任 工厂 输入。"
	quest.755B62D9C5A5894E.title: "投运物质复制系统"
	quest.757A5A9D2DD7BA36.quest_desc: [
		"生产和储存 16 MI 钢板来自批准的TFMG钢材."
		"使用一个流成形的路线,使板块远离可以不加区别地消耗替代钢的食谱."
	]
	quest.757A5A9D2DD7BA36.quest_subtitle: "16块板块让弹壳和锅炉工作有真正的结构储备."
	quest.757A5A9D2DD7BA36.title: "股票结构钢板"
	quest.75A26851CCA32314.quest_desc: [
		"生产并转移16,000mB的润滑油."
		"管道8000mB的润滑油,变成一个日油罐,不能误认为是燃料储存."
	]
	quest.75A26851CCA32314.quest_subtitle: "一天的润滑剂罐使维护工作与下一次蒸馏运行独立."
	quest.75A26851CCA32314.title: "润滑油日坦克"
	quest.75D6F232A1EB12EC.quest_desc: [
		"步行所需距离,同时确定项目实际摄入量。"
		"分离不兼容的流体和危险,使过境方便,并允许今后平行线路通行."
	]
	quest.75D6F232A1EB12EC.quest_subtitle: "输入沟是一条服务路线,长度很重要,因为每条材料、管道和工人必须穿过这条管道。"
	quest.75D6F232A1EB12EC.title: "输入端口沟"
	quest.75ED33867CE210F6.quest_desc: [
		"找到一个斯特拉里斯金星外哨 安全返回"
		"利用准备的掩体进行接触,保存氧气和冷却储备,并留下足够的能力回收有用的材料。"
	]
	quest.75ED33867CE210F6.quest_subtitle: "金星前哨只有在其周边、出口和返回货物安全后才成为宝贵的突破。"
	quest.75ED33867CE210F6.title: "金星外站断层图"
	quest.75ED4F2F7CFFA8A2.quest_desc: [
		"调检查 斯黛拉里斯发射台作为发射场的探测"
		"核查接近情况,车站清关,排气空间,以及附近储存的保护情况."
	]
	quest.75ED4F2F7CFFA8A2.quest_subtitle: "第二次现场调查证明,安装的垫子仍然是安全运行发射区。"
	quest.75ED4F2F7CFFA8A2.title: "勘测实际发射场"
	quest.762AEA107E4C095D.quest_desc: [
		"缓冲8桶UU物质和4桶氦等离子体."
		"使用单独的,标签化的罐体,并在下一批汇合后恢复两种库存."
	]
	quest.762AEA107E4C095D.quest_subtitle: "UU Matter和氦等离子体保持与聚变和单数系统相连的趋同,从而得以实现."
	quest.762AEA107E4C095D.title: "缓冲 UU 物质和氦等离子体"
	quest.764FD52CDBFE613F.quest_desc: [
		"检查磁稳定器和二级火箭发射推进器."
		"留有清澈的货道,保护生命,无障碍电源,以及回收车辆路径."
	]
	quest.764FD52CDBFE613F.quest_subtitle: "稳定器和匹配的火箭推进器界定导航、推进、货物和服务在哪里交汇。"
	quest.764FD52CDBFE613F.title: "铺设深空场"
	quest.767549982DA5DAC1.quest_desc: ["Perform the Werewolves discovery experiment and build its native Stone Altar.","Complete the native cure route; transformation remains optional.","This is an optional discipline at this age; the canonical factory proofs govern normal progression."]
	quest.767549982DA5DAC1.quest_subtitle: "沃尔夫斯班,银,场证据支持研究,不强制进行淋巴运动."
	quest.767549982DA5DAC1.title: "Werewolf Research and Cure"
	quest.769FA85044CD698B.quest_desc: [
		"通过高压授权配方建造一个屏蔽发电机."
		"连接到受保护的电源,然后确认存储的能量和晶体燃烧后再添加场载荷."
	]
	quest.769FA85044CD698B.quest_subtitle: "专用屏蔽室将外地负载与普通负载分开 工厂 公共汽车和 反应堆 凉爽。"
	quest.769FA85044CD698B.title: "盾牌发电机房"
	quest.76CFB32025BCFCA4.quest_desc: [
		"保留一个中子采集器和两个晶体-母体块作为重建存量."
		"隔离故障的工作电池,在安装替换机械前回收样品。"
	]
	quest.76CFB32025BCFCA4.quest_subtitle: "一个备用中子采集器和两个矩阵块使控制损失不会结束极端生产。"
	quest.76CFB32025BCFCA4.title: "阶段 : Astral- Line 重建"
	quest.76E18603E4688CED.quest_desc: [
		"为石油或炼油产品建造一个TFMG铸铁液箱。"
		"把它放在一个装有标签的油箱区, 并有足够备用的关闭转移能力。"
	]
	quest.76E18603E4688CED.quest_subtitle: "铸铁储存属于这里;钢罐等待随后的钢管局."
	quest.76E18603E4688CED.title: "安装 Cast- Iron 流体存储"
	quest.7727CEC258BAA527.quest_desc: ["Supply four analog circuits and 100,000 FE to prepare the next LV workcell.","Use the meters to check generation and storage under load. The delivery task records supplied energy; inspect the operating circuit before declaring a brownout test passed."]
	quest.7727CEC258BAA527.quest_subtitle: "Deliver energy to the test-cell task; use meters to inspect operating behavior."
	quest.7727CEC258BAA527.title: "Power the LV Test Cell"
	quest.774F57B2421E8879.quest_desc: [
		"保持两个超导圈,显示5千万 FE 连接的储备。"
		"先恢复冷却和控制,然后在田间和等离子体插口核实后才允许使用燃料."
	]
	quest.774F57B2421E8879.quest_subtitle: "备用田径圈和独立的能源库 重新启动 可能的话,在完全关闭之后。"
	quest.774F57B2421E8879.title: "准备聚变冷启动"
	quest.776B592B51403BAF.quest_desc: [
		"建立和储存 32 个Mekanism 反应堆- 玻璃块"
		"将托盘放在控制区外, 验证 打开任何规则前的替换 反应堆 结构。"
	]
	quest.776B592B51403BAF.quest_subtitle: "三十二岁 反应堆- 玻璃块会破坏边界 修复能够不从活壳借钱。"
	quest.776B592B51403BAF.title: "库存反应堆-玻璃更换"
	quest.7793F286E36BA3D0.quest_desc: [
		"制作一个工具带 通过其安装的食谱。"
		"仅装入工作所需的工具,并将食物、水和恢复用品妥善储存。"
	]
	quest.7793F286E36BA3D0.quest_subtitle: "一个工具带可以使工作工具可以到达,而不会假装它取代了完整的补给包."
	quest.7793F286E36BA3D0.title: "工具带准备"
	quest.77CE6D94F2134283.quest_desc: [
		"4块 Stellaris 脱脂板块和8块脱脂板块"
		"生产它们通过月球-矿石, 乳母,焦炭, 和爆炸-家具路线。"
	]
	quest.77CE6D94F2134283.quest_subtitle: "四个镀层块和八个底土块防止一个制造订单消耗最后返回的金属。"
	quest.77CE6D94F2134283.title: "缓冲返回- 金属移动"
	quest.77D439E8930367B0.quest_desc: [
		"保持8个压气管和1个化学喷雾器的回收准备."
		"排水或隔离受损的线路,识别每一种化学品,然后重建后再重新连接共享存储."
	]
	quest.77D439E8930367B0.quest_subtitle: "备用管子和吸尘器 隔离 d 封闭损失后可更换的化学分支。"
	quest.77D439E8930367B0.title: "重建压力处"
	quest.77E74DB4F30E0730.quest_desc: ["保留 LV 涡轮机，并通过转换器向任务屏幕交付 50,000 FE。","测试时检查蒸汽供应和 MI 负载；物品与 FE 计数器不会测量涡轮机的输出功率。"]
	quest.77E74DB4F30E0730.quest_subtitle: "五万块 FE 在真正的涡轮机负荷下,在生产依赖于它之前,会发现蒸汽饲料很弱."
	quest.77E74DB4F30E0730.title: "准备涡轮机负载测试"
	quest.77E9569D1D0BA674.quest_desc: [
		"生产和转移16 000毫巴 MI 氧气"
		"使用专用缓冲器和 验证 确切的现场食谱 需要它之前连接头。"
	]
	quest.77E9569D1D0BA674.quest_subtitle: "16桶氧气支持 控制化学 仅同时,每个出口和材料兼容性 已知。"
	quest.77E9569D1D0BA674.title: "氧化冷却剂头"
	quest.77EF266EBF4F170C.quest_desc: ["Fire four Enchanted clay jars after establishing Copper-era empirical and botanical observation.","This optional botanical branch is separate from Stone survival. Its later occult synthesis remains part of the established final convergence."]
	quest.77EF266EBF4F170C.quest_subtitle: "四枚发射罐用第一个可重复使用的实验室船只取代一个导线。"
	quest.77EF266EBF4F170C.title: "TFC 民间魔术——火巫术Jars"
	quest.781B84CA4BF0B0F6.quest_desc: ["从已投运的 EE 电网向 FTB Quests 任务屏幕交付 25,000 FE。任务会消耗交付的电能，不会测量储存的启动备用电量。"]
	quest.781B84CA4BF0B0F6.quest_subtitle: "装满电荷的电池 足以在蒸汽轮机装满前 唤醒控制器 工厂设施."
	quest.781B84CA4BF0B0F6.title: "投运首个 FE 测试单元"
	quest.78470B17585DF4D0.quest_desc: [
		"之后 阶段 8 打开、建造和 检查 物理学的阿森布勒"
		"用于物理车辆的建造,并保持手动控制,推进,稳定,以及路由自动化作为单独的后期系统."
	]
	quest.78470B17585DF4D0.quest_subtitle: "建造海湾使得实验车辆成为可能;它不能使车辆稳定或自主."
	quest.78470B17585DF4D0.title: "车辆建筑湾"
	quest.784D0217780D9ADE.quest_desc: [
		"触发Re:阿瓦里提亚永恒的星际争霸进步."
		"保持单数分类账流 所以没有生产 仍然可见 在第一次成功。"
	]
	quest.784D0217780D9ADE.quest_subtitle: "永恒的歌声进步记录了 工厂 能够命名它压缩过的每一种材料。"
	quest.784D0217780D9ADE.title: "永恒的星系王冠"
	quest.786438808FFAEF7E.quest_desc: [
		"保留一个替代的焦炭炉和八张橡胶板。"
		"在交换设备之前隔离热材料和空连接的流体路径或 重新启动正在准备这批货"
	]
	quest.786438808FFAEF7E.quest_subtitle: "更换炉子和新鲜封条证明燃料侧故障不会结束 工业区."
	quest.786438808FFAEF7E.title: "恢复可乐线"
	quest.788179FC1E88E035.quest_desc: [
		"完成 TFC 准备生粘土进行坑内射击时,"
		"在点火前安排吸管和木头,并在附近保留替换粘土,以防第一批不完全."
	]
	quest.788179FC1E88E035.quest_subtitle: "坑窑是第一个经过不见踪影的过程后精心准备的地方."
	quest.788179FC1E88E035.title: "从 Raw Clay 创建坑基伦"
	quest.789912B7C2CACFE1.quest_desc: [
		"检查核聚变 反应堆 在一个控制运行间隔期间。"
		"观察供应和输出系统,而不是仅仅从声音判断稳定性。"
	]
	quest.789912B7C2CACFE1.quest_subtitle: "稳定封装是静态的工作:野外电能,燃料流,等离子体输出都保持在计划范围内."
	quest.789912B7C2CACFE1.title: "抓住等离子体封装"
	quest.78B03D44BEC85E33.quest_desc: [
		"之后 阶段 6 开处、位置和位置 检查 a 数据为: MI 组装员."
		"选择一个经常性组件,在添加更多食谱之前,将其输入、输出和溢出自动化。"
	]
	quest.78B03D44BEC85E33.quest_subtitle: "装配器工作电池只有在每种成分都达到正确数量时,才能使重复的组件具有可预测性。"
	quest.78B03D44BEC85E33.title: "自动调试工作细胞"
	quest.78D02B4658DC4839.quest_desc: [
		"阶段两座大型氧气罐,两座火箭炮推进器,以及两座用于持续进行晚空作业的大型燃料箱升级."
		"这个储备将太空赛车与宇宙航空公司开辟的成熟的舰队生产路线联系起来."
	]
	quest.78D02B4658DC4839.quest_subtitle: "氧气,推进器,以及两辆机队坦克升级支援持续的后空作战."
	quest.78D02B4658DC4839.title: "三击预备队"
	quest.78D66599CD3A14E1.quest_desc: [
		"完成 MI 电爆-电爆-电爆-电爆推进,通过建造目前的多块控制器。"
		"先完成LV电网,然后在尝试热食前保留功率和输入缓冲."
	]
	quest.78D66599CD3A14E1.quest_subtitle: "第一个电炉使受控高热量成为电网必须承载的另一个负荷。"
	quest.78D66599CD3A14E1.title: "集聚电爆毛斯"
	quest.78FAADC20C3595A1.quest_desc: [
		"股票三十二 电力电网 线和8个连接器。"
		"不得重复使用热损断层;关闭电路前纠正负载或防护."
	]
	quest.78FAADC20C3595A1.quest_subtitle: "线轴与连接器可在隔离端子之间更换失效的 EE 或 Electro Energetics 支路。"
	quest.78FAADC20C3595A1.title: "烧焦的电线股票"
	quest.79074CED9461BDA5.quest_desc: ["用机械工业区驱动由转子、定子和电刷组成的 EE 发电机。组装 EE 转换器，为首批 MI 机器供电。"]
	quest.79074CED9461BDA5.quest_subtitle: "发电机房和涡轮机可以确定蒸汽终点、电力开始和维护的终点。"
	quest.79074CED9461BDA5.title: "推出的一代和服务"
	quest.7912D59F16DCF8A6.quest_desc: [
		"在准备的扫荡中击败一名斯特拉里斯·莫格勒"
		"轻轻标记隧道,避免在唯一的出口旁战斗,并有生命的后备人员返回."
	]
	quest.7912D59F16DCF8A6.quest_subtitle: "封闭地面上的一只马鹿 使隧道的能见度 和后退空间成为了遭遇的一部分。"
	quest.7912D59F16DCF8A6.title: "莫格勒隧道扫荡"
	quest.7955D4D0EE64FB75.quest_desc: [
		"安装和 检查 a 电力电网 操作分支上的设备连接器。"
		"保持连接,以隔离和 验证 附加的负载不超过分支的生成或存储。"
	]
	quest.7955D4D0EE64FB75.quest_subtitle: "一个设备连接器使从可见网格到一台机器的交接方式具有故意性和可用性."
	quest.7955D4D0EE64FB75.title: "安全连接 MV 设备"
	quest.797E0732927C018D.quest_desc: [
		"4个寻找眼睛的股票 16个中子堆"
		"眼睛用前哨装备和中子堆放在受控工业储存中."
	]
	quest.797E0732927C018D.quest_subtitle: "4个寻找眼睛和16个中子堆 使另一次探险和压缩可以独立地进行。"
	quest.797E0732927C018D.title: "准备第二层的移动"
	quest.7985F331A44D4756.quest_desc: [
		"制作 4 份 MI 电流的马达和16条铜线 工厂 供应。"
		"之后再填充铜圈、绳索、磁棒和润滑剂,以便重建不会空出下一个维修工作。"
	]
	quest.7985F331A44D4756.quest_subtitle: "新鲜的电线和电动机证明电器店仍然可以回到钢铁,铜和橡胶."
	quest.7985F331A44D4756.title: "重建来自原料的汽车"
	quest.79A93E92FC1E235D.quest_desc: [
		"地点和地点 检查 a 数据为: AE2 文者为文者."
		"安装正确的压车,一次提供一条处理器线,并保持打印部件的分离."
	]
	quest.79A93E92FC1E235D.quest_subtitle: "书写者使加工器的制造可以重复,但其压力和物质秩序仍然重要。"
	quest.79A93E92FC1E235D.title: "工作流程"
	quest.79C67DEEDE3F85A5.quest_desc: [
		"准备Terra FirmaCraft大麦种子。"
		"储存干燥,并与用于磨炼或动物饲料的谷物分开。"
	]
	quest.79C67DEEDE3F85A5.quest_subtitle: "保护种子储备保留下一个 工厂设施离开目前的粮食供应。"
	quest.79C67DEEDE3F85A5.title: "种子银行编目"
	quest.79D36DEED49BD9EB.quest_desc: [
		"单 AE2 专用扩展缓冲器中的工程处理器."
		"保留它用于控制器,CPU,或存储工作,并重新填充写器输入."
	]
	quest.79D36DEED49BD9EB.quest_subtitle: "专用处理器缓冲器证明扩展存储具有可控目的地而不是物品投放快捷键."
	quest.79D36DEED49BD9EB.title: "抓住工程处理器扩展缓冲器"
	quest.7A0AD8FE949D3755.quest_desc: [
		"完成Mekanism的注射室推进,"
		"通过标签化的高级管连接其气体输入,并提供清洁的固体输出."
	]
	quest.7A0AD8FE949D3755.quest_subtitle: "注射室推进标志压力化学变得足以控制更高顺序的处理."
	quest.7A0AD8FE949D3755.title: "注射室封印"
	quest.7A1D7230AA352583.quest_desc: [
		"建造并保留两艘货船摩托艇."
		"指定不同的航线或货物角色,因此第二艘船增加能力而不是混淆。"
	]
	quest.7A1D7230AA352583.quest_subtitle: "两艘机动艇允许一条航线在另一条航线卸货或进行时继续行驶 修复."
	quest.7A1D7230AA352583.title: "开设第二河服务"
	quest.7A2480E01B9BFE31.quest_desc: [
		"生产和储存 16 AE2 圆盘石英粉."
		"活的书写器路线接受certus晶体;保持晶体和粉尘清单的分离,这样自动化就尊重两种用途."
	]
	quest.7A2480E01B9BFE31.quest_subtitle: "16个灰尘支持玻璃,纤维,和处理器工作,而不磨碎所见的每一个晶体."
	quest.7A2480E01B9BFE31.title: "装入 Certus 底尘拖拉机"
	quest.7A3B40776103D3CF.quest_desc: [
		"形状和点燃陶瓷罐 然后再做更长时间的勘测"
		"在离开营地之前填满; TFC 当水是事后思考时,旅行会很快变得危险。"
	]
	quest.7A3B40776103D3CF.quest_subtitle: "燃烧的罐子会把安全路线都从淡水中延伸开来"
	quest.7A3B40776103D3CF.title: "将水运出营地"
	quest.7A3FDD3915DE5AEB.quest_desc: [
		"盖撒克床和撒克"
		"用刀将吸管收集起来,做大黄,然后把床放在一个小的防天气掩蔽处."
	]
	quest.7A3FDD3915DE5AEB.quest_subtitle: "干干大干和床 把第一个屋顶变成值得回的地方"
	quest.7A3FDD3915DE5AEB.title: "撒克床和第一收容所"
	quest.7A4B49F04CAE7CC8.quest_desc: [
		"制作 4 份 Infinity 零星和四个晶体矩阵从当前输入中插入."
		"审计整个路线向后,纠正任何不能取代其贡献的机关."
	]
	quest.7A4B49F04CAE7CC8.quest_subtitle: "第一次证明后制造的四块金币和四块基质的硬币 显示线路始于工厂,而不是旧的库存。"
	quest.7A4B49F04CAE7CC8.title: "从输入重建聚合"
	quest.7A6302A7F53E277E.quest_desc: [
		"储存8个涡轮机叶片和4个卸载的裂变燃料组件."
		"将其存放在单独的控制区和文件中, 反应堆 和涡轮设计 每批都合适。"
	]
	quest.7A6302A7F53E277E.quest_subtitle: "8个涡轮叶片和4个燃料组件使动力转换和燃料几何共同负责."
	quest.7A6302A7F53E277E.title: "级涡轮刀和燃料组件"
	quest.7A9C813B740B6FE9.quest_desc: [
		"获得一个 TFC 香蕉树苗从果树世界路线上传来"
		"检查完后才植入 TFC 并保留替代物 然后再扩大果园"
	]
	quest.7A9C813B740B6FE9.quest_subtitle: "A TFC 香蕉树苗是一种长期粮食承诺,其气候和布局在收获之前就很重要。"
	quest.7A9C813B740B6FE9.title: "果园保护区"
	quest.7AAF529D77079CEB.quest_desc: [
		"触发 AE2 提供分支之后的 CPU 工艺升级 。"
		"运行一个真正的手艺和 检查 共同处理、存储和取消行为。"
	]
	quest.7AAF529D77079CEB.quest_subtitle: "编译-CPU的推进证明网络可以在提供者和频道已经运行后安排工作."
	quest.7AAF529D77079CEB.title: "正在制作 CPU 宝座"
	quest.7AD7B8724B36B4C1.quest_desc: [
		"触发器 Re: Avaritia 的 Infinity 活体飞船的催化性进步"
		"仅仅审查进展的触发因素;一揽子配方仍然是真相的机械来源。"
	]
	quest.7AD7B8724B36B4C1.quest_subtitle: "催化剂的进步记录显示,每一种历史成分都在其合法权威下达到了最后的一席之地。"
	quest.7AD7B8724B36B4C1.title: "灰烬的催化剂"
	quest.7AD8280CC0E8D33A.quest_desc: ["27 重工业焦炭的铁路运输工具 工业联合体.","使用 Railcraft 焦炉生产杂酚油和铁路燃料。独立的 TFMG 铸铁焦炉生产 TFMG 焦炭和工艺气体；收集工艺气体并保持其出口畅通。"]
	quest.7AD8280CC0E8D33A.quest_subtitle: "整块砖块就证明是重油 工业区 可以在不删除的情况下构建 MI 焦炭烤炉。"
	quest.7AD8280CC0E8D33A.title: "举起可乐奥文"
	quest.7B15A7C2E9406D3F.quest_desc: [
		"抵达木星，并用 Vacuumator、四级流体储罐与火箭站投运一座当地大气站。"
	]
	quest.7B15A7C2E9406D3F.quest_subtitle: "使当地大气采伐成为可能的真正基础设施证明了乔维安的进步。"
	quest.7B15A7C2E9406D3F.title: "带着艾利克斯号返回:木星"
	quest.7B209BE21F7C1CC3.quest_desc: [
		"库存4个基本化学罐和16个HDPE床单。"
		"留下至少一个罐体干净且没有分配,因此关闭工作绝不取决于倾倒有价值的气体。"
	]
	quest.7B209BE21F7C1CC3.quest_subtitle: "4个罐和16个床单为不止一个中断的工艺提供转移空间和材料。"
	quest.7B209BE21F7C1CC3.title: "三相屏蔽阶段"
	quest.7B3474DF11467444.quest_desc: [
		"通过正常的HDPE饲料链生产8个梅卡尼主义底物."
		"替换所消耗的每一个气体和固体输入,以便下一批工作可以开始而不进行扫荡。"
	]
	quest.7B3474DF11467444.quest_subtitle: "八个再次制造的底物显示出生物饲料,氢,反应室可以维持聚合物的工作."
	quest.7B3474DF11467444.title: "重复底线"
	quest.7B8719374610E88F.quest_desc: [
		"4号火箭鳍和8枚原始底片"
		"将飞行部件与行星货物分开,并保存属于下一辆汽车的批次文件。"
	]
	quest.7B8719374610E88F.quest_subtitle: "完整的鳍 旁边的原始的dush记录 留下地球和成功返回。"
	quest.7B8719374610E88F.title: "芬格大会拉克"
	quest.7B95BBC96811B34A.quest_desc: [
		"检查 a MI 真正的铜制迷宫器"
		"种子边框输入和 验证 当蒸汽或输出能力消失时,它就会完全停止。"
	]
	quest.7B95BBC96811B34A.quest_subtitle: "青铜灰泥炉是一种有用的无人处理的测试,因为它的微弱速率使得每个被阻断的输出都可见."
	quest.7B95BBC96811B34A.title: "保持青铜线运行"
	quest.7BA0ECF99B0119B7.quest_desc: ["Build and place the base Loot Fabricator after proving the Simulation Chamber.","Keep prediction input and output storage separated so the later industrial fabricators inherit a traceable material route.","Optional Digital simulation under COM-04. Hostile models and drops do not prove factory control or replace first-resource acquisition."]
	quest.7BA0ECF99B0119B7.quest_subtitle: "只有当造谣者能够将其转化为可回收的材料输出时,预测才有用。"
	quest.7BA0ECF99B0119B7.title: "证明基地洗涤器"
	quest.7BDD03AD021299B3.quest_desc: [
		"到达斯特拉里斯金星沙漠生物群落"
		"标出登陆和避难路线,监视生存设备,在独立返回预备队被触碰之前返回."
	]
	quest.7BDD03AD021299B3.quest_subtitle: "金星沙漠热量 将住所外的每一个延迟 都变成了生命维持费"
	quest.7BDD03AD021299B3.title: "维纳斯沙漠热量索赔"
	quest.7BF799817E0F29EA.quest_desc: [
		"完成 TFC 页面在斜处的推进。"
		"观察温度和攻击命令;一个正确的计划完成了太冷,仍然浪费时间和燃料。"
	]
	quest.7BF799817E0F29EA.quest_subtitle: "工作表证明,反复的锤子计划可以产生一致的结构存量。"
	quest.7BF799817E0F29EA.title: "证明工作表"
	quest.7BF834462C225706.quest_desc: [
		"建造和储存两台斯特拉里斯火箭发动机."
		"将它们留在发射场,并配备再次替换它们所需的风扇、发动机、泵、装置、板和电池输入。"
	]
	quest.7BF834462C225706.quest_subtitle: "两个备用引擎将一个从死胡同的终止变成一个 修复 和已知的期限。"
	quest.7BF834462C225706.title: "库存备用火箭发动机"
	quest.7C1CEA2091E54BD7.quest_desc: ["Complete a TFMG steel mechanism through the live three-loop Create sequence.","Each loop uses a steel casing, 250 mB lubricant, nickel plate, lead plate, and pressing on a heavy-plate base.","Mechanical commissioning: finish this sequence with a Steel Greate Press or higher. Build the press with the existing precision-mechanism line first; its construction does not consume the steel mechanism it will produce. Use the existing assembler batch when recurring demand grows."]
	quest.7C1CEA2091E54BD7.quest_subtitle: "钢机机制为重工业凝聚成一个精准的润滑组装."
	quest.7C1CEA2091E54BD7.title: "机制重建法官"
	quest.7C45D11F8641A5FC.quest_desc: [
		"极端工业之后的中子压缩机可重复检查."
		"从收集器中获取,防止输出僵局,并将压缩物质导向受控的制造."
	]
	quest.7C45D11F8641A5FC.quest_subtitle: "The planetary megaforge replaces isolated forming lines with continuous neutron feed, restricted storage, and shared heavy services."
	quest.7C45D11F8641A5FC.title: "行星巨堡"
	quest.7C6331DB01CBB2D3.quest_desc: [
		"完成 MI 使用已安装的食谱,"
		"只有在发电和电缆容量能够支持较高吞吐量的情况下,才应用升级."
	]
	quest.7C6331DB01CBB2D3.quest_subtitle: "高级升级记录了LV机械在MV工作中取得一条刻意走过的路."
	quest.7C6331DB01CBB2D3.title: "高级升级 字节"
	quest.7C9745FD73DD79C9.quest_desc: [
		"寻八小锡石."
		"将锡石索赔置于松散矿石、主岩和探矿者读物同意的地方。"
	]
	quest.7C9745FD73DD79C9.quest_subtitle: "八个锡石样本足以标出值得跟踪的地铁索赔."
	quest.7C9745FD73DD79C9.title: "锡石索赔标记"
	quest.7CA73CADB9E37FAF.quest_desc: [
		"第八阶段涡轮外壳和 检查 化学洗涤器。"
		"模拟主要动力丧失 反应堆 关了 验证 备用控制、冷却剂、废物隔离、以及 重新启动 秩序。 秩序。"
	]
	quest.7CA73CADB9E37FAF.quest_subtitle: "涡轮壳存量和一台工作洗衣机在一代人停止后保存除热和化学."
	quest.7CA73CADB9E37FAF.title: "练习衰竭热关闭"
	quest.7CD717F767630AA3.quest_desc: [
		"构建一个 MI 钢管通道打开后电爆炉。"
		"将其放置在散装饲料,热输出,冷却,板块或壳体生产可以在其周围扩张的地方."
	]
	quest.7CD717F767630AA3.quest_subtitle: "电爆炉可以证明钢铁是正当的 工业联合体 当热,气体,矿石,冷却,和形成线可以规模共享时."
	quest.7CD717F767630AA3.title: "钢铁工程"
	quest.7CFD90C02A07659F.quest_desc: [
		"建造另一台LV蒸汽轮机,保留16台 MI 铜丝网."
		"阶段涡轮冷却,然后在蒸汽供应,存储和保护后才能连接到它,可以接受另一个发电机."
	]
	quest.7CFD90C02A07659F.quest_subtitle: "备用涡轮机和电线库存使发电可以扩展,而无需跳闸拨打直播网."
	quest.7CFD90C02A07659F.title: "预备一台低压备用涡轮"
	quest.7D1FF5291D063836.quest_desc: [
		"在铸造层放置一个创建盆地,并保持一个安地壳准备供下一个机器使用."
		"离开通道 带或仓库,热量 下盆地, 和足够的井清除服务驱动器。"
	]
	quest.7D1FF5291D063836.quest_subtitle: "水盆、外壳和清晰的工作通道 使铸造厂成为 工厂设施 而不是一堆块"
	quest.7D1FF5291D063836.title: "铺设铸币楼"
	quest.7D41C26DE2441DEB.quest_desc: [
		"生产十六甲乙烷的内酯和四枚中子的内酯."
		"在转移批次前,先补充种子的星体和中子压缩线."
	]
	quest.7D41C26DE2441DEB.quest_subtitle: "16个乙烷和4个中子内基组 做了一个量子饲料批量而不需要任意的仓库"
	quest.7D41C26DE2441DEB.title: "爱森特 内裤盒"
	quest.7D4379577F1739C0.quest_desc: [
		"地点和地点 检查 a 数据为: AE2 能量接受器在 重新启动."
		"提炼出地方力量 验证 存储访问,然后允许一次手动工作细胞一个分支."
	]
	quest.7D4379577F1739C0.quest_subtitle: "能量接受器是正确的回收点:在要求存储或编程回答之前恢复电源."
	quest.7D4379577F1739C0.title: "冷重启网络电源"
	quest.7D43C155A4A1452F.quest_desc: [
		"建造和储存两台火箭炮火箭推进器."
		"将配对的配对与预定的工艺密封起来,并保留 i,钛,电子,以及泵补给记录附近."
	]
	quest.7D43C155A4A1452F.quest_subtitle: "一种配方生产了用于控制推进器更换的两台火箭推进器。"
	quest.7D43C155A4A1452F.title: "曲轴平面"
	quest.7D56E7A156627990.quest_desc: [
		"检查位置 AE2 控制器和16级风扇玻璃电缆"
		"允许实际进入驱动器和散装货店,并保持进出口、终端和工艺分店的可区分性。"
	]
	quest.7D56E7A156627990.quest_subtitle: "可见的控制器和电缆储备使频道,电力,存储,服务路线成为楼层计划的一部分."
	quest.7D56E7A156627990.title: "将数字厂铺设出来"
	quest.7D6499EC8771BC3C.quest_desc: [
		"地点和地点 检查 a 电力电网 LV开关。"
		"开始于下游负载打开,加载控制和存储,然后一次关闭一根树枝."
	]
	quest.7D6499EC8771BC3C.quest_subtitle: "LV开关保持回收序列的可见性:控制器先,只有在测量一致后才能加载."
	quest.7D6499EC8771BC3C.title: "证明冷启动断开"
	quest.7D75C2FB9EEC9670.quest_desc: [
		"生产木炭96."
		"在铜矿开采前完成木炭燃烧,因此第一次热量需求不能消耗营地燃料。"
	]
	quest.7D75C2FB9EEC9670.quest_subtitle: "96木炭使得铜牌进行着计划的行动,而不是希望的射击."
	quest.7D75C2FB9EEC9670.title: "铜跑的木炭"
	quest.7D912C3360ECA295.quest_desc: [
		"建立田水纪律后,准备羊毛胸板和皮革瓶."
		"练习返回、变暖、水分和更换旧工具箱而不依赖 辐射 药"
	]
	quest.7D912C3360ECA295.quest_subtitle: "暖衣服和装满的野外瓶子是任何人再次离开避难所之前的第一批检查."
	quest.7D912C3360ECA295.title: "运行曝光 恢复 钻井"
	quest.7DAC27C37229DEBD.quest_desc: [
		"地点和地点 检查 核裂变 反应堆 控制器 控制器"
		"其十六号作业安全包装线将港口,燃料和铁道整合.辐射 子系统、处理器、仪表、关闭硬件、冷却、监督控制、电网隔离、润滑剂和结构关闭。"
		"这是校长 反应堆 控制器:冷却几何、 调节器、 ir 辐射涡轮机、乏燃料和 后处理 仍由核灾难负责。"
	]
	quest.7DAC27C37229DEBD.quest_subtitle: "核裂变主要事件 反应堆 只有在监测、进入、燃料保管和蓄意关闭之后才能开始。"
	quest.7DAC27C37229DEBD.title: "初级核电磁控制器"
	quest.7DB406C7E801DB1C.quest_desc: [
		"再来一个热铜批,然后 检查 装设时的铸币盖仍然组装"
		"铜和锡在三比一的比例中保持缓冲,因此重复铸造不依赖于剩余投入."
	]
	quest.7DB406C7E801DB1C.quest_subtitle: "第二批青铜器证明铸币局盖子第一次成功幸存下来."
	quest.7DB406C7E801DB1C.title: "运行第二铜牌"
	quest.7DF2BB3DFF551E6D.quest_desc: [
		"在实际货运或勘察期间乘船旅行10万厘米."
		"使用标记的码头,并携带足够的补给供返回的腿."
	]
	quest.7DF2BB3DFF551E6D.quest_subtitle: "船行一公里的航线证明水道有有用的长度,着陆,还有一条航线回家."
	quest.7DF2BB3DFF551E6D.title: "河运记录"
	quest.7E25D2E8B8104F74.quest_desc: [
		"检查核聚变 反应堆 并显示一亿 FE 储备金。"
		"断开主生成, 验证 集中控制仍然可用,然后恢复系统而不花费受保护的投入。"
	]
	quest.7E25D2E8B8104F74.quest_subtitle: "即便在 Infinity 安全恢复始于 检查编 反应堆 以及能承受损失的力量"
	quest.7E25D2E8B8104F74.title: "运行聚合断电钻"
	quest.7E2C0F5826A32CFB.quest_desc: [
		"展示2.5亿 FE 保护的存储。"
		"开放初级发电,恢复控制和后勤,并停止重型程序直至 检查编著."
	]
	quest.7E2C0F5826A32CFB.quest_subtitle: "储存2.5亿 FE 测试一个文明尺度的场地能否恢复其控制,而无需主控制 工厂设施."
	quest.7E2C0F5826A32CFB.title: "运行工程断电滴入"
	quest.7E2F37A4005BB466.quest_desc: ["Commission the steel distillation controller to prove coke, refractory work, extraction, crude separation, rubber, and contained storage support one heavy-industry district.","Coke, refractory, petroleum, rubber and lubrication become permanent industrial feedstocks."]
	quest.7E2F37A4005BB466.quest_subtitle: "CANONICAL AGE 4 PROOF — Heavy Industry"
	quest.7E2F37A4005BB466.title: "重工业区"
	quest.7E7FC246088E63B9.quest_desc: [
		"生产和储存 8 MI 钛大板."
		"保持保险库的物理和限制,因此小型自动化工艺品不能消耗结构库存。"
	]
	quest.7E7FC246088E63B9.quest_subtitle: "八块大板让金库有足够的结构钛 来做一个严重的船体或封存工作。"
	quest.7E7FC246088E63B9.title: "装填大板块"
	quest.7E815FA4400E10A9.quest_desc: [
		"建造阿斯蒂科·卡特斯橡树种子钻."
		"以种子充充,在熟的土壤上试验间隔,并留下一道。 工厂设施电击机的股票"
	]
	quest.7E815FA4400E10A9.quest_subtitle: "种子钻头可以使物流在排队中可见 工厂设施由运来的货车的补给品中提取。"
	quest.7E815FA4400E10A9.title: "绘制种子钻探"
	quest.7E836FD1DBA61467.quest_desc: [
		"构建一个 MI 铜器弹壳作为第一种尺度参考."
		"治疗晚期的工业 工业区 以发行机的形式 反应堆 s,坦克,控制,后勤,危险,维修路线,回收系统必须一起运行,即使没有单一的控制器代表整个场地."
	]
	quest.7E836FD1DBA61467.quest_subtitle: "A 工业区 机器的输入、危险、维护 和工人都不再适合一个控制器"
	quest.7E836FD1DBA61467.title: "将工业区读作机器"
	quest.7E8EA9CA3047460C.quest_desc: [
		"进入维度后,构建或回收一种永恒的星光晶体原生催化剂."
		"与源代码一起储存,并远离不受限制的矩阵和神秘的工艺."
	]
	quest.7E8EA9CA3047460C.quest_subtitle: "控制储存中的催化剂通过证据而不是无关的战斗来证明星状封存."
	quest.7E8EA9CA3047460C.title: "隔离水晶生催化剂"
	quest.7EB453C5398D7457.quest_desc: [
		"准备第二次涡轮转动,不消耗紧急库存:外壳、防护连接器、两个转盘、四个电磁圈和两个冷凝器。"
		"这些是成熟的生产批次;第一批本地涡轮机部件必须已经作为保留种子存在。"
	]
	quest.7EB453C5398D7457.quest_subtitle: "Ca,保护动力,转盘,圈,和凝固器使蒸汽转换完成第二班."
	quest.7EB453C5398D7457.title: "准备第二班核电涡轮"
	quest.7EC1123AD1DDC707.quest_desc: [
		"建立补充通知板。"
		"将其放置在转移点,并记录改变货运方式的信息。"
	]
	quest.7EC1123AD1DDC707.quest_subtitle: "通知板使所有使用货场的人都能看到路线关闭、目的地改变和货物优先。"
	quest.7EC1123AD1DDC707.title: "货运通知委员会"
	quest.7EE6C0C35E1F23C2.quest_desc: [
		"带八块生胶来工业联合体 橡胶和机械压八橡胶工业联合体 床单从它。"
		"保留为整批供应的砂浆,树脂线,旋转压缩机,机械压机."
	]
	quest.7EE6C0C35E1F23C2.quest_subtitle: "橡胶原和成品板一起证明,瓦特路线在炼油厂产出之前就已开始。"
	quest.7EE6C0C35E1F23C2.title: "新鲜原料的橡胶"
	quest.7F2FF8EB08226E28.quest_desc: [
		"之后 阶段 15开, 检查 a 数据为: MI 聚变 反应堆."
		"追踪受保护的控制电源,主输出,隔离,和黑启动供应,然后连接星系源."
	]
	quest.7F2FF8EB08226E28.quest_subtitle: "融合与每个较小的源都属于同一个网格图,即使其规模改变绘图."
	quest.7F2FF8EB08226E28.title: "组合和 Starr 预览"
	quest.7F52D305917DC979.quest_desc: [
		"建造两台核辐射剂量仪。"
		"向每个积极角色发出一个,录制录制录制前的读取,并定义结束工作的级别."
	]
	quest.7F52D305917DC979.quest_subtitle: "两种剂量表让接触跟随工作的人,而不是消失在共用的办公仪器中。"
	quest.7F52D305917DC979.title: "发布 Shift 剂量表"
	quest.7F5CB4893E467C64.quest_desc: [
		"地点和地点 检查 装有燃料储存区的铸铁液箱。"
		"提供关闭通道和畅通通道;罐体应在炼油厂其余部分闲置时拆除。"
	]
	quest.7F5CB4893E467C64.quest_subtitle: "消防安全始于一个可以 隔离 d 不包括整个 工业区."
	quest.7F5CB4893E467C64.title: "包含燃料缓冲"
	quest.7F61706E10A2E45C.quest_desc: [
		"保持橡木手推车和货船能力升级准备."
		"先建立手动绕道,然后恢复装填器,时刻表,以及阶段性自动路由."
	]
	quest.7F61706E10A2E45C.quest_subtitle: "在恢复所有自动化连接之前,手推车和备用船的能力将紧急货物运走。"
	quest.7F61706E10A2E45C.title: "手动重新开始货运"
	quest.7F823C3B731BF62E.quest_desc: ["Milestone 5: maintain genetic records and reference colonies. The gene indexer and bee extractor require a royal jelly bottle from the Bumblezone.","Acquire that native input through the bee-dimension branch, then connect breeding records to the existing digital apiary. Resource bees amplify acquired material; they do not replace its first geological or planetary discovery."]
	quest.7F823C3B731BF62E.quest_subtitle: "基因索引器使繁殖记录可以操作,而不会将每只蜜蜂变成可互换的资料来源."
	quest.7F823C3B731BF62E.title: "阿皮亚里记录办公室"
	quest.7F89E1DA13F9EC0A.quest_desc: [
		"饲料三十二超导电缆进入种子四焦低温风切变运行."
		"原单油菜谱仍然是靴子式路线;这批改进了量子功率的自动化和吞吐量."
	]
	quest.7F89E1DA13F9EC0A.quest_subtitle: "32条电缆和保留的第一圈线证明低温风切变在服务尺度上."
	quest.7F89E1DA13F9EC0A.title: "风吹四油锅"
	quest.7F95E7B9F7FEFB4D.quest_desc: ["Build a quantum machine hull from replaceable high-tier components to prove matter, power, distance, transit, and stellar construction are controlled systems.","Greate tungsten-steel and LuV precision mechanics supply the same late factory. Stargate reconstruction unlocks instant item/fluid logistics only after the rocket, freight, fusion and dimensional-research program."]
	quest.7F95E7B9F7FEFB4D.quest_subtitle: "CANONICAL AGE 15 PROOF — Quantum and Reality Engineering"
	quest.7F95E7B9F7FEFB4D.title: "量子系统"
	quest.7FCDACD26EAA3C0A.quest_desc: ["Build the mechanical servo through AIR-01 after railway engineering, using precision mechanisms, sequenced gearshifts and the steel-mechanism line.","This actuator is manual hardware. Digital metrology, gyroscopes and stabilized flight remain later capabilities."]
	quest.7FCDACD26EAA3C0A.quest_subtitle: "机械伺服器让飞行员指挥车辆,而不会假装它能够稳定自己."
	quest.7FCDACD26EAA3C0A.title: "Manual Flight Control"
	quest.7FE0327AF90FC126.quest_desc: [
		"库存8个碘药丸和16个核克拉夫特铀粉尘。"
		"将控制区内的药品和铀保存在限制燃料储存中,并有仪表和清晰的标志。"
	]
	quest.7FE0327AF90FC126.quest_subtitle: "碘药和铀饲料从不属于同一个没有标签的储存,即使图将其放在附近."
	quest.7FE0327AF90FC126.title: "紧急药丸内阁"
	quest.7FF1A0692E296D4F.quest_desc: ["Refine Soulstone and build a Spirit Altar.","Collect spirits and complete a native Spirit Infusion while preserving the altar as permanent research infrastructure.","Optional during normal age progression. Esoteric evidence becomes required only at final Reality Engineering through ESO-04 to FRN-06."]
	quest.7FF1A0692E296D4F.quest_subtitle: "可重复的实验比一次性机器更有价值."
	quest.7FF1A0692E296D4F.title: "Spirit Infusion"
	quest.36B517428853015E.quest_desc: ["Stabilization uses the mature mechatronics and sensor suppliers of Deep Space. Keep manual control and override available before automated routing."]
	quest.36B517428853015E.quest_subtitle: "传感器、数字控制器和步进式动能分离出一个稳定 航空器 手动平衡实验"
	quest.36B517428853015E.title: "稳定飞行控制"
	quest.70EA2DE834941114.quest_desc: [
		"建造自动航空站和船舶转发器 AE2 要求的生产, CC:Tweaked 监管,现代动态 路线, GregTech 传感器和铁路工具 货运站 已经投入使用。"
		"进行真正的出发,目的地,返程,阻断目的地,以及人工回收测试后再信任无人看管的货物."
	]
	quest.70EA2DE834941114.quest_subtitle: "自主飞行是数字物流服务层,以维护的铁路航空货运网络为顶部."
	quest.70EA2DE834941114.title: "自主航空后勤"
	quest.54F5FF606687D81F.quest_desc: [
		"原生的Pyrolyse Oven是可选的晚期散装碳化机构. TFC 仍然拥有第一台木炭,而Railcraft仍然拥有第一台煤焦炭和杂酚油;这个设施只分批地运出他们已经确定的路线."
		"控制器, 10 ULV 机器 Casings, 16 Kanthal Coils, IV 能量, 项输入/输出, 流体输入/输出, 维护, 以及 IV Muffler Hatch。 请使用本地多块预览来进行定向 。"
		"与16批煤炭一起委托:16份可乐和8 000mB的铁路运输机,价格为1 024 EU/t. 本地的火炬图否则会禁用."
	]
	quest.54F5FF606687D81F.quest_subtitle: "晚期的焦炭和杂酚油批量,但不更换木炭场或铁路工艺。"
	quest.54F5FF606687D81F.title: "火烧奥芬"
	quest.4A3EB104C7D9DD45.quest_desc: [
		"本地的裂缝是可选的炼油厂扩建设施。 MI 仍然拥有第一种石油,氢气,伊普赫塔,燃料,和聚合物;格雷格只测定一个既定的重分量."
		"控制器、 十九个清洁机器 Casings 、 十六个 Kanthal Coils 、 IV 能量、 物品输入、 流体输入/ 输出、 维护、 IV Muffler Hatch 。 它的本地食谱图没有项目输出能力, 因此输出总线既不需要也不有效 。"
		"委托撰写 1,024-EU/t 路线上含有4000mB重油和2000mB氢。它只返回2000mB 纳普赫塔加1000mB液态沥青,所以它不能关闭正燃料环路。"
	]
	quest.4A3EB104C7D9DD45.quest_subtitle: "石油文明已经存在之后,氢辅助分数升级。"
	quest.4A3EB104C7D9DD45.title: "开裂器"
	quest.6FF097761CD92588.quest_desc: [
		"本土大型化学反应堆是继大型制造厂后可选的多投入机构. MI 仍然拥有第一个PGM浓度和下游离心机分离;Mekanism保持气体网络权威."
		"控制器,十八惰性机器 Casings, 一个PTFE管道 Casing, 一个Kanthal Coil, 毗邻那个管道, IV 能量, 物品输入/输出, 流体输入/输出, 和维护。 这个模式不接受搅拌器 。"
		"委托撰写 2,048-EU/t 将aqua-regia批量生产四个已经建立的混合Iridium Ingots。所有其他本地大型化学反应堆配方均被禁用。"
	]
	quest.6FF097761CD92588.quest_subtitle: "校园规模的复杂PGM饲料准备, MI 保留离职权。"
	quest.6FF097761CD92588.title: "大型化学反应堆"
	quest.6C41191086C4A980.quest_desc: [
		"合金爆裂冶炼厂是大型制造厂之后的可选高温汇合大厅,既有的星门食谱仍为第一通道,可进入Naquadah合金;该设施只进行精确的八项专家批次."
		"控制器阶段,35个高温熔炼炉、24个康塔尔炉、12个热温特、IV个能量、物品和液体输入、物品输出、维护以及IV个Muffler Hatch。"
		"委托撰写 4,096-EU/t,2700K路线,每条八钛,铂,乙苯,和精制纳夸达,然后保留所有八纳夸达合金作为证据."
	]
	quest.6C41191086C4A980.quest_subtitle: "极星门-合金批量,没有平行的早期熔化梯子."
	quest.6C41191086C4A980.title: "联合爆破冶炼厂"
	quest.27E7327545A3AA37.quest_desc: ["加工用来安全地将炉子排气管移到上方的紧凑砖烟囱 工业联合体跳起来。"]
	quest.27E7327545A3AA37.quest_subtitle: "给青铜时代 工业联合体跳出一条安全草稿路径。"
	quest.27E7327545A3AA37.title: "小砖烟囱"
	quest.28B110DC18EA3D8C.quest_desc: ["构建木制Colossal Chest控制器,接口,以及墙壁块作为可扩展存储系统."]
	quest.28B110DC18EA3D8C.quest_subtitle: "将早期物流转为室规模的库存."
	quest.28B110DC18EA3D8C.title: "花木库"
	quest.2B955B633D13ECC9.quest_desc: ["给金属烟囱泵供电 与电网一起通过较长的工业排气管 来转移排放"]
	quest.2B955B633D13ECC9.quest_subtitle: "工业通风属于电力预算."
	quest.2B955B633D13ECC9.title: "金属烟囱泵"
	quest.154F82F34DD72648.quest_desc: ["利用矿物发现者将勘测的地质学转变为有意的高级电力勘探。"]
	quest.154F82F34DD72648.quest_subtitle: "布雷前先看地势"
	quest.154F82F34DD72648.title: "矿物查找器"
	quest.1BE68BA11E58B77A.quest_desc: ["Stabilization uses the mature mechatronics and sensor suppliers of Deep Space. Keep manual control and override available before automated routing."]
	quest.1BE68BA11E58B77A.quest_subtitle: "稳定飞行从量度运动开始."
	quest.1BE68BA11E58B77A.title: "陀螺仪和步进器Servo"
	quest.190CE1149DE78F57.quest_desc: ["可以确定、引导和回收航空车辆,委托一个航空站和转发器。"]
	quest.190CE1149DE78F57.quest_subtitle: "给每艘船一个家和身份"
	quest.190CE1149DE78F57.title: "航空船站和转运站"
	quest.67734FFD6C565083.quest_desc: ["建造金属探测器,以便在不锈和数字资源网络中进行重点勘探。"]
	quest.67734FFD6C565083.quest_subtitle: "跟着校准的信号而不是盲隧道"
	quest.67734FFD6C565083.title: "金属查找器"
	quest.3551397B1C0A7A92.quest_desc: ["将磁枪和生存结构工具作为受控的野外工程设备。"]
	quest.3551397B1C0A7A92.quest_subtitle: "便携式工程不设创意-模式快捷方式."
	quest.3551397B1C0A7A92.title: "磁场工程"
	quest.7A5F2FC5739D08F9.quest_desc: ["将核电离异位管分离器通过其钢质机体的交接器进行集成,并用于开始控制同位素工作."]
	quest.7A5F2FC5739D08F9.quest_subtitle: "分离成品机体内的核原料."
	quest.7A5F2FC5739D08F9.title: "同位素分离线"
	quest.3A5FC21E18B47F33.quest_desc: ["利用宝石发现器在拓扑其提取前对永恒星光矿床进行勘测."]
	quest.3A5FC21E18B47F33.quest_subtitle: "映射星光前沿罕见晶体."
	quest.3A5FC21E18B47F33.title: "星光宝石查找器"
	quest.750BF6A224A124BB.quest_desc: ["光束包和太阳帆包 MI Assembler. 这些本地软件包是最终创建组装的独家工作程序."]
	quest.750BF6A224A124BB.quest_subtitle: "最终机械集成前先进行阶段星体硬件."
	quest.750BF6A224A124BB.title: "Dyson 组件包"
	quest.39E6E46769DBE39D.quest_desc: ["Run beam packages through the Create sequenced line to finish two structural beams.","Finish beams on a Darmstadtium Greate Press or higher. Return monazite to the centrifuge for neodymium, fuse it with tin, and make the first Darmstadtium stock on the Naquadah tools. The existing cleanroom and Assembly Line supply UV crystal mainframes. Keep titanium, iridium, superconductors and the earlier electronics line feeding the beam packages."]
	quest.39E6E46769DBE39D.quest_subtitle: "将包装的帧转换成飞行准备的星座结构."
	quest.39E6E46769DBE39D.title: "戴森结构束"
	quest.55AF35DE3CC8C10D.quest_desc: ["Run a solar-sail package through the Create sequenced line to tension and finish the sail.","Finish sails on a Darmstadtium Greate Press or higher. Retain the quartz-fiber, iridium, superconductor and Starlight lines that supply the laminate. Install the first press over a depot, then use the chemical plant to supply 864 mB PBI per belt connector. Keep a separate restart-power reserve while scaling the stellar array."]
	quest.55AF35DE3CC8C10D.quest_subtitle: "将包裹的薄膜变成可部署的收集器。"
	quest.55AF35DE3CC8C10D.title: "戴森太阳帆"
	quest.40F4C53741584D48.quest_desc: ["通过搭载8个束包和8个太阳能帆包来证明可重复生产。"]
	quest.40F4C53741584D48.quest_subtitle: "巨型建筑需要生产线,而不是原型."
	quest.40F4C53741584D48.title: "戴森套件生产"
	quest.543EE7788A12E303.quest_desc: ["整合完成的戴森硬件,并配有量子链,聚变动力,以及星门工程,以委托电磁轨弹射器."]
	quest.543EE7788A12E303.quest_subtitle: "星门 粒子加速器 AE2 量子,星光,和精密的子组装在分布的星际巨型项目线上汇合."
	quest.543EE7788A12E303.title: "电磁铁路弹射器"
	quest.22EEEC6BB64B443F.quest_desc: ["在推进到最终能量网络之前,与受委托电磁轨弹射器对准一个盾牌发电机."]
	quest.22EEEC6BB64B443F.quest_subtitle: "保护 发射中心 能够支撑巨型结构"
	quest.22EEEC6BB64B443F.title: "盾形星座发射综合体"
	quest.2C6B145C7F06EA11.quest_desc: ["仓库 33 554 432 FE 并生成 AE2 用于证明受保护的量子链接 发射中心 能够维持跨维物流."]
	quest.2C6B145C7F06EA11.quest_subtitle: "将大量存储的电源捆绑到量子网络上."
	quest.2C6B145C7F06EA11.title: "量子物流储备"
	quest.3C708E4E73306D79.quest_desc: ["只有在量子物流储备完成后,才能建造戴森射线接收器."]
	quest.3C708E4E73306D79.quest_subtitle: "接收您的发射网络 所实现的星座输出 。"
	quest.3C708E4E73306D79.title: "戴森雷接收器"
	quest.0710BE372D3EB0CA.quest_desc: ["达到4,194,304 FE 完成的射线接收器链的可用容量,以关闭戴森进化。"]
	quest.0710BE372D3EB0CA.quest_subtitle: "Required discipline mastery — contributes to the canonical age proof."
	quest.0710BE372D3EB0CA.title: "斯特拉格网 终极挑战"
	quest.410B3170D752F441.quest_desc: [
		"制作一个真实的 TFC 分级地质的铜批,保留了成型的金属和回收库存。"
	]
	quest.410B3170D752F441.quest_subtitle: "发现、提取、塑造和恢复开始于体力工作。"
	quest.410B3170D752F441.title: "材料 Epoch I——物理冶金"
	quest.0F16DEDF6E39443D.quest_desc: ["用动力机械与青铜蒸汽车间批量生产十六个青铜锭和十六份普通工业铁粉。","完成工业热力研究后，在 MI 粉碎机中加工已经获得的 TFC 锻铁锭：一个锭产出一份铁粉。继续维持 TFC 冶金、青铜锅炉、供水和燃料。"]
	quest.0F16DEDF6E39443D.quest_subtitle: "创建和蒸汽机械在不抹去早期路线的情况下提高吞吐量."
	quest.0F16DEDF6E39443D.title: "材料 Epoch II——干燥和蒸汽棒"
	quest.0D281B4106EB3A2B.quest_desc: [
		"证明一批可重复的钢材,保留煤焦炭,通过污染运动引导其脏过程."
	]
	quest.0D281B4106EB3A2B.quest_subtitle: "可乐、钢铁、压力和捕获的副产品 工业区 基础设施。"
	quest.0D281B4106EB3A2B.title: "Epoch III-重处理"
	quest.614EAE44EB28E3D1.quest_desc: [
		"加工和保留标准化铝批量,并保留前置线,供 黑启动."
	]
	quest.614EAE44EB28E3D1.quest_subtitle: "电机可以提高自动化,恢复,以及一致性。"
	quest.614EAE44EB28E3D1.title: "Epoch IV-标准电气加工"
	quest.5EC0A201D5233C26.quest_desc: [
		"从现场保留16个不锈钢铜和8个数字电路 时代 10 工厂."
		"钛仍然保留在氯化物、真空和高压运动中 时代 11."
	]
	quest.5EC0A201D5233C26.quest_subtitle: "无法使用的冶金和数字批量 时代 10 工厂 而不向后泄漏钛。"
	quest.5EC0A201D5233C26.title: "Epoch V-化学和数字资格"
	quest.6E3E8AC457D0AC6E.quest_desc: [
		"返回一个行星样本,在永久前哨处理,并保留替换的真空硬件."
	]
	quest.6E3E8AC457D0AC6E.quest_subtitle: "返回的样品和极端条件现在使当地冶炼所不能的材料符合条件。"
	quest.6E3E8AC457D0AC6E.title: "材料Epoch VI——压力、真空和行星证明"
	quest.4D1BF79714293B68.quest_desc: [
		"保留核合金和星光材料一起,然后用于实际的晚期消费者."
	]
	quest.4D1BF79714293B68.quest_subtitle: "核级,极端合金,星光投入成为合格供应链."
	quest.4D1BF79714293B68.title: "Epoch VII-核电站和星光站"
	quest.4410F206DA2357AB.quest_desc: [
		"完成来自XV的第一个催化剂,然后保留所需的物理储存 重新启动 编号 工厂."
	]
	quest.4410F206DA2357AB.quest_subtitle: "Required discipline mastery — contributes to the canonical age proof."
	quest.4410F206DA2357AB.title: "Epoch VIII-非圆形物质工程"
	quest.0D1E5D0514DC8A08.quest_desc: [
		"运行一艘装满的机动艇在标记的码头之间,卸下,并保留人工返回路线."
	]
	quest.0D1E5D0514DC8A08.quest_subtitle: "在区域铁路存在之前,真正的货运是通过水运的。"
	quest.0D1E5D0514DC8A08.title: "河道工程货物证明"
	quest.5B23332B2C0F9C87.quest_desc: [
		"a 码头制造蒸汽机,委托发电服务船,运送散装货单,卸载,并保留黑色起动燃料和 修复 库存。"
	]
	quest.5B23332B2C0F9C87.quest_subtitle: "青铜蒸汽 工业联合体 现在给一条真正的散装水服务路线提供动力。"
	quest.5B23332B2C0F9C87.title: "水上蒸汽机"
	quest.5D7D800EE61CDEA7.quest_desc: [
		"利用便携式发动机建造公路车辆,引导/控制硬件、货车和可使用的轮子。"
		"手动驾驶,携带有用的载荷,安全停车 修复 并且不带命令就收回它"
	]
	quest.5D7D800EE61CDEA7.quest_subtitle: "重工业公路运输是一种维护的物理装置。"
	quest.5D7D800EE61CDEA7.title: "汽车"
	quest.0E2455931392BE9E.quest_desc: [
		"从船只或公路货物中将一批货物通过一个服务装载机运入铁路货运车。"
	]
	quest.0E2455931392BE9E.quest_subtitle: "铁路成为区域骨干,因为其他车辆都为铁路提供饲料。"
	quest.0E2455931392BE9E.title: "公路与铁路相遇"
	quest.179043EF25421123.quest_desc: ["Perform manual takeoff, controlled flight, landing, inspection, repair, and recovery with no autopilot active.","Atmospheric craft are not authorized for spaceflight.","AIR-01 → AIR-03 provides terrain-independent mobility and specialist freight. This aviation branch does not replace the Low-Voltage Grid age proof, bulk rail or first-access rockets."]
	quest.179043EF25421123.quest_subtitle: "Discipline mastery — supporting branch; follow the chapter age proof for the main transition."
	quest.179043EF25421123.title: "莱特兄弟"
	quest.1E51162C2FA371F5.quest_desc: [
		"建设铁路合格发动机,加强机翼集成,对接连接器,服务库存;手动驾驶实用货运线路."
	]
	quest.1E51162C2FA371F5.quest_subtitle: "更强壮 航空器 赚取实际的仪器、货运能力以及铁路服务基地。"
	quest.1E51162C2FA371F5.title: "实用航空"
	quest.53949CE0FA440225.quest_desc: [
		"通过经核实的红石中继连接CC计算机,用于方向或节流硬件,并测试手动超载."
	]
	quest.53949CE0FA440225.quest_subtitle: "数字控制帮助了一个飞行员,但绝不删除手动控制."
	quest.53949CE0FA440225.title: "驱动器"
	quest.3B35B9234CB6A36F.quest_desc: [
		"整合地面计算机、监测器、雷达接收器、飞行前核对表、现有天气/环境观测、中止程序以及保留恢复库存。"
		"完成一个监督任务,重新加入 时代 12顶顶石."
	]
	quest.3B35B9234CB6A36F.quest_subtitle: "Required discipline mastery — contributes to the canonical age proof."
	quest.3B35B9234CB6A36F.title: "特派团业务"
	quest.455B78A66D896CC7.quest_desc: [
		"将工作窑或炉子通过砖头烟囱, 验证 其出口是畅通无阻的。"
	]
	quest.455B78A66D896CC7.quest_subtitle: "早期热量可见,局部,个人有害."
	quest.455B78A66D896CC7.title: "本地烟雾和烟雾"
	quest.52ED0CF0F7572134.quest_desc: [
		"开一个大堆 检查 周围土壤、水、作物、动物和定居场所的接触。"
	]
	quest.52ED0CF0F7572134.quest_subtitle: "可乐、爆破和重热量需要 工业区 计划排气"
	quest.52ED0CF0F7572134.title: "肮脏的工业成为地理"
	quest.570B2A572D09FF2F.quest_desc: [
		"安装铁滤镜框,收集完整的服务批次,更换其介质,并引导已耗用的材料."
	]
	quest.570B2A572D09FF2F.quest_subtitle: "捕获的污染成为了维护库存,而不是消失。"
	quest.570B2A572D09FF2F.title: "第一次主动过滤"
	quest.0A9CDCB37BBA2E9E.quest_desc: ["Combine a powered chimney pump with the ENV-02 aerometer once Digital-era emissions instrumentation is available.","Earlier chimney capture and LV power remain useful. The aerometer is a later measurement capability, separate from constructing the first electrical service."]
	quest.0A9CDCB37BBA2E9E.quest_subtitle: "通风现在是一种带有黑色启动程序的电荷."
	quest.0A9CDCB37BBA2E9E.title: "Instrumented Emissions Control"
	quest.4CEDD69D95922752.quest_desc: [
		"使用CC计算机对金丝网线进行监控,只使用真正的红石或调制解调器信号;触发并恢复一次关闭."
	]
	quest.4CEDD69D95922752.quest_subtitle: "CC监测、过滤库存和关闭主管部门成为 工厂 操作。"
	quest.4CEDD69D95922752.title: "环境控制部"
	quest.14D56ABE98F3CD46.quest_desc: [
		"阶段 独立污染和 辐射 高度;两种危险在机械上仍然是分开的。"
	]
	quest.14D56ABE98F3CD46.quest_subtitle: "行星和核场地携带自己的大气包和废物路线。"
	quest.14D56ABE98F3CD46.title: "远程工业仍然有后果"
	quest.71A1C0F5DB5A1ABE.quest_desc: [
		"改换一个脏东西 工业区 利用钻石过滤,收集残余污染、路线副产品,并证明是干净的 重新启动."
	]
	quest.71A1C0F5DB5A1ABE.quest_subtitle: "Required discipline mastery — contributes to the canonical age proof."
	quest.71A1C0F5DB5A1ABE.title: "封闭环流环境 恢复"
