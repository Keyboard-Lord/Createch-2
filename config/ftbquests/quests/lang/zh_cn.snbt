	quest.4CBDE6AE37B6FEFA.quest_desc: [
		"制造第二对匹配的火箭纳米器助推器,用于后期推进分支."
		"使用匹配的部件,确认机械制造的运行消耗了预定的钛、rid、泵和管制投入。"
	]
	quest.4CBDE6AE37B6FEFA.quest_subtitle: "助推器对是平衡型飞艇最小的实用高推力储备."
	quest.4CBDE6AE37B6FEFA.title: "构建第二个助推器对等"
	quest.4CC251B961F3DA6F.quest_desc: [
		"生产四千毫巴克 MI 第一次凝聚后UU物质."
		"测量氦等离子体和脱氧基的使用,然后在将批量放回复制之前恢复两个缓冲。"
	]
	quest.4CC251B961F3DA6F.quest_subtitle: "四桶UU Matter显示奇异性过程可以反复运行而不消耗其催化剂."
	quest.4CC251B961F3DA6F.title: "运行一个完整的 UU- Matter 批量"
	quest.4D515BC3F0AB3A28.quest_desc: [
		"地点和地点 检查 重复生产后斯特拉里斯火箭发射场"
		"检查板清空 燃料隔离 氧气进入 紧急进气 以及取消发射的命令"
	]
	quest.4D515BC3F0AB3A28.quest_subtitle: "火箭发射场值得深思熟虑 检查失败前的离子要求船员即兴反应."
	quest.4D515BC3F0AB3A28.title: "检查中止系统"
	quest.4D698F2852F180A9.quest_desc: [
		"在IV组件链稳定后,构建大型电路Assembler和大型Assembler."
		"这些 2048-EU/t 机构准备先进的制造和研究所需的基础设施。"
	]
	quest.4D698F2852F180A9.quest_subtitle: "大型精密机将组件成功转化为研究规模制造."
	quest.4D698F2852F180A9.title: "大型制造机"
	quest.4D77F6CCE36ECF3C.quest_desc: [
		"在理解第一个细胞后,建造4个Mekanism/CROWNS固体燃料电池和一个Nuclear Radio dosimeter."
		"保持燃料电池卸货,直到其位置,冷却贡献,关闭反应被审查."
	]
	quest.4D77F6CCE36ECF3C.quest_subtitle: "四个燃料电池和一个个人剂量计为另一个转向配备硬件和测量,而不是文书符号。"
	quest.4D77F6CCE36ECF3C.title: "装备第二反应堆的移动"
	quest.4D7B8DF288B3AE1E.quest_desc: [
		"16号股票 MI 钢大板和32铜板"
		"保持结构材料与机器内部分离,在发行后补充成型线."
	]
	quest.4D7B8DF288B3AE1E.quest_subtitle: "16个钢大板和32个铜板是可信的建筑库存,没有囤积推进控制器。"
	quest.4D7B8DF288B3AE1E.title: "库存区结构单元"
	quest.4DA65DD9E621FE07.quest_desc: [
		"构建一个 电力电网 数米。"
		"接触电路前先测量，隔离电源并再次确认读数为零；带电的 EE 导体仍有触电危险。"
	]
	quest.4DA65DD9E621FE07.quest_subtitle: "Electro Energetics 与 EE 仪表会在接触带电导体前显示电压和电流。"
	quest.4DA65DD9E621FE07.title: "电力电网 测量"
	quest.4DA8A9525ABF3127.quest_desc: [
		"放置 MI 电动按摩器,并运行一个有用的矿石或物质食谱."
		"运行其输出, 然后再开始并监视网格存储, 以建立机器的真实载荷 。"
	]
	quest.4DA8A9525ABF3127.quest_subtitle: "电动马氏器将矿石制备移到能够测量和缓冲的电源上."
	quest.4DA8A9525ABF3127.title: "运行电磁计算器"
	quest.4DB5E6AA7AD016ED.quest_desc: [
		"在火星勘测后,确定斯特拉里斯水星工厂结构的位置."
		"接近环境供应,记录路线,并保留未变的返回储备。"
	]
	quest.4DB5E6AA7AD016ED.quest_subtitle: "A 工厂 只有在探险队能再次离开时 水星上才有用"
	quest.4DB5E6AA7AD016ED.title: "调查汞厂"
	quest.4DCA0AD97DEE9338.quest_desc: [
		"16块大麦面包和1个农夫的美味锅。"
		"将备用锅与燃料、容器和计划场地一起保存,而不是在一般储存中松散。"
	]
	quest.4DCA0AD97DEE9338.quest_subtitle: "16个大锅和锅炉支持几班,同时离开农业成为真正的来源。"
	quest.4DCA0AD97DEE9338.title: "长株潭"
	quest.4DF362D04F6B76FE.quest_desc: [
		"建造4个Nuclecraft固体燃料电池和1个Nuclecraft燃料再处理器."
		"从目前的铀加工、加工和加工设备开始, 屏蔽,废物储存,以及 辐射 ;恢复所有消耗的储备。"
	]
	quest.4DF362D04F6B76FE.quest_subtitle: "四个固体燃料电池和一个新的再处理器证明,控制路线可以重建,而无需一台量子唯聚变机."
	quest.4DF362D04F6B76FE.title: "从库存重建燃料线"
	quest.4DF84094860334C1.quest_desc: [
		"生产八甲进士通过现场发现后路线."
		"使用合法的星光样品如意,并在之后补充核支持的试剂."
	]
	quest.4DF84094860334C1.quest_subtitle: "现有投入的八种异物证明,异物线始于发现,并贯穿工业。"
	quest.4DF84094860334C1.title: "从真实样本缩放正弦"
	quest.4DFD86B65DEAB54C.quest_desc: [
		"燃料电池路线打开后,生产四颗 MI 铀-235尘埃."
		"使用已安装的氧化铀、六氟化铀、离心机和微尘包装链;记录饲料、产品和耗竭分量。"
	]
	quest.4DFD86B65DEAB54C.quest_subtitle: "四枚铀-235粉尘使浓缩分类账成为物理的,可追踪的燃料批次,而不是一个行走计数器."
	quest.4DFD86B65DEAB54C.title: "记录浓缩铀批次"
	quest.4E0AF8B19BBD94C4.quest_desc: [
		"生产并检疫16个核克拉夫特铀粉尘."
		"标注,限制自动化,保持氧化物,六氟化物,浓缩,涂层,以及废物路径的物理可追踪性."
	]
	quest.4E0AF8B19BBD94C4.quest_subtitle: "16个铀粉尘创造了一个负责的燃料批次,没有通过储存散布放射性饲料。"
	quest.4E0AF8B19BBD94C4.title: "铀增压种子"
	quest.4E13EAE9192BD82B.quest_desc: [
		"在同一块块上丢掉一个木头和三个棍子,加5根稻草、纸、叶子或松果,以提高照明的机会。"
		"保持使用与 Fi 键重新启动火坑表后从顶端槽里取燃料"
	]
	quest.4E13EAE9192BD82B.quest_subtitle: "一根木头、三根棍子和可选的火柴 点火变成 工业联合体."
	quest.4E13EAE9192BD82B.title: "点燃第一火坑"
	quest.4E2D0A85974DA997.quest_desc: [
