	quest.4E8D5C81980C9DFC.quest_desc: [
		"运行加热的制造原料批量,并实际移动到电线上."
	]
	quest.4E8D5C81980C9DFC.quest_subtitle: "可见的切割,混合,处理等可重复的有机批量制备."
	quest.4E8D5C81980C9DFC.title: "工业生物学——创建准备"
	quest.3770C8E57AAFCF47.quest_desc: [
		"运行作者 MI 批量、保留生物量和路由木质副产品,而不是删除。"
	]
	quest.3770C8E57AAFCF47.quest_subtitle: "离心、水控制、密封装置使生物物质标准化。"
	quest.3770C8E57AAFCF47.title: "工业生物学 - MI 绝育"
	quest.00C86AC92A2A0FA8.quest_desc: [
		"生产一批可扩能机器;生物发电机仍然无法使用。"
		"时代 9 生物钢将生生物聚合物和普通生物结合 MI 钢铁,无污的加固属于 时代 10个数字生物学升级."
	]
	quest.00C86AC92A2A0FA8.quest_subtitle: "有机纤维细胞制造生物燃料、生物聚合物和 时代 9 钢-生物聚合物复合材料."
	quest.00C86AC92A2A0FA8.title: "工业生物学——Oritech Cell"
	quest.55642E443C71B2BA.quest_desc: [
		"运行一个农林系统,和一个JDT生物消费者,不绕行 TFC 气候或发现。"
	]
	quest.55642E443C71B2BA.quest_subtitle: "甘油、作物过滤器、林业和JDT生物学消耗了保留产品。"
	quest.55642E443C71B2BA.title: "工业生物学——真正的消费者"
	quest.729DF2B0F63284CD.quest_desc: [
		"停止一个批次, 隔离 输入、清除污染的缓冲器, 重新启动 以有名的堆肥为生, 验证 无正数 EMC 循环。"
	]
	quest.729DF2B0F63284CD.quest_subtitle: "废物、污染和电力损失有明确的回收库存。"
	quest.729DF2B0F63284CD.title: "工业生物学——失败与复兴"
	quest.1E8AFB4035F2E1D2.quest_desc: [
