	]
	quest.71DDBBF3B76EF96E.quest_subtitle: "CC 计算机通过 Synaxis 座椅与执行器发送受限指令，不创造车辆控制捷径。"
	quest.71DDBBF3B76EF96E.title: "驱动控制计算机"
	quest.7656C8DECF6EDABB.quest_desc: [
