	quest.440239E49DD1C5DB.quest_desc: [
		"Desaparece, isolar, inspecionar com medidores independentes, substituir controles danificados, e provar frio reiniciar."
	]
	quest.440239E49DD1C5DB.quest_subtitle: "A radiação, o calor e a falha elétrica permanecem problemas separados de recuperação."
