	quest.170759DC92DBF678.quest_desc: [
		"Construa o conjunto de bomba de ferro fundido ao vivo e inspecionar A sua base colocada."
		"A base requer um tanque de ferro fundido, cuba, tubo, bomba e mecanismos de precisão; fornecer armazenamento antes de iniciar a extração."
	]
	quest.170759DC92DBF678.quest_subtitle: "O bombeador faz do óleo enterrado uma matéria-prima mantida em vez de um recipiente encontrado."
	quest.170759DC92DBF678.title: "Comissão"
	quest.17138C41AFEA7B9E.quest_desc: ["Produzir e amortecer 8000 mB de combustível Stellaris.","O vivo Crie pontes de mistura TFMG querosene, gasolina ou diesel em combustível de foguete de igual volume; use tanques fixos e preservar uma quota de retorno.","Encha baldes vanilla com combustível Stellaris sob um bico Create e use a entrada de combustível do foguete. Reserve a biomassa para seus consumidores industriais."]
	quest.17138C41AFEA7B9E.quest_subtitle: "Oito baldes de combustível de lançamento separam uma missão repetitiva de uma única partida."
	quest.17138C41AFEA7B9E.title: "Refinar uma Reserva de Relaunch"
	quest.172780152FA83CA0.quest_desc: [
		"Produzir oito placas curvas de titânio e dezesseis placas planas."
		"Armazenar lotes correspondentes onde a construção do casco não pode consumir o material de emergência."
	]
	quest.172780152FA83CA0.quest_subtitle: "O titânio curvo e plano juntos provam que o casco de pressão pode ser formado e remendado de uma corrente certificada."
	quest.172780152FA83CA0.title: "Curva de casco de pressão"
	quest.177293286F2EECF6.quest_desc: [
		"Estoque dezesseis cabos de silício impresso e dezesseis cabos de vidro Fluix."
		"Mantenha-os fora de armazenamento de rede somente e rotule o ramo de recuperação pretendido."
