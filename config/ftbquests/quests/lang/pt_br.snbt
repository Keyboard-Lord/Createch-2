	quest.18AD71552677CA5D.quest_desc: [
		"Alcance o bioma do Abismo da Eterno Luz Estelar."
		"Use marcadores visíveis, acesso vertical seguro e voltar antes de consumir a reserva de recuperação."
	]
	quest.18AD71552677CA5D.quest_subtitle: "Na borda do Abismo, a visibilidade fraca e o risco vertical tornam a rota de retirada mais importante do que a próxima amostra."
