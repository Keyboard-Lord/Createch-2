	quest.30A278E397F291AA.quest_desc: [
		"Local e inspecionar a Fissão do Mecanismo reator porto na instalação montada."
		"Atribuir a cada porta um papel documentado e manter o acesso do tubo suficientemente claro para isolar Sem entrar na zona quente."
	]
	quest.30A278E397F291AA.quest_subtitle: "Uma porta de fissão é a abertura controlada através da qual o combustível, o refrigerante, os resíduos e a instrumentação devem passar."
