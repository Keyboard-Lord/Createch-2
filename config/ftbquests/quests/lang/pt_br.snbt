	quest.13E8E3545A9126D4.quest_subtitle: "A extensão deve voltar a ser compreensível. AE2 comportamento."
	quest.13E8E3545A9126D4.title: "AE alargada — Recuperação Unidade populacional"
	quest.0CFA39D4B7A4841C.quest_desc: [
		"Produza um lote repetível e consuma parte dele num subsistema exótico real."
	]
	quest.0CFA39D4B7A4841C.quest_subtitle: "A matéria estranha começa no acelerador e alimenta projetos espaciais, buracos negros e de addon máximo."
