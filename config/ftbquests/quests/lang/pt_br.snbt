	quest.193CA92A032C17A8.quest_desc: [
		"Construir e engradado dois Barcos de Carga upgrades de capacidade para problema controlado."
		"Teste-os com carga real e expanda o armazenamento de destino antes de aumentar o volume programado."
	]
