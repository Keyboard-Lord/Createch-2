	quest.6391FE6B21D318A1.quest_desc: [
		"Produzir um lote real de baixa covalência de matéria estabelecida; manter estoque fonte para recuperação."
	]
	quest.6391FE6B21D318A1.quest_subtitle: "A transmutação só começa após a padronização elétrica."
	quest.6391FE6B21D318A1.title: "Covalência I — Matéria responsabilidade"
	quest.66DF7791F814FCC2.quest_desc: ["Produce eight medium covalence dust after the Chemical Age theory and material suppliers are available.","This prepares later encoded transmutation; it does not grant first discovery or replace mining and freight."]
	quest.66DF7791F814FCC2.quest_subtitle: "Aço, mecanismos de precisão e a grade qualificam o pó médio."
	quest.66DF7791F814FCC2.title: "Covalência II — Matéria Industrial"
	quest.079535A07FBDF71A.quest_desc: [
		"Ofereça pó de alta covalência e a Pedra. Conversões comuns permanecem físicas e tributadas."
	]
	quest.079535A07FBDF71A.quest_subtitle: "A matéria só se torna fungível após a prova química e arcana."
	quest.079535A07FBDF71A.title: "Pedra Filosofal e Alta Covalência"
	quest.2E3FC81437EA881A.quest_desc: ["Learn ordinary construction matter, deposit real factory surplus, verify 90% retention, then withdraw one learned ordinary item.","Mature encoded transmutation begins in Age 13 under MTR-03. Only explicitly reviewed ordinary matter has EMC; strategic feedstock, machinery and unreviewed forms remain zero."]
	quest.2E3FC81437EA881A.quest_subtitle: "Um imposto de 10% visível impede que o intercâmbio milagroso se torne uma duplicação livre."
	quest.2E3FC81437EA881A.title: "Tabela de Transmutação Tributada"
	quest.2E15ED45B9D80624.quest_desc: ["Verify machines, proof, fuel, spatial, singularity, and Infinity items remain zero EMC.","Mature encoded transmutation begins in Age 13 under MTR-03. Only explicitly reviewed ordinary matter has EMC; strategic feedstock, machinery and unreviewed forms remain zero."]
	quest.2E15ED45B9D80624.quest_subtitle: "O tablet estende o acesso mas não amplia o zero-EMC limite."
	quest.2E15ED45B9D80624.title: "Interface portátil de suporte"
	quest.22B84332B88B7FCE.quest_desc: [
		"Executar um lote de produção de matéria comum limitado e verificar a entrada/saída EMC O equilíbrio continua a ser tributado."
	]
	quest.22B84332B88B7FCE.quest_subtitle: "A precisão nuclear aumenta a produtividade sem alterar a autoridade de intercâmbio."
	quest.22B84332B88B7FCE.title: "Condensador de energia MK2"
	quest.58E7155D16BCBB6D.quest_desc: ["Qualify two Dark Matter and two Red Matter through the existing Quantum-era manufacturing suppliers.","Keep the earlier nuclear, Starlight and precision industries available. These mature matter stocks support later projects without granting an early industrial bypass."]
	quest.58E7155D16BCBB6D.quest_subtitle: "Starlight, precisão LuV e UU qualificam o material de transmutação tardia."
	quest.58E7155D16BCBB6D.title: "Qualificação da matéria escura e vermelha"
	quest.2C12DE4579FD8529.quest_desc: [
		"Compilar um MK1 e verificar A MK2, a MK3 e a Tome não têm qualquer rota de aquisição."
	]
	quest.2C12DE4579FD8529.quest_subtitle: "Exatamente MK1 entra na campanha após o zero quântico-EMC Prova."
	quest.2C12DE4579FD8529.title: "O único Colecionador Passivo"
	quest.1DB8AD4EA3D6812D.quest_desc: ["Teste o Relógio ou a Varinha do Tempo em uma produção comum. Ambos excluem pedestais de matéria escura e os controladores protegidos de acelerador, reator e perfuração profunda da Oritech. Teste outros reatores, sistemas espaciais e máquinas com grandes inventários antes de ampliar a aceleração."]
	quest.1DB8AD4EA3D6812D.quest_subtitle: "Portátil ProjectE controlo do tempo segue OpV e Infinity e partilha a lista negra temporal."
	quest.1DB8AD4EA3D6812D.title: "Infinity Relógio de Tempo"
	quest.21D3F7925C1B3312.quest_desc: [
		"Repete o depósito, retirada, crafting, fundição, compressão e reciclagem de verificações de um saldo limpo; manter estoque de auditoria."
	]
	quest.21D3F7925C1B3312.quest_subtitle: "A economia de matéria sobrevive reiniciar sem positividade EMC - Loop."
	quest.21D3F7925C1B3312.title: "Impostos e Loop Recuperação Auditoria"
	quest.2A0EA7058CB094C9.quest_desc: [
		"Executar createch2/watchdog com um modem com fio ou integrador de redstone, disparar um alarme, desligar e recuperar manualmente."
	]
