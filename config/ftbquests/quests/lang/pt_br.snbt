	quest.350A8D21355E26C3.quest_desc: [
		"Compilar um AE2 Anel Quântico e demonstrar duzentos e cinquenta milhões FE."
		"Endpoints de energia independentemente e teste quais registros permanecem locais quando a ligação remota cai."
	]
	quest.350A8D21355E26C3.quest_subtitle: "Um anel quântico ao lado de duzentos e cinquenta milhões FE torna o nexo de dados resistente à distância e ao apagão local."
	quest.350A8D21355E26C3.title: "Tabela de dados do Nexus"
	quest.3515E0ECE61EC314.quest_desc: [
		"Construir uma câmara de fusão e três lingotes supercondutores."
		"Reserve os lingotes para substituir o hardware de campo e mantenha o acesso à câmara livre após a montagem."
	]
	quest.3515E0ECE61EC314.quest_subtitle: "Uma pilha de câmaras e supercondutores adicionais transformam uma nave de fusão em infraestrutura mantentável."
	quest.3515E0ECE61EC314.title: "Pilha de Câmara de Fusão"
	quest.35A02BE5F2ED7511.quest_desc: [
		"Produzir oito AE2 cristais de fluix num lote posterior."
		"Recomponha certus e redstone depois e atribuir o lote antes de cabo, controlador e demanda de criação competir por ele."
	]
	quest.35A02BE5F2ED7511.quest_subtitle: "Mais oito cristais fluix mostram que a entrada e transformação carregadas podem acompanhar o ritmo com o crescimento da rede."
	quest.35A02BE5F2ED7511.title: "Preparar um Segundo Desvio Fluix"
	quest.35E51DBA15585575.quest_desc: [
		"Produzir uma MI singularidade para o livro de convergência."
		"Mantenha sua linha de material fonte ativa e registre a taxa em vez de tratar o primeiro resultado como um isolar d coleccionável."
	]
	quest.35E51DBA15585575.quest_subtitle: "Uma singularidade controlada é uma unidade de produção agora, mas cada uma ainda representa uma execução inteira planta."
	quest.35E51DBA15585575.title: "Contar o Primeiro Estoque de Convergência"
	quest.363156E2781C7254.quest_desc: [
		"Compilar dois AE2 Anéis quânticos e quatro lingotes supercondutores."
		"Fase um anel em cada ponto final e manter seu comportamento de potência e carga de blocos sob observação antes de mover armazenamento crítico."
	]
	quest.363156E2781C7254.quest_subtitle: "Dois anéis quânticos e estoque supercondutor reserva manter um controle remoto AE2 ligação recuperável de ambos os lados."
	quest.363156E2781C7254.title: "Anel Quântico Sobressalente"
	quest.364BA8FBDE902C63.quest_desc: [
		"Produza um Catalisador do Infinito para provar que máquinas especializadas podem compartilhar serviços, logística, manutenção e limites de distrito recuperáveis."
	]
	quest.364BA8FBDE902C63.quest_subtitle: "Discipline mastery — supporting branch; follow the chapter age proof for the main transition."
	quest.364BA8FBDE902C63.title: "Megaestrutura de Planejamento Dominada"
	quest.364BD12BAA4FB37C.quest_desc: [
		"Encontra o bioma Stellaris Mars Rocky Plains."
		"Marque a rota de aterragem, o refúgio de oxigénio, a fronteira de amostras e um caminho seguro para o foguete."
	]
	quest.364BD12BAA4FB37C.quest_subtitle: "As planícies rochosas oferecem espaço para trabalhar, mas cada passo de pesquisa aumenta a distância do abrigo e combustível de retorno."
	quest.364BD12BAA4FB37C.title: "Pesquisa em planícies rochosas de Marte"
	quest.36D81E9159116003.quest_desc: [
		"4a unidade populacional MI singularidades e quatro lingotes de neutrões."
		"Gravar as suas linhas de origem e manter a sala de espera isolar d da criação final irrestrita."
	]
	quest.36D81E9159116003.quest_subtitle: "Quatro singularidades e quatro lingotes de nêutrons transformam convergência abstrata em estoque que pode ser contado e protegido."
	quest.36D81E9159116003.title: "Sala de Contagem de Singularidade"
	quest.36E4A378A4274CAD.quest_desc: [
		"Compila o localizador de óleo Stellaris instalado usado por este ramo."
		"Examine longe de construções terminadas e marque a localização da bomba, rota do tubo, armazenamento e acesso seguro antes da perfuração."
	]
	quest.36E4A378A4274CAD.quest_subtitle: "Um localizador de petróleo transforma um depósito invisível num local pesquisado cuja rota de extração pode ser planejada."
	quest.36E4A378A4274CAD.title: "Localizador de óleo"
	quest.36E7D3E69013CD25.quest_desc: [
		"Construa uma lata de óleo TFMG a partir da folha de latão e receita de placa de estanho."
		"Armazenar o líquido vazio junto ao ponto de amostragem, para que não se torne um recipiente não identificado de fluido misto."
	]
	quest.36E7D3E69013CD25.quest_subtitle: "Um óleo dedicado pode tornar possível a verificação de fluidos sem abrir a fazenda principal."
	quest.36E7D3E69013CD25.title: "Mantenha uma lata de amostragem de óleo"
	quest.37047374E1A3C4CE.quest_desc: [
		"Estoque dezesseis pó de quartzo certus e quatro MI placas de circuito digital."
		"Mantenha a prateleira fisicamente acessível e reabasteça ambos antes de autorizar outra expansão drive-bay."
	]
	quest.37047374E1A3C4CE.quest_subtitle: "As placas de pó e placas digitais Certus em uma prateleira preparam tanto materiais de rede quanto os eletrônicos que as controlam."
	quest.37047374E1A3C4CE.title: "Certus Poeira"
	quest.373D506E9AF5C66D.quest_desc: [
		"Construir picareta de cobre."
		"Despeje cobre em um molde de cabeça de picareta, deixe esfriar, e depois coloque a cabeça em um pau."
	]
	quest.373D506E9AF5C66D.quest_subtitle: "Uma picareta de cobre abre a rocha; ela não faz um túnel não suportado seguro."
	quest.373D506E9AF5C66D.title: "Primeiro picareta de cobre"
	quest.377A5013538B6EAB.quest_desc: [
		"Local e inspecionar Uma caixa de máquina de bronze no local de expansão."
		"Verificar entrada, saída, potência, segurança e acesso de substituição contra o existente distrito industrial."
	]
	quest.377A5013538B6EAB.quest_subtitle: "Uma cápsula de bronze colocada na nova pegada verifica o acesso e as interfaces antes da expansão consumir uma estrutura rara."
	quest.377A5013538B6EAB.title: "Comissão de um Módulo de Expansão"
	quest.37956FF2E3F6CA3B.quest_desc: [
		"Buffer 16 mil mil milibuckets de petróleo bruto e 27 tijolos de forno de coque de Railcraft."
		"Mantenha o material de reconstrução seco e o bruto isolar d de trabalho quente."
	]
	quest.37956FF2E3F6CA3B.quest_subtitle: "Dezasseis baldes de cru e 27 tijolos de forno de coque preservam a alimentação e uma reconstrução completa do forno."
	quest.37956FF2E3F6CA3B.title: "Estágio de três Shift Crude e Coca-Cola"
	quest.37CDD207B3578251.quest_desc: [
		"Buffer oito baldes de criofluido, em seguida, usar parte dessa reserva para terminar um lote de titânio oito-ingot."
		"Este é o ajuste quântico explícito para titânio; Alta Pressão permanece completa através da rota free free free original de refrigeração."
	]
	quest.37CDD207B3578251.quest_subtitle: "O criofluido agora suporta tanto o trabalho de supercondutor quanto o recondicionamento explícito do titânio Quantum."
	quest.37CDD207B3578251.title: "Tampão do laço criogênico"
	quest.37D714556899CBFF.quest_desc: [
		"Construir e estocar oito Rede elétrica Conectores de fios."
		"Estabelecer junções acessíveis entre geração de MV, armazenamento, MI máquinas, e a primeira carga química."
	]
	quest.37D714556899CBFF.quest_subtitle: "Oito Rede elétrica conectores manter o novo piso fisicamente conectado sem invadir LV reparar s."
	quest.37D714556899CBFF.title: "Conectores MV de stock"
	quest.380E2171E6D881E8.quest_desc: [
		"Unidade populacional dezasseis MI Placas de bronze de bronze CBC certificada."
		"Use as rotas de formação precoce do pacote e reserve as placas ao lado dos componentes de alimentação da caldeira, em vez de consumir cada placa na expansão."
	]
	quest.380E2171E6D881E8.quest_subtitle: "Dezesseis placas de bronze fazem tanque e invólucro reparar É possível antes da pressão cair."
	quest.380E2171E6D881E8.title: "Placa de reposição de alimentação de caldeira"
	quest.381107F257E77DF5.quest_desc: [
		"Produzir e armazenar dezesseis MI Placas de titânio."
		"Manter rutilo, cloro químico, hot-ingot, congelamento a vácuo e capacidade de formação de placas atrás do estoque."
	]
	quest.381107F257E77DF5.quest_subtitle: "Dezesseis placas de titânio tornam possível a pressão e o trabalho aeroespacial sem esvaziar o primeiro lote de vácuo."
	quest.381107F257E77DF5.title: "Unidade populacional Placa de titânio"
	quest.381A964854A069FC.quest_desc: [
		"Preparar oito. TFC Itens de folhas de couro."
		"Conservar com planta fibra e as ferramentas utilizadas para embalagem e cinta reparar s."
	]
	quest.381A964854A069FC.quest_subtitle: "Oito folhas de couro reparar transporte de equipamento sem necessidade de dois cintos acabados para sentar não utilizados."
	quest.381A964854A069FC.title: "Couro de estoque para reparos"
	quest.382186E1F4A9D617.quest_desc: [
		"Produção e transferência de 8 000 mB de MI oxigénio."
		"Use um tanque limpo e linha dedicada; confirme a produção de oxigênio e enchimento de recipiente antes de atribuir tanques para a missão."
	]
	quest.382186E1F4A9D617.quest_subtitle: "Oito baldes de oxigênio deixaram que o encanamento de suporte vital fosse purgado, preenchido e testado antes da partida."
	quest.382186E1F4A9D617.title: "Rack de purga de oxigênio"
	quest.38240647EC719970.quest_desc: ["Build a Deep Learner and prepare a Blank Data Model for a mob whose drops justify sustained simulation.","Train the model through Hostile Neural Networks before scaling to powered chambers; this contract establishes the equipment and model stock.","Optional Digital simulation under COM-04. Hostile models and drops do not prove factory control or replace first-resource acquisition."]
	quest.38240647EC719970.quest_subtitle: "Um aluno e modelo em branco transformam os encontros de campo em um programa de previsão repetitivo."
	quest.38240647EC719970.title: "Preparar os primeiros modelos de dados"
	quest.3850D9F3338D416E.quest_desc: [
		"8 de estoque MI anéis de aço."
		"Mantenha-os com as ferramentas de bomba e tubo onde um selo falhou não pode cortar o acesso."
	]
	quest.3850D9F3338D416E.quest_subtitle: "Oito anéis de aço fazem uma água reiniciar possível antes da linha de vapor esfriar completamente."
	quest.3850D9F3338D416E.title: "Selos de bomba de aço de estágio"
	quest.38665588DCF9F600.quest_desc: [
		"Traga um tanque de fluido de ferro fundido, coque de carvão e uma lata de óleo TFMG para o local de indústria pesada."
		"O óleo pode usar chapa de latão e placa de estanho na receita viva; o tanque deve ser de ferro fundido aqui, não mais tarde aço."
	]
	quest.38665588DCF9F600.quest_subtitle: "A coca, um tanque de ferro fundido e um óleo podem ligar a geologia à primeira pesquisa da refinaria."
	quest.38665588DCF9F600.title: "Pesquisa de Recursos da Indústria Pesada"
	quest.38719DF87C5C3E1D.quest_desc: [
		"Ativador AE2 O avanço da ponte de rede quântica."
		"Potência ambos os terminais, perda de ligação de teste e manter o acesso de recuperação local."
	]
	quest.38719DF87C5C3E1D.quest_subtitle: "O avanço da ponte de rede quântica pertence após o Nível 15 anéis, quando a rede remota está realmente disponível."
	quest.38719DF87C5C3E1D.title: "Prova de Ligação Quântica"
	quest.3880BFE832E921CB.quest_desc: [
		"Derrotar um TFC crocodilo no chão onde é possível retirar."
		"Evite águas profundas, mantenha o banco distante visível, e recupere sem abandonar o kit de campo."
	]
	quest.3880BFE832E921CB.quest_subtitle: "Um crocodilo transforma um rio familiar em terreno que deve ser lido do banco."
	quest.3880BFE832E921CB.title: "Cruzamento do rio Crocodilo"
	quest.38A46C29E6B8C326.quest_desc: [
		"Formar um grande vaso de argila e atirá-lo em um forno de poço coberto."
		"Use-o para armazenamento a granel durável; cerâmica não queimada é apenas uma promessa até que o forno sobrevive à noite."
	]
	quest.38A46C29E6B8C326.quest_subtitle: "O armazenamento de fogo transforma o alimento e o minério recolhidos em suprimentos que você pode proteger."
	quest.38A46C29E6B8C326.title: "Dispare um grande recipiente de armazenamento"
	quest.38B253E7DD415551.quest_desc: [
		"Construir o veículo Stellaris através da cadeia de fornecimento de LV vivos."
		"Carregar reparar blocos, oxigênio, alimentos, navegação e uma reserva de caminhada; um veículo não é um substituto para um plano de retorno."
	]
	quest.38B253E7DD415551.quest_subtitle: "Um veículo só estende o raio de trabalho seguro se a sua potência e rota de regresso permanecerem conhecidas."
	quest.38B253E7DD415551.title: "Rover Recuperação Plano"
	quest.38C158FA58C71044.quest_desc: [
		"4a unidade populacional Infinity Nuggets e quatro lingotes de neutrões."
		"Proteger da criação geral e atribuir a reserva apenas ao equipamento de convergência danificado ou a uma reconstrução documentada."
	]
	quest.38C158FA58C71044.quest_subtitle: "Quatro Infinity nuggets e quatro lingotes de nêutrons mantêm a fabricação final reparar capaz sem desmontar um artefacto acabado."
	quest.38C158FA58C71044.title: "A Reserva a Convergence Repair Set"
	quest.38DAC06BF649159C.quest_desc: [
		"Reproduzir um Infinity pepita depois de encomendar o fabricante de matéria universal."
		"Rastreie cada catalisador consumido e entrada singular, em seguida, restaure a linha antes de escalar."
	]
	quest.38DAC06BF649159C.quest_subtitle: "A reproduzido Infinity Nugget prova que o fabricante contratado pode fechar a rota de convergência novamente."
	quest.38DAC06BF649159C.title: "Reproduzir Infinity Nugget após o Comissionamento do Fabricador"
	quest.3900F7C76B6102F8.quest_desc: [
		"Construa dois olhos eternos à procura da luz das estrelas."
		"Carregar um e manter um na base de recuperação com coordenadas de rota e equipamento de substituição."
	]
	quest.3900F7C76B6102F8.quest_subtitle: "Dois olhos que procuram uma navegação dão uma sobressalente quando uma rota termina mais longe de casa do que o esperado."
	quest.3900F7C76B6102F8.title: "Prova de navegação astral"
	quest.391356CCEE6C5B8A.quest_desc: ["Charge an Attuned Stone at a functioning Enchanted Altar.","This proves a real native ritual workflow instead of another possession token.","This is an optional discipline at this age; the canonical factory proofs govern normal progression."]
	quest.391356CCEE6C5B8A.quest_subtitle: "Uma pedra carregada é evidência de que o laboratório pode sustentar ritos úteis."
	quest.391356CCEE6C5B8A.title: "Perform a Useful Rite"
	quest.39244DA3A33C848A.quest_desc: [
		"Coloque o misturador Alchemical e complete uma receita útil instalada."
		"Use entradas conhecidas da rota do dissolvedor e impeça que o ramo de contornar materiais de progressão não descobertos."
	]
	quest.39244DA3A33C848A.quest_subtitle: "O combiner ganha seu banco reconstruindo um material documentado a partir de elementos já produzidos."
	quest.39244DA3A33C848A.title: "Banco de Combinadores"
	quest.392B60A220C4B629.quest_desc: [
		"Construa faca de pedra sedimentar e machado de pedra sedimentar."
		"Apanhe e faça a substituição de cabeças de pedra como um kit de campo, mantendo uma cabeça não utilizada para o retorno desarme."
	]
	quest.392B60A220C4B629.quest_subtitle: "Ferramentas de pedra reserva manter o trabalho comum de consumir a última luz do dia."
	quest.392B60A220C4B629.title: "Kit de ferramentas de pedra substituível"
	quest.395C953C30A53C29.quest_desc: [
		"Produza uma jarra disparada e um grande recipiente disparada do seu atual suprimento de argila."
		"Este ramo verifica a rota completa da cerâmica, não os itens entregues pelo livro."
	]
	quest.395C953C30A53C29.quest_subtitle: "Um jarro e um grande recipiente mostram que toda a rota de argila pode ser repetida sob demanda."
	quest.395C953C30A53C29.title: "Argila para Infraestrutura Disparada"
	quest.398051EEB67E214A.quest_desc: [
		"Completa TFC Cobre Era avanço através da rota de metalurgia pretendida."
		"Mantenha intacta a fonte de minério conhecida, fornecimento de carvão, moldes e caminho de transporte; o lingote é apenas a prova visível."
	]
	quest.398051EEB67E214A.quest_subtitle: "Cobre tornou-se um material de ferramenta substituível em vez de um primeiro casting da sorte."
	quest.398051EEB67E214A.title: "Cobre Era Estabelecida"
	quest.39888D8269DA0427.quest_desc: [
		"Nade 500 metros em travessias reais ou num percurso preparado levando o equipamento de pressão."
		"Trate frio, ar e profundidade como limites: mantenha a saída visível, desça em etapas e retorne antes de exceder o plano do casco ou da equipe."
		"O lastro controla descida e subida; pressurizador e instrumentos não concedem profundidade ilimitada nem substituem uma rota clara de recuperação."
	]
	quest.39888D8269DA0427.quest_subtitle: "Profundímetro, casco dimensionado e plano de lastro transformam água profunda numa rota de engenharia medida."
	quest.39888D8269DA0427.title: "Atravessamento de Água Fria"
	quest.3A0C05506AFA7DD9.quest_desc: [
		"Demonstrar 100.000.000 FE de reserva conectada dedicada à recuperação de megaprojetos."
		"Separar o ônibus de recuperação de cargas de produção e testá-lo com a fonte principal aberta."
	]
	quest.3A0C05506AFA7DD9.quest_subtitle: "Cem milhões armazenados FE vamos controlar e recompor o roteamento sem pedir a um megaprojeto parado para se alimentar."
	quest.3A0C05506AFA7DD9.title: "Projecto de Reserva Recuperação Potência"
	quest.3A8DF225636E8786.quest_desc: [
		"Produzir um AE2 processador de engenharia através da sequência manual completa do inscritor."
		"Mantenha as prensas de engenharia e silício acessíveis fora da rede e mantenha uma fonte manual de pedra vermelha."
	]
	quest.3A8DF225636E8786.quest_subtitle: "O primeiro processador de engenharia prova a sequência completa do circuito impresso antes da escala da rede."
	quest.3A8DF225636E8786.title: "Produzir o primeiro processador de engenharia"
	quest.3A9307368862BF6F.quest_desc: [
		"Knapp um machado de pedra, anexar um pau, e caiu uma árvore através TFC O mecânico de madeira nativo."
		"Limpe o caminho de queda e retenha pelo menos oito toros para o primeiro forno de poço."
	]
	quest.3A9307368862BF6F.quest_subtitle: "Os logs fornecem combustível, carvão vegetal, abrigo e o primeiro forno de poços."
	quest.3A9307368862BF6F.title: "Caiu a Primeira Árvore"
	quest.3ABCE5F82A286363.quest_desc: [
		"Derrote um alienígena Stellaris e proteja a área imediata."
		"Reparar qualquer violação, verificar novamente o equipamento de oxigénio e combustível, e não retomar as operações de lançamento até que o perímetro esteja limpo."
	]
	quest.3ABCE5F82A286363.quest_subtitle: "Um alienígena dentro da zona de trabalho transforma a segurança do casco em parte da engenharia da missão."
	quest.3ABCE5F82A286363.title: "Quebra de casco alienígena"
	quest.3AE26018A1D09C5E.quest_desc: [
		"Local e inspecionar O gerador de escudos atribuído à reserva de contenção primária."
		"Verifique sua alimentação, buffer, acesso e comportamento após a abertura do fornecimento elétrico normal."
	]
	quest.3AE26018A1D09C5E.quest_subtitle: "Uma alimentação protegida de escudos evita que a contenção desapareça com o normal fábrica Autocarro."
	quest.3AE26018A1D09C5E.title: "Fonte de Reserva de Escudos"
	quest.3B082930B3B08F61.quest_desc: [
		"Estoque oito Crie conectores de correia e dezesseis lingotes de ferro forjado."
		"Armazenar no intercâmbio com ferramentas e marcadores de isolamento de rota."
	]
	quest.3B082930B3B08F61.quest_subtitle: "Oito conectores de correia e dezesseis lingotes de ferro forjado manter transferências reparar capaz sem canibalizar o caminho."
	quest.3B082930B3B08F61.title: "Reparos de correias e trilhos"
	quest.3B6F943E44931767.quest_desc: [
		"Executar um movimento inicial estabelecido para o Rede elétrica Embreagem do gerador, em seguida, medir a saída protegida com um medidor de potência."
		"Observe carga da bateria, comutação, resposta de sobrecarga e comportamento quando a entrada mecânica ou a demanda elétrica mudam."
	]
	quest.3B6F943E44931767.quest_subtitle: "Uma interface medida mantém o movimento principal distinto enquanto Rede elétrica possui arquitetura de geração e distribuição."
	quest.3B6F943E44931767.title: "Relógio de Interface do Gerador"
	quest.3B80A3C53444F973.quest_desc: [
		"Compilar um AE2 1k célula de armazenamento de itens e instalá-lo em uma unidade."
		"Teste a inserção e extração, em seguida, evite preenchê-lo com muitos tipos de itens minúsculos."
	]
	quest.3B80A3C53444F973.quest_subtitle: "Uma célula de armazenamento de 1k ensina tipos, bytes e o fato de que o armazenamento digital ainda tem uma forma finita."
	quest.3B80A3C53444F973.title: "Básicos da Célula de Armazenamento"
	quest.3B8B93CEB040A794.quest_desc: [
		"Demonstrar cem milhões FE de reserva ligada."
		"Mantenha controles, roteamento de itens e recuperação de fluidos no barramento protegido, depois teste-os com a conexão geradora principal aberta."
	]
	quest.3B8B93CEB040A794.quest_subtitle: "Um impasse só é recuperável enquanto o planta conserva a potência que nenhuma das suas próprias saídas deve criar primeiro."
	quest.3B8B93CEB040A794.title: "Prove a reserva de convergência"
	quest.3BC92151AAAEBAB3.quest_desc: [
		"Use um carregador de itens avançado para provar que carroças, trilhos, tubulações, dirigíveis e portais se encontram em pontos controlados de transferência de carga."
	]
	quest.3BC92151AAAEBAB3.quest_subtitle: "Discipline mastery — supporting branch; follow the chapter age proof for the main transition."
	quest.3BC92151AAAEBAB3.title: "Logística de Carga Masterizada"
	quest.3BD8AAA53AF7205D.quest_desc: [
		"Coloque e execute o compressor de aço enquanto a busca observa."
		"Use uma receita de formação necessária e roteie sua saída antes de carregar o próximo lote."
	]
	quest.3BD8AAA53AF7205D.quest_subtitle: "O compressor de aço faz placas densas e peças de máquina rotina em vez de cerimonial."
	quest.3BD8AAA53AF7205D.title: "Execute o Compressor de Aço"
	quest.3C0119E15CADA2FA.quest_desc: [
		"Produza quatro lingotes de matriz de cristal e dois blocos de matriz de cristal."
		"Reabasteça a rede de diamantes, platina, liga nuclear, liga atômica, estrela, e entradas de catalisador depois."
	]
	quest.3C0119E15CADA2FA.quest_subtitle: "Quatro lingotes e dois blocos de matriz provam que as cadeias de abastecimento exóticas e nucleares podem se encontrar mais de uma vez."
	quest.3C0119E15CADA2FA.title: "Repetir a produção de matriz de cristal"
	quest.3CB9158B471E813E.quest_desc: [
		"Construa dezesseis tubos Stellaris de nível um usados por este ramo."
		"Rotular o fluido transportado, fornecer isolamento, e evitar a união de produtos incompatíveis a um principal não marcado."
	]
	quest.3CB9158B471E813E.quest_subtitle: "Dezesseis tubos de nível um fornecem uma corrida local útil com comprimento de reposição suficiente para reencaminhar."
	quest.3CB9158B471E813E.title: "Estoque o Pipe Rack Petroquímico"
	quest.3CFC05A8BA10EE44.quest_desc: [
		"Estoque dezesseis Criar rodas de engrenagem."
		"Mantenha pequenas engrenagens para mudanças de direção e reserve grandes engrenagens para mudanças de velocidade que o orçamento de estresse pode suportar."
	]
	quest.3CFC05A8BA10EE44.quest_subtitle: "Dezesseis rodas de engrenagem fazem uma transmissão reconstruir possível sem varrer outra máquina."
	quest.3CFC05A8BA10EE44.title: "Preencha a Rack de Roda de Cogwheel"
	quest.3D09A6327BF6A676.quest_desc: [
		"Estoque de carvão e bola de clay."
		"Siga a receita TFMG em EMI e fornecer armazenamento de fluidos seguro antes de iniciar a máquina."
	]
	quest.3D09A6327BF6A676.quest_subtitle: "Blocos de Coca-Cola e fireclay na mesma palete preparam o calor e a estrutura que o contém."
	quest.3D09A6327BF6A676.title: "Reserva de blocos de coca"
	quest.3D43E5213326E101.quest_desc: [
		"4a unidade populacional Rede elétrica pilhas e quatro conectores de fio."
		"Organize proteção e isolamento antes de juntar baterias em um circuito compartilhado."
	]
	quest.3D43E5213326E101.quest_subtitle: "Quatro baterias e quatro conectores fazem um banco modesto cuja corrente de falha merece seu próprio gabinete."
	quest.3D43E5213326E101.title: "Condutores e Tampão de Deslocamento de Armazenamento"
	quest.3D60CBD5DAC37151.quest_desc: [
		"Estoque quatro Rocketnautics liga de titânio e oito MI Lingotes de titânio."
		"Reabasteça as linhas de vácuo e liga após atribuir qualquer parte ao hardware de voo."
	]
	quest.3D60CBD5DAC37151.quest_subtitle: "Quatro peças de liga e oito lingotes proteger nave espacial trabalho de consumir a pressão -reparar reserva."
	quest.3D60CBD5DAC37151.title: "Buffer Titanium Aerospace Reserva"
	quest.3D86B0A7989A8F2F.quest_desc: [
		"Local e inspecionar a MI Turbina a vapor MV e manter um casco de máquina avançado pronto."
		"Reserve vapor, cabo, armazenamento, acesso à manutenção e rotas de material limpo antes de encher o chão com os consumidores."
	]
	quest.3D86B0A7989A8F2F.quest_subtitle: "Uma turbina MV ao lado de um casco avançado faz a geração e a expansão da máquina parte do mesmo plano."
	quest.3D86B0A7989A8F2F.title: "Defina o piso MV"
	quest.3DAC55744EAAED81.quest_desc: [
		"Visite a dimensão Eterna da Luz Estelar e retorne em segurança."
		"Deixe o posto avançado fornecido para outra missão e traga para casa apenas carga que não desloque o kit de recuperação."
	]
	quest.3DAC55744EAAED81.quest_subtitle: "Entrar na Starlight e regressar com a rota intacta é uma prova mais forte do que chegar sozinho."
	quest.3DAC55744EAAED81.title: "Digite Luz Estelar e Retorno"
	quest.3DDDBD64278F32D7.quest_desc: [
		"Completa TFC Bronzeado Era avanço com a metalurgia primitiva pretendida."
		"Mantenha esse material distinto do bronze CBC, que o pacote usa como ponte certificada para MI máquinas."
	]
	quest.3DDDBD64278F32D7.quest_subtitle: "Bronze primitivo prova metalurgia de sobrevivência; a via de fundição prova fábrica Bronze."
	quest.3DDDBD64278F32D7.title: "Digite o Bronze Nível"
	quest.3E1525CC9326D617.quest_desc: [
		"Mantenha uma placa torácica de lã e 32 carvão pronto."
		"Vestido antes de desarme, combustível de estágio no abrigo, e voltar enquanto a água e visibilidade permanecem controláveis."
	]
	quest.3E1525CC9326D617.quest_subtitle: "Roupas quentes e combustível seco ganham o tempo necessário para recuar antes que o tempo se torne uma emergência."
	quest.3E1525CC9326D617.title: "Preparar para exposição a frio"
	quest.3E1FF7B9A87E4826.quest_desc: [
		"Derrotar um TFC Direwolf durante a defesa normal ou uma caçada preparada."
		"Não desenhe o animal através de gado, armazenamento ou a única porta segura."
	]
	quest.3E1FF7B9A87E4826.quest_subtitle: "Um lobo de guerra à noite testa se o assentamento tem luz, perímetro e uma rota dentro de casa."
	quest.3E1FF7B9A87E4826.title: "Relógio noturno Direwolf"
	quest.3E25D970EFCB6A8F.quest_desc: [
		"Construa a bomba de água de bronze a partir de rotores, engrenagens, placas, revestimento, tubos e um tanque de bronze."
		"Conecte-o através de armazenamento tamponado e verificar a bomba pode manter o ritmo antes de deixar a caldeira sem vigilância."
	]
	quest.3E25D970EFCB6A8F.quest_subtitle: "A alimentação automática de água transforma a atenção da caldeira de constante transporte para a infra-estrutura monitorada."
	quest.3E25D970EFCB6A8F.title: "Adicionar uma bomba de água automática"
	quest.3E27886653053060.quest_desc: [
		"Derrote um Stellaris Pygro Brute longe de carga e máquinas vulneráveis."
		"Use cobertura preparada e verifique novamente o perímetro antes de retomar o trabalho de carregamento."
	]
	quest.3E27886653053060.quest_subtitle: "Um pygro bruto é uma ameaça de perímetro que recompensa a distância, cobertura, e uma rota que a tripulação de carga pode manter."
	quest.3E27886653053060.title: "Quebra- Brutos Pygro"
	quest.3E3054C45B8078A7.quest_desc: [
		"Instalar e inspecionar a Rede elétrica Suporte de interruptor e fusível LV em um ramo de distribuição acessível."
		"Usar o interruptor para isolar um consumidor antes do serviço; o teste agora verifica hardware de segurança real em vez de peças sobressalentes."
	]
	quest.3E3054C45B8078A7.quest_subtitle: "Um interruptor e suporte de fusível deixou um ramo falhar ficar escuro sem silenciar todo o planta."
	quest.3E3054C45B8078A7.title: "Instalar isolamento LV"
	quest.3E47A95F4DB0740A.quest_desc: [
		"Local e inspecionar Um grande macerador de vapor de industrialização estendida."
		"Forneça vapor, entrada a granel, saída limitada e acesso para limpar uma linha parada."
	]
	quest.3E47A95F4DB0740A.quest_subtitle: "O grande macerador a vapor substitui lotes manuais repetidos por uma máquina cuja alimentação e saída devem continuar em movimento."
	quest.3E47A95F4DB0740A.title: "Linha de Macerador de Bronze"
	quest.3E7BCC4A50B3502A.quest_desc: [
		"Construa dois infusores químicos e mantenha oito folhas de PEAD."
		"Atribuir pares de gás deliberadamente e isolar As máquinas antes de mudar uma receita ou tanque anexado."
	]
	quest.3E7BCC4A50B3502A.quest_subtitle: "Dois infusores e um lote de folhas deixam as combinações de gás mudar sem limpar a única máquina."
	quest.3E7BCC4A50B3502A.title: "Prepare uma Segunda Mudança de Química"
	quest.3E99264967FB729F.quest_desc: [
		"Construa um módulo de combustível Stellaris e estoque oito lingotes acabados de desh."
		"Mantenha selos, fixadores comuns e ferramentas próximas, mas reserve o desh para danos de vôo-hardware confirmados."
	]
	quest.3E99264967FB729F.quest_subtitle: "Um módulo de combustível de reserva e oito lingotes desh cobrem um real reparar sem se tornar um cache de veículo duplicado."
	quest.3E99264967FB729F.title: "Estoque a prateleira de reparo de voo"
	quest.3ECCBE14F9213837.quest_desc: [
		"Armazenar quatro RCS propulsores e quatro MI Lingotes de irídio misturados."
		"Mantenha-os na base de lançamento para que uma missão perdida não leve suas próprias partes de recuperação."
	]
	quest.3ECCBE14F9213837.quest_subtitle: "Quatro RCS propulsores e irídio misto colocar controle e contato reparar na mesma prateleira."
	quest.3ECCBE14F9213837.title: "Reparos de Orientação de stocks"
	quest.3EDAD3C9A686C7AF.quest_desc: [
		"Local e inspecionar outro MI casco avançado da máquina na área de expansão."
		"Conecte a geração e buffers de material antes de atribuí-lo a uma máquina em vez de mover o casco original para a verificação."
	]
	quest.3EDAD3C9A686C7AF.quest_subtitle: "Um segundo casco avançado prova que fábrica pode reproduzir o seu quadro MV após a primeira linha ser ocupada."
	quest.3EDAD3C9A686C7AF.title: "Comissão um segundo casco avançado"
	quest.3F46C281C95CF4BD.quest_desc: [
		"Crie um criador mecânico e inclua-o em uma matriz real."
		"Alinhar o padrão, fornecer estresse suficiente, e manter a saída completa de bloquear o rosto."
	]
	quest.3F46C281C95CF4BD.quest_subtitle: "Os artesãos mecânicos fazem uma grande receita visível em uma grade de peças móveis e potência sincronizada."
	quest.3F46C281C95CF4BD.title: "Criar uma Linha Mecânica"
	quest.3F5BBCBCFE359F78.quest_desc: [
		"Compilar um MI Escotilha avançada de entrada de itens."
		"Conecte-o ao fornecimento de buffered e mantenha espaço suficiente para inspecionar O que o próximo lote está esperando."
	]
