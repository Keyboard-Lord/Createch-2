	quest.29E4896E4BD53833.quest_desc: [
		"Operar o acelerador de base no seu multiplicador limitado; verificar negação em EMC, reator s, blocos espaciais, veículos, e ele próprio."
	]
	quest.29E4896E4BD53833.quest_subtitle: "Só é permitida uma aceleração fixa de baixo nível após a prova do acelerador."
