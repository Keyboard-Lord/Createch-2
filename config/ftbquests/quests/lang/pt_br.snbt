	quest.7A5918BF8F0FF0A8.quest_desc: [
		"Após condensar a primeira matéria controlada UU, produzir liga de eclipse e cristais de tempo através das rotas de convergência de autoria."
		"Era 14 fornece os ingredientes LUV, nuclear, e Starlight; Era 15 fornece o passo de engenharia de matéria."
	]
	quest.7A5918BF8F0FF0A8.quest_subtitle: "Engenharia de matéria quântica transforma o Era 14 precursores em contenção temporal."
	quest.7A5918BF8F0FF0A8.title: "Liga de eclipse e componentes temporais"
	quest.6A07A3475120D3A7.quest_desc: ["Run the five independent accelerator-component lines for controller, rings, motors, sensors, and collectors; each integrates ZPM precision, Eclipse Alloy, Starlight, nuclear structure, AE2 Quantum, UU Matter, and closure before the authored collision.","Operate the physical accelerator under CC monitoring and route its specialized energy interface through Electro Energetics.","Finish all five accelerator component sequences on a Naquadah Alloy Press or higher. Tollan trinium, the synthetic Naquadah route and the PGM refinery supply the alloy. Make its first plates and shafts on the RPP floor. The shared GT campus builds ZPM mainframes from LuV computers; established MI-qualified ZPM components continue supplying the machine parts."]
	quest.6A07A3475120D3A7.quest_subtitle: "Discipline mastery — supporting branch; follow the chapter age proof for the main transition."
	quest.6A07A3475120D3A7.title: "Prova do acelerador de partículas"
	quest.449BECC83295F832.quest_desc: [
		"Construa a unidade, interface e especialistas em provedores de padrões de AE extendidos após a base AE2 fábrica Está provado."
		"Cada bloco resolve um problema de capacidade ou interface; nenhum substitui AE2 canais, processadores ou potência de rede."
	]
	quest.449BECC83295F832.quest_subtitle: "ExtendedAE começa como uma extensão de titânio qualificado de um trabalho AE2 fábrica."
	quest.449BECC83295F832.title: "ExtendedAE — Capacidade de especialista"
	quest.357BB56305199A19.quest_desc: [
		"Utilizar dispositivos de armazenamento e limiar precisos, quando normal AE2 O emissor de barramento ou de nível não pode expressar o limite exigido."
		"Documente o item, quantidade, destino e comportamento seguro quando o armazenamento estiver cheio."
	]
	quest.357BB56305199A19.quest_subtitle: "A logística de precisão é uma exceção explícita para uma medida fábrica Problema."
	quest.357BB56305199A19.title: "AE alargada — Limites precisos"
