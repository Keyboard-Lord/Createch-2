	quest.5A2A4E409C2F6F47.quest_desc: [
		"Estoque 32 lingotes de bronze CBC de grau de máquina."
		"Mantenha a relação de entrada de três cobres para uma tina e mantenha combustível suficiente para repetir os moldes aquecidos."
	]
	quest.5A2A4E409C2F6F47.quest_subtitle: "Trinta e dois lingotes de bronze CBC fazem da transição de vapor uma ordem de produção, não uma nave troféu."
