	quest.3423607BB6D25891.quest_desc: [
		"Local e inspecionar a Rede elétrica suporte de fusível num ramo real."
		"Escolha a proteção para o condutor e a carga e isole o circuito antes do serviço. Um fusível limita as consequências; não dimensiona corretamente um ramal sobrecarregado."
	]
	quest.3423607BB6D25891.quest_subtitle: "Porta-fusíveis Electro Energetics, fusíveis EE e aterramento dão à falha um ponto fraco deliberado antes do isolamento ou da máquina."
