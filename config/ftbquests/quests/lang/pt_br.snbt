	quest.341CB893F9CBC439.quest_desc: [
		"Após Nível 9 abre, produzir oito mil milibuckets de MI ácido sulfúrico."
		"Use armazenamento compatível, limpá-lo e um plano de saída antes de iniciar a linha de ácido."
	]
	quest.341CB893F9CBC439.quest_subtitle: "Na Chemical e Arcane, oito baldes de ácido sulfúrico fazem do catalisador um fluxo de produção contido."
