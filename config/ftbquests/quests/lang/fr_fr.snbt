	quest.203AD838B55F2DBE.quest_desc: [
		"Construisez les huit familles fonctionnelles HV et vérifiez que chaque recette consomme son composant MV correspondant ; cela prépare l’usine numérique et inoxydable."
	]
	quest.203AD838B55F2DBE.quest_subtitle: "Les huit vraies familles fonctionnelles haute tension forment une norme exacte."
	quest.203AD838B55F2DBE.title: "Norme relative aux composants HV"
	quest.3E3266AF76DD3ED6.quest_desc: [
		"Mettez en réserve le lot HV indiqué pour l’usine numérique et inoxydable ; gardez-le hors consommation automatique afin que l’expansion n’épuise pas les pièces de réparation."
	]
	quest.3E3266AF76DD3ED6.quest_subtitle: "Un lot de réserve transforme un standard en fiable usine capacité."
	quest.3E3266AF76DD3ED6.title: "Cellule de production de HV"
	quest.783D1AE7F056B8EE.quest_desc: [
		"Construisez le consommateur à haute tension auteur et documentez les familles de composants qu'il consomme."
	]
	quest.783D1AE7F056B8EE.quest_subtitle: "La norme HV gagne sa place en exploitant un système intégré réel."
	quest.783D1AE7F056B8EE.title: "Preuve de consommation de VH"
	quest.28FE788DFAA32EF0.quest_desc: [
