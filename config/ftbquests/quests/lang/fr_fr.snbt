	quest.6440091BAEB4298E.quest_desc: [
		"Construisez les huit familles fonctionnelles UHV et vérifiez que chaque recette consomme son composant UV correspondant ; cela prépare les systèmes de champ à ultra-haute énergie."
	]
	quest.6440091BAEB4298E.quest_subtitle: "Les huit vraies familles fonctionnelles Ultra Haute Tension forment un standard exact."
	quest.6440091BAEB4298E.title: "Norme sur les composants de l'UHV"
	quest.5D5DA5F5BCE83015.quest_desc: [
		"Mettez en réserve le lot UHV indiqué pour les systèmes de champ à ultra-haute énergie ; gardez-le hors consommation automatique afin que l’expansion n’épuise pas les pièces de réparation."
	]
	quest.5D5DA5F5BCE83015.quest_subtitle: "Un lot de réserve transforme un standard en fiable usine capacité."
	quest.5D5DA5F5BCE83015.title: "Cellule de production de l'UHV"
	quest.697FAEB2168AB975.quest_desc: [
		"Construisez le consommateur Ultra High Voltage et documentez les familles de composants qu'il consomme."
	]
	quest.697FAEB2168AB975.quest_subtitle: "La norme UHV gagne sa place en exploitant un système intégré réel."
	quest.697FAEB2168AB975.title: "Preuve de consommation de l'UHV"
	quest.2D1FB3254DECE568.quest_desc: [
		"Conservez des moteurs, pompes, bras robotisés, capteurs, émetteurs et générateurs de champ UHV de rechange pour les systèmes de champ à ultra-haute énergie, puis vérifiez que la ligne UV fonctionne encore."
	]
	quest.2D1FB3254DECE568.quest_subtitle: "La ligne peut remplacer les pièces consommées après une panne sans démonter son seul consommateur."
	quest.2D1FB3254DECE568.title: "UHV Récupération Preuve"
