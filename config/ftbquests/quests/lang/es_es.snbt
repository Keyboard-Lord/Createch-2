	quest.74A38055C1A9013C.quest_desc: [
		"Producción y transferencia de 16.000 mB de combustible Stellaris."
		"Convertir un combustible TFMG en vivo a través de Crear mezcla y mantener el almacenamiento del intestino aislar d de los consumidores de fluidos ordinarios."
	]
	quest.74A38055C1A9013C.quest_subtitle: "El intestino tiene suficiente combustible convertido para cargar un cohete sin deshacer su reserva de retorno."
	quest.74A38055C1A9013C.title: "Lanzamiento de combustible Bowser"
	quest.74A82D693AB26B9D.quest_desc: [
		"Reserva dieciséis Crear chutes y treinta y dos placas de bronce al lado del piso de procesamiento."
		"Mantenga las herramientas de limpieza y las notas de ruta con el kit. Aisla una rama de chute bloqueada, corrige la causa de almacenamiento, y sólo entonces reiniciar."
	]
	quest.74A82D693AB26B9D.quest_subtitle: "Crear mantiene el primero fábrica reparar capaz de con la gravedad local visible."
	quest.74A82D693AB26B9D.title: "Crear Kit de Reparación Logística"
	quest.74C303EF74DB3A84.quest_desc: [
		"Construya un tanque de oxígeno grande Stellaris y mantenga 16.000 mB de combustible estelar."
		"Completa esta rama después de la reserva principal de combustible y etiqueta que volumen está disponible para el segundo turno."
	]
	quest.74C303EF74DB3A84.quest_subtitle: "Un tanque de oxígeno grande y dieciséis cubos de combustible permiten que un segundo equipo herede la capacidad en lugar de los calibres vacíos."
	quest.74C303EF74DB3A84.title: "Abrir el segundo turno de lanzamiento"
	quest.74CEEA5EED3C8A97.quest_desc: [
		"Reserva cuatro conjuntos de combustible de fisión y inspeccionar la lavadora química."
		"Mantenga el combustible, la lotería, los ácidos y la salida limpiada en la contención etiquetada por separado."
	]
	quest.74CEEA5EED3C8A97.quest_subtitle: "Cuatro asambleas descargadas y una lavadora de operaciones preparan el trabajo de combustible sin almacenar peligro dentro del reactor."
	quest.74CEEA5EED3C8A97.title: "Manejo de combustible de tres niveles"
	quest.74D72636703F7DCB.quest_desc: [
		"Regrese con dieciséis fragmentos de cristal azul Starlight."
		"Bioma y fuente de etiqueta, luego mantenga las muestras fuera de la automatización de gemas genéricas."
	]
	quest.74D72636703F7DCB.quest_subtitle: "Dieciséis fragmentos de cristal azul hacen útil la estantería de la muestra Starlight sin borrar la necesidad de más expediciones."
