	quest.42CF86E177E62652.quest_desc: [
		"Construye ocho en blanco AE2 patrones para la bóveda de recuperación fuera de línea."
		"Codifique primero las recetas de recuperación crítica y mantenga una lista escrita fuera de la red."
	]
