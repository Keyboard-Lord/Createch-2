	quest.59407412C8F87592.quest_desc: [
		"Inspeccione el bloque estrella colocado después de seguir el frío-reiniciar procedimiento."
		"Verifique la contención, registros, almacenamiento de potencia y salida antes de reanudar cualquier proceso de semillas."
	]
