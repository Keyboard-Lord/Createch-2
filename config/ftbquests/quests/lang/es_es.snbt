	quest.58D79D41B9F95039.quest_desc: [
		"Inspeccione los ladrillos coque-oven y retenga un tanque de fluido de acero TFMG."
		"Planifique trabajo caliente, ingesta de crudo, tanques de productos, respuesta de destellos o cierres, y acceso al mantenimiento."
	]
	quest.58D79D41B9F95039.quest_subtitle: "Una referencia de coque-oven y tanque de acero definen la separación de calor, el almacenamiento de líquidos y las vías de servicio entre ellos."
	quest.58D79D41B9F95039.title: "Afloja el aceite funciona"
	quest.5901D481B2DAFB49.quest_desc: [
		"Construir la lavadora química y retener ocho hojas HDPE después de operar las líneas centrales."
		"La recompensa de la piedra caliza es controlada; acero inoxidable, AE2, y más tarde la química todavía requieren su propia producción."
	]
	quest.5901D481B2DAFB49.quest_subtitle: "Una lavadora de trabajo y polímeros de stock muestran la química de presión puede limpiar, transformar y contener sus productos."
