	quest.17BA3A7302ABD355.quest_desc: [
		"Mantenga una caja de acero y cuatro placas grandes de acero como un conjunto de reconstrucción fría."
		"Aislamiento de vapor, drenaje conectado y inspeccionar la causa antes de instalar el reemplazo."
	]
	quest.17BA3A7302ABD355.quest_subtitle: "Un casquillo y cuatro placas grandes demuestran que el pasillo de acero puede reconstruir su límite de presión."
