	quest.31CFBADC9B1297D7.quest_desc: [
		"Después Nivel 14 abre, lugar y inspeccionar un bloque estrella de la luz estelar eterna."
		"Mantenga una muestra de referencia, almacenamiento de cuarentena, registros de expedición y una ruta controlada hacia la investigación industrial."
	]
	quest.31CFBADC9B1297D7.quest_subtitle: "Existe un instituto astral para preservar muestras, contextos y contención alienígenas en lugar de reducir el descubrimiento a ingredientes."
	quest.31CFBADC9B1297D7.title: "Astral Research Institute"
	quest.31F406ADABBB7F0F.quest_desc: [
		"Reserva dieciséis pernos de bronce usando un instalado MI forge-hammer, corte o ruta de elaboración."
		"Mantenerlos junto a las cañerías y tuberías; los sujetadores son stock de mantenimiento, no una razón para detener la producción."
	]
	quest.31F406ADABBB7F0F.quest_subtitle: "Dieciséis tornillos mantienen el vapor ordinario reparar Es de esperar un nuevo trabajo de formación."
