	quest.743B77F90D03EDF7.quest_desc: [
		"Acumular cuatro pilas de neutrones Re:Avaritia."
		"Mantenga el coleccionista continuamente suministrado y registre el tiempo necesario para reemplazar el lote."
	]
	quest.743B77F90D03EDF7.quest_subtitle: "Cuatro pilas de neutrones hacen visible el tiempo de colector sin pretender que la primera salida es una línea de producción."
	quest.743B77F90D03EDF7.title: "Recoger los primeros neutron Piles"
	quest.7489D8F7F34227D4.quest_desc: [
		"Producir y transferir ocho mil millibuckets de TFMG naphtha."
		"Mantener cada producto de destilación en el almacenamiento etiquetado y verificar No hay salida completa que bloquee toda la torre."
	]
	quest.7489D8F7F34227D4.quest_subtitle: "Ocho cubos de naphtha prueban que la refinería TFMG está separando crudo en lugar de almacenar un controlador de torre."
